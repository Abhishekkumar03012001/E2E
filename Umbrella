Sub CreateResults2()
    Dim wbk As Workbook, wsSrc As Worksheet, ws As Worksheet, wsReadMe As Worksheet
    Set wbk = ThisWorkbook
    Set wsSrc = wbk.Sheets("Results")
    Set wsReadMe = wbk.Sheets("Read Me")

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    On Error Resume Next
    wbk.Sheets("Results2").Delete
    On Error GoTo 0
    Application.DisplayAlerts = True

    ' Copy "Results" and place it right after "Read Me"
    wsSrc.Copy After:=wsReadMe
    Set ws = wbk.Sheets(wsReadMe.Index + 1)
    ws.Name = "Results2"

    ' ---- Safely convert formulas to static values (merge-safe, keeps hyperlinks) ----
    ConvertFormulasToValuesSafe ws

    ' ---- Remove target cells (row-by-row, shifting left within that row only) ----
    RemoveCellsInRow ws, 4, Array("F", "E", "N", "M")
    RemoveCellsInRow ws, 5, Array("F", "E", "N", "M")
    RemoveCellsInRow ws, 10, Array("I", "G")
    RemoveCellsInRow ws, 11, Array("I", "G")

    ' ---- Resize header merges to match new widths ----
    ResizeMerge ws, 3, "B", "H"    ' ROC QC title row (adjust if needed)
    ResizeMerge ws, 3, "J", "N"    ' FD QC title row (adjust if needed)

    ' Explicit fix: F8:J8 and F9:J9 -> F:H
    ResizeMergeExact ws, 8, "F", "J", "F", "H"
    ResizeMergeExact ws, 9, "F", "J", "F", "H"

    Application.CutCopyMode = False
    Application.ScreenUpdating = True
    MsgBox "Results2 created successfully.", vbInformation
End Sub

' Converts every formula in UsedRange to a static value,
' safely handling merged cells (only writes to the merge anchor)
' and error values (skips them instead of crashing).
Sub ConvertFormulasToValuesSafe(ws As Worksheet)
    Dim ur As Range, cel As Range
    Set ur = ws.UsedRange

    Dim r As Long, c As Long
    For r = 1 To ur.Rows.Count
        For c = 1 To ur.Columns.Count
            Set cel = ur.Cells(r, c)
            On Error Resume Next
            If cel.MergeCells Then
                If cel.MergeArea.Cells(1, 1).Address = cel.Address Then
                    cel.Value = cel.Value
                End If
            Else
                cel.Value = cel.Value
            End If
            On Error GoTo 0
        Next c
    Next r
End Sub

' Removes a list of column letters from one row, shifting that row left.
Sub RemoveCellsInRow(ws As Worksheet, rowNum As Long, colsOrder As Variant)
    Dim v As Variant
    For Each v In colsOrder
        RemoveSingleCell ws, rowNum, CStr(v)
    Next v
End Sub

' Deletes one cell (row-only shift left). Handles merged header cells
' by unmerging, deleting, then re-merging at the reduced width.
Sub RemoveSingleCell(ws As Worksheet, r As Long, colLetter As String)
    Dim col As Long
    col = ws.Range(colLetter & "1").Column

    Dim cel As Range
    Set cel = ws.Cells(r, col)

    If cel.MergeCells Then
        Dim ma As Range, leftCol As Long, rightCol As Long
        Set ma = cel.MergeArea
        leftCol = ma.Cells(1, 1).Column
        rightCol = ma.Cells(1, ma.Columns.Count).Column

        ma.UnMerge
        ws.Cells(r, col).Delete Shift:=xlToLeft

        If rightCol - 1 > leftCol Then
            ws.Range(ws.Cells(r, leftCol), ws.Cells(r, rightCol - 1)).Merge
        End If
    Else
        ws.Cells(r, col).Delete Shift:=xlToLeft
    End If
End Sub

' Auto-detects a merge starting at startCol in a given row and shrinks
' it to only span currently-non-empty / surviving cells up to endCol.
Sub ResizeMerge(ws As Worksheet, rowNum As Long, startCol As String, endCol As String)
    Dim sc As Long, ec As Long
    sc = ws.Range(startCol & "1").Column
    ec = ws.Range(endCol & "1").Column

    Dim cel As Range
    Set cel = ws.Cells(rowNum, sc)

    If cel.MergeCells Then
        Dim ma As Range
        Set ma = cel.MergeArea
        Dim txt As Variant
        txt = ma.Cells(1, 1).Value
        ma.UnMerge

        ' Find last surviving column with content up to ec (basic heuristic)
        Dim lastCol As Long, c As Long
        lastCol = sc
        For c = sc To ec
            If SafeLen(ws.Cells(rowNum + 1, c)) > 0 Or SafeLen(ws.Cells(rowNum + 2, c)) > 0 Then
                lastCol = c
            End If
        Next c

        If lastCol > sc Then
            ws.Range(ws.Cells(rowNum, sc), ws.Cells(rowNum, lastCol)).Merge
            ws.Cells(rowNum, sc).Value = txt
        Else
            ws.Cells(rowNum, sc).Value = txt
        End If
    End If
End Sub

' Explicitly force-resizes a known merge (e.g. F8:J8 -> F8:H8),
' regardless of surrounding content - use when you know the exact target.
Sub ResizeMergeExact(ws As Worksheet, rowNum As Long, oldStart As String, oldEnd As String, _
                      newStart As String, newEnd As String)
    Dim oldSc As Long, oldEc As Long, newSc As Long, newEc As Long
    oldSc = ws.Range(oldStart & "1").Column
    oldEc = ws.Range(oldEnd & "1").Column
    newSc = ws.Range(newStart & "1").Column
    newEc = ws.Range(newEnd & "1").Column

    Dim cel As Range
    Set cel = ws.Cells(rowNum, oldSc)

    Dim txt As Variant
    txt = ""

    If cel.MergeCells Then
        txt = cel.MergeArea.Cells(1, 1).Value
        cel.MergeArea.UnMerge
    Else
        txt = cel.Value
    End If

    On Error Resume Next
    ws.Range(ws.Cells(rowNum, newSc), ws.Cells(rowNum, newEc)).Merge
    On Error GoTo 0

    ws.Cells(rowNum, newSc).Value = txt
End Sub

' Returns the length of a cell's displayed value.
' Returns 0 for error values (#REF!, #VALUE!, etc.) instead of crashing.
Function SafeLen(cel As Range) As Long
    If IsError(cel.Value) Then
        SafeLen = 0
    Else
        SafeLen = Len(CStr(cel.Value))
    End If
End Function
