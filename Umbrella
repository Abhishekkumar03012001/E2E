Sub CreateResults2()
    Dim wbk As Workbook, wsSrc As Worksheet, ws As Worksheet, wsReadMe As Worksheet
    Set wbk = ThisWorkbook
    Set wsSrc = wbk.Sheets("Results")
    Set wsReadMe = wbk.Sheets("Read Me")

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    On Error Resume Next
    wbk.Sheets("Results2").Delete
    On Error GoTo 0
    Application.DisplayAlerts = True

    ' Copy "Results" and place it right after "Read Me"
    wsSrc.Copy After:=wsReadMe
    Set ws = wbk.Sheets(wsReadMe.Index + 1)
    ws.Name = "Results2"

    ' ---- Convert formulas to static values (keeps hyperlinks intact) ----
    Dim rng As Range
    Set rng = ws.UsedRange
    rng.Value = rng.Value

    ' ---- Remove target cells & auto-shrink related header merges ----
    ' Row 3 = title row for ROC QC / FD QC sections
    RemoveCellsInRow ws, 3, Array("F", "E", "N", "M")
    RemoveCellsInRow ws, 4, Array("F", "E", "N", "M")
    RemoveCellsInRow ws, 5, Array("F", "E", "N", "M")

    ' Row 14 = title row for the Row QC / Column QC sub-sections
    RemoveCellsInRow ws, 14, Array("I", "G")
    RemoveCellsInRow ws, 10, Array("I", "G")
    RemoveCellsInRow ws, 11, Array("I", "G")

    Application.CutCopyMode = False
    Application.ScreenUpdating = True
    MsgBox "Results2 created successfully.", vbInformation
End Sub

' Removes a list of column letters from one row, always processing
' right-to-left so column positions stay valid mid-loop.
Sub RemoveCellsInRow(ws As Worksheet, rowNum As Long, colsDescOrder As Variant)
    Dim v As Variant
    For Each v In colsDescOrder
        RemoveSingleCell ws, rowNum, CStr(v)
    Next v
End Sub

' Deletes one cell (shifting the rest of that row left).
' If the cell is part of a merged header, the merge is unmerged,
' the cell deleted, then re-merged at the new (shorter) width.
Sub RemoveSingleCell(ws As Worksheet, r As Long, colLetter As String)
    Dim col As Long
    col = ws.Range(colLetter & "1").Column

    Dim cel As Range
    Set cel = ws.Cells(r, col)

    If cel.MergeCells Then
        Dim ma As Range, leftCol As Long, rightCol As Long
        Set ma = cel.MergeArea
        leftCol = ma.Cells(1, 1).Column
        rightCol = ma.Cells(1, ma.Columns.Count).Column

        ma.UnMerge
        ws.Cells(r, col).Delete Shift:=xlToLeft

        If rightCol - 1 > leftCol Then
            ws.Range(ws.Cells(r, leftCol), ws.Cells(r, rightCol - 1)).Merge
        End If
    Else
        ws.Cells(r, col).Delete Shift:=xlToLeft
    End If
End Sub
