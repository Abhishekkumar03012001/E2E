Sub MergeAndFormatResultsSheet()

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets("Results")
    
    Dim hyperlinkSheet As String
    hyperlinkSheet = "TabQC_Row"
    
    Application.DisplayAlerts = False  ' Suppress "merge will keep only upper-left value" warning
    
    '--- Step 1: Merge G11:H11, keeping H11's text and color ---
    With ws
        .Range("H11").Copy
        .Range("G11").PasteSpecial Paste:=xlPasteAll   ' copies value + formatting from H11 into G11
        Application.CutCopyMode = False
        .Range("H11").ClearContents
        .Range("G11:H11").Merge
    End With
    
    '--- Step 2: Merge I11:J11, keeping J11's text and color ---
    With ws
        .Range("J11").Copy
        .Range("I11").PasteSpecial Paste:=xlPasteAll   ' copies value + formatting from J11 into I11
        Application.CutCopyMode = False
        .Range("J11").ClearContents
        .Range("I11:J11").Merge
    End With
    
    '--- Step 3: Merge G10:H10, clear old content, add hyperlink "Prop to FR" ---
    With ws
        .Range("G10:H10").ClearContents
        .Range("G10:H10").Merge
        .Hyperlinks.Add Anchor:=.Range("G10"), Address:="", _
            SubAddress:="'" & hyperlinkSheet & "'!A1", _
            TextToDisplay:="Prop to FR"
    End With
    
    '--- Step 4: Merge I10:J10, clear old content, add hyperlink "Prop to FR" ---
    With ws
        .Range("I10:J10").ClearContents
        .Range("I10:J10").Merge
        .Hyperlinks.Add Anchor:=.Range("I10"), Address:="", _
            SubAddress:="'" & hyperlinkSheet & "'!A1", _
            TextToDisplay:="Prop to FR"
    End With
    
    Application.DisplayAlerts = True
    
    MsgBox "Merging and hyperlinks completed on 'Results' sheet.", vbInformation

End Sub
