Sub DeleteSpecificSheets()

    Dim ws As Worksheet
    Dim i As Long
    Dim regex As Object
    Dim deletedList As String
    
    ' Create regex object: 1 or 2 letters followed by 2 or 3 digits
    Set regex = CreateObject("VBScript.RegExp")
    regex.IgnoreCase = True
    regex.Pattern = "^[A-Za-z]{1,2}[0-9]{2,3}$"
    
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False  ' Suppress "Delete sheet" confirmation prompts
    
    ' Loop backwards since we are deleting sheets
    For i = ThisWorkbook.Worksheets.Count To 1 Step -1
        Set ws = ThisWorkbook.Worksheets(i)
        
        If ws.Name = "Summary_RD" Then
            deletedList = deletedList & ws.Name & vbNewLine
            ws.Delete
        ElseIf regex.Test(ws.Name) Then
            deletedList = deletedList & ws.Name & vbNewLine
            ws.Delete
        End If
    Next i
    
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    
    If deletedList = "" Then
        MsgBox "No matching sheets were found.", vbInformation
    Else
        MsgBox "Deleted the following sheets:" & vbNewLine & vbNewLine & deletedList, vbInformation
    End If

End Sub
