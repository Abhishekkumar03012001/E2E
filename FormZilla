"""
FormZilla -> Springfield checker
================================
For EVERY Line of Business (Brand = Liberty Agency, State = IL):
  1. Click "Get Results"
  2. On the current results page: open/download EVERY pdf, search it for
     "Springfield" and note the page number(s)
  3. THEN click Next page and repeat, until the last page
  4. Write one Excel sheet per Line of Business (+ a Summary sheet)

Each Line-of-Business sheet has:
  Form Number | Springfield Found | Page Number | PDF URL | Results Page | Remarks
  (Page Number and PDF URL are "NA" when Springfield is not found)

Install:
    pip install selenium requests pymupdf pandas openpyxl
Run:
    python formzilla_springfield.py
"""

import os
import re
import time
import hashlib
import requests
import fitz  # PyMuPDF
import pandas as pd
from datetime import datetime
from urllib.parse import urljoin
from selenium import webdriver
from selenium.webdriver.edge.options import Options
from selenium.webdriver.common.by import By

# ----------------------------- CONFIG ---------------------------------------
SITE_URL = "https://doczilla.libertyec.com"   # <- put your exact link here
BRAND = "Liberty Agency"
STATE = "IL"
SEARCH_TEXT = "Springfield"
OUTPUT_XLSX = "springfield_forms.xlsx"
PDF_FOLDER = "downloaded_pdfs"
WAIT = 20                 # seconds to wait for a page element
RESULTS_WAIT = 40         # seconds to wait for results table after Get Results
LOB_ATTEMPTS = 2          # retry a Line of Business this many times if it fails

# Reuse your normal Edge profile (keeps your automatic login).
# If you enable this, CLOSE ALL Edge windows before running.
USE_MY_EDGE_PROFILE = False
EDGE_USER_DATA_DIR = r"C:\Users\YOUR_NAME\AppData\Local\Microsoft\Edge\User Data"
EDGE_PROFILE = "Default"

LINES_OF_BUSINESS = [
    "Condo", "Dwelling fire", "Earthquake", "Homeowners", "Motorcycle",
    "Personal auto", "Personal umbrella", "Recreational vehicle",
    "Renters", "Watercraft",
]

# Results table: column 1 = Icon (pdf link), column 2 = Form Number
ICON_COL = 0
FORM_NUMBER_COL = 1

# XPaths - adjust if needed (F12 > right-click element > Copy > Copy XPath)
X_FORMZILLA_TAB = "//*[self::a or self::button or self::li or self::div or self::span][normalize-space(text())='FormZilla']"
X_GET_RESULTS = ("//*[self::button or self::input or self::a]"
                 "[contains(normalize-space(.),'Get Results') or @value='Get Results']")
X_RESULT_ROWS = "//table//tr[td]"

X_NEXT_CANDIDATES = [
    "//a[contains(@class,'next')]",
    "//li[contains(@class,'next')]/a",
    "//button[contains(@class,'next')]",
    "//*[@aria-label='Next' or @title='Next' or @aria-label='Next page']",
    "//a[normalize-space(.)='Next' or normalize-space(.)='Next >' or normalize-space(.)='>' or normalize-space(.)='›' or normalize-space(.)='»']",
    "//button[normalize-space(.)='Next' or normalize-space(.)='>' or normalize-space(.)='›']",
]
X_CURRENT_PAGE_NUM = ("//li[contains(@class,'active')]/a | //li[contains(@class,'active')]/span | "
                      "//a[contains(@class,'current')] | //span[contains(@class,'current')]")
# ---------------------------------------------------------------------------

UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
LOWER = "abcdefghijklmnopqrstuvwxyz"


def log(msg=""):
    print(f"[{datetime.now():%H:%M:%S}] {msg}", flush=True)


# ------------------------- Selenium helpers ---------------------------------
def is_shown(el):
    try:
        return el.is_displayed()
    except Exception:
        return False


def visible(driver, xpath):
    return [e for e in driver.find_elements(By.XPATH, xpath) if is_shown(e)]


def wait_visible(driver, xpath, timeout=WAIT):
    end = time.time() + timeout
    while time.time() < end:
        v = visible(driver, xpath)
        if v:
            return v[0]
        time.sleep(0.4)
    raise TimeoutError(f"Element not found/visible: {xpath}")


def click(driver, el):
    try:
        driver.execute_script("arguments[0].scrollIntoView({block:'center'});", el)
    except Exception:
        pass
    try:
        el.click()
    except Exception:
        driver.execute_script("arguments[0].click();", el)


def click_xpath(driver, xpath, timeout=WAIT):
    el = wait_visible(driver, xpath, timeout)
    click(driver, el)
    return el


def find_select_button(driver, label, timeout=WAIT):
    """The VISIBLE 'Select' button that follows the VISIBLE label (ignores hidden tabs)."""
    end = time.time() + timeout
    while time.time() < end:
        for lab in visible(driver, f"//*[contains(normalize-space(text()),'{label}')]"):
            for b in lab.find_elements(By.XPATH, "following::*[normalize-space(text())='Select']"):
                if is_shown(b):
                    return b
        time.sleep(0.4)
    raise TimeoutError(f"'Select' button for '{label}' not found")


def click_menu_item(driver, text, timeout=WAIT):
    """Click a dropdown item by its text (case-insensitive, visible only)."""
    t = text.lower()
    xp = ("//*[self::a or self::li or self::span or self::div or self::button or self::label or self::option]"
          f"[translate(normalize-space(text()),'{UPPER}','{LOWER}')='{t}']")
    el = wait_visible(driver, xp, timeout)
    click(driver, el)


# ------------------------- Filters ------------------------------------------
def set_state(driver):
    try:
        for lab in visible(driver, "//*[normalize-space(text())='State' or starts-with(normalize-space(text()),'State ')]"):
            for inp in lab.find_elements(By.XPATH, "following::input[1]"):
                if is_shown(inp):
                    cur = (inp.get_attribute("value") or "").strip().upper()
                    if cur == STATE.upper():
                        log(f"  State already = {STATE}")
                        return
                    inp.clear()
                    inp.send_keys(STATE)
                    log(f"  Entered State = {STATE}")
                    return
        log("  (State field not found - it may already be pre-filled)")
    except Exception as e:
        log(f"  (State step skipped: {e})")


def apply_filters(driver, lob):
    log("  Opening site...")
    driver.get(SITE_URL)
    log("  Clicking FormZilla tab")
    click_xpath(driver, X_FORMZILLA_TAB)
    time.sleep(1.5)

    log(f"  Selecting Brand = {BRAND}")
    click(driver, find_select_button(driver, "Brand"))
    click_menu_item(driver, BRAND)
    time.sleep(1.5)

    log(f"  Selecting Line of Business = {lob}")
    click(driver, find_select_button(driver, "Line of Business"))
    time.sleep(0.5)
    click_menu_item(driver, lob)
    time.sleep(1)

    set_state(driver)
    time.sleep(0.5)

    log("  Clicking Get Results...")
    click_xpath(driver, X_GET_RESULTS)


# ------------------------- Reading a results page ---------------------------
def valid_rows(driver):
    """Visible table rows that have a non-empty Form Number cell."""
    out = []
    for r in driver.find_elements(By.XPATH, X_RESULT_ROWS):
        try:
            if not r.is_displayed():
                continue
            tds = r.find_elements(By.TAG_NAME, "td")
            if len(tds) > max(ICON_COL, FORM_NUMBER_COL) and tds[FORM_NUMBER_COL].text.strip():
                out.append(r)
        except Exception:
            continue
    return out


def wait_for_results(driver, timeout=RESULTS_WAIT):
    """Wait until the results table has rows and the row count is stable."""
    end, last, stable = time.time() + timeout, -1, 0
    while time.time() < end:
        n = len(valid_rows(driver))
        if n > 0 and n == last:
            stable += 1
            if stable >= 2:
                return n
        else:
            stable = 0
        last = n
        time.sleep(1)
    return max(last, 0)


def page_signature(driver):
    nums = []
    for r in valid_rows(driver):
        try:
            nums.append(r.find_elements(By.TAG_NAME, "td")[FORM_NUMBER_COL].text.strip())
        except Exception:
            pass
    return hashlib.md5("|".join(nums).encode()).hexdigest() + f"#{len(nums)}"


def get_pdf_url(driver, row, icon_cell):
    """href -> onclick -> click-and-capture."""
    base = driver.current_url
    anchors = icon_cell.find_elements(By.TAG_NAME, "a") or row.find_elements(By.TAG_NAME, "a")

    for a in anchors:
        href = (a.get_attribute("href") or "").strip()
        if href and not href.lower().startswith(("javascript", "#")):
            return urljoin(base, href)

    for el in anchors + icon_cell.find_elements(By.XPATH, ".//*[@onclick]"):
        oc = el.get_attribute("onclick") or ""
        m = re.search(r"""['"]([^'"]+\.pdf[^'"]*|[^'"]*(?:download|view|pdf)[^'"]*)['"]""", oc, re.I)
        if m:
            return urljoin(base, m.group(1))

    # Last resort: click the icon and capture the new tab / page url
    target = anchors[0] if anchors else icon_cell
    main_handle = driver.current_window_handle
    old_handles, old_url = driver.window_handles, driver.current_url
    try:
        driver.execute_script("arguments[0].click();", target)
        time.sleep(2)
        new = [h for h in driver.window_handles if h not in old_handles]
        if new:
            driver.switch_to.window(new[0])
            url = driver.current_url
            driver.close()
            driver.switch_to.window(main_handle)
            return url
        if driver.current_url != old_url:
            url = driver.current_url
            driver.back()
            time.sleep(2)
            return url
    except Exception:
        try:
            driver.switch_to.window(main_handle)
        except Exception:
            pass
    return None


def read_current_page(driver):
    """Return [{form_number, pdf_url}] for every row on the current page."""
    out = []
    n = len(valid_rows(driver))
    for i in range(n):
        try:
            rows = valid_rows(driver)
            row = rows[i]
            cells = row.find_elements(By.TAG_NAME, "td")
            fn = cells[FORM_NUMBER_COL].text.strip()
            url = get_pdf_url(driver, row, cells[ICON_COL])
            out.append({"form_number": fn, "pdf_url": url})
        except Exception as e:
            log(f"    (row {i + 1} could not be read: {e})")
            out.append({"form_number": f"(unreadable row {i + 1})", "pdf_url": None})
    return out


# ------------------------- Pagination ---------------------------------------
def find_next_button(driver):
    for xp in X_NEXT_CANDIDATES:
        for el in visible(driver, xp):
            try:
                cls = (el.get_attribute("class") or "").lower()
                pcls = (el.find_element(By.XPATH, "..").get_attribute("class") or "").lower()
                if ("disabled" in cls or "disabled" in pcls or el.get_attribute("disabled")
                        or el.get_attribute("aria-disabled") == "true"):
                    continue
                return el
            except Exception:
                continue
    return None


def wait_page_changed(driver, before, timeout=12):
    end = time.time() + timeout
    while time.time() < end:
        time.sleep(0.5)
        try:
            if page_signature(driver) != before:
                time.sleep(1)
                return True
        except Exception:
            pass
    return False


def go_next_page(driver):
    """Click Next (or the next page number). True only if the rows really changed."""
    before = page_signature(driver)

    btn = find_next_button(driver)
    if btn:
        click(driver, btn)
        if wait_page_changed(driver, before):
            return True

    # Fallback: numbered pagination (click current page number + 1)
    for el in visible(driver, X_CURRENT_PAGE_NUM):
        txt = el.text.strip()
        if txt.isdigit():
            nxt = visible(driver, f"//a[normalize-space(.)='{int(txt) + 1}']")
            if nxt:
                click(driver, nxt[0])
                if wait_page_changed(driver, before):
                    return True
            break
    return False


# ------------------------- PDF check ----------------------------------------
def get_requests_session(driver):
    s = requests.Session()
    for c in driver.get_cookies():
        s.cookies.set(c["name"], c["value"], domain=c.get("domain"))
    s.headers["User-Agent"] = driver.execute_script("return navigator.userAgent;")
    return s


def download_pdf(session, url, form_number):
    safe = re.sub(r"[^\w\-]+", "_", form_number)[:80]
    h = hashlib.md5(url.encode()).hexdigest()[:8]
    path = os.path.join(PDF_FOLDER, f"{safe}_{h}.pdf")
    if os.path.exists(path):
        log("      Using saved PDF copy")
        return path
    log("      Downloading PDF...")
    last_err = None
    for attempt in range(3):
        try:
            resp = session.get(url, timeout=90)
            resp.raise_for_status()
            if b"%PDF" not in resp.content[:1024]:
                raise ValueError("Downloaded file is not a PDF (login page / wrong link?)")
            with open(path, "wb") as f:
                f.write(resp.content)
            return path
        except Exception as e:
            last_err = e
            time.sleep(2)
    raise last_err


def scan_pdf(path):
    """Open the PDF and return (found, [page numbers], remark)."""
    pages, total_text = [], 0
    with fitz.open(path) as doc:
        total = len(doc)
        log(f"      Opened PDF - searching {total} page(s) for '{SEARCH_TEXT}'...")
        for i, page in enumerate(doc, start=1):
            text = page.get_text()
            total_text += len(text.strip())
            norm = re.sub(r"\s+", " ", text.replace("\u00ad", "")).lower()
            if SEARCH_TEXT.lower() in norm or page.search_for(SEARCH_TEXT):
                pages.append(i)
    remark = ""
    if not pages and total_text == 0:
        remark = "PDF has no text layer (scanned image) - needs OCR"
    return bool(pages), pages, remark


# ------------------------- Excel --------------------------------------------
COLS = ["Form Number", "Springfield Found", "Page Number", "PDF URL", "Results Page", "Remarks"]
SUMMARY_COLS = ["Line of Business", "Sheet Name", "Results Pages Read", "Forms Found",
                "Springfield Yes", "Springfield No", "Errors", "Status"]


def sheet_name(lob, used):
    name = re.sub(r"[\\/*?:\[\]]", "_", lob)[:31] or "Sheet"
    base, n = name, 2
    while name.lower() in used:
        name = f"{base[:28]}_{n}"
        n += 1
    used.add(name.lower())
    return name


def save_excel(results, summary):
    from openpyxl.styles import Font
    used = {"summary"}
    with pd.ExcelWriter(OUTPUT_XLSX, engine="openpyxl") as xw:
        sdf = pd.DataFrame(summary, columns=SUMMARY_COLS)
        sdf.to_excel(xw, sheet_name="Summary", index=False)
        ws = xw.sheets["Summary"]
        for col, w in zip("ABCDEFGH", [24, 24, 20, 14, 16, 16, 10, 40]):
            ws.column_dimensions[col].width = w
        for c in ws[1]:
            c.font = Font(bold=True)

        for lob, recs in results.items():
            nm = sheet_name(lob, used)
            df = pd.DataFrame(recs, columns=COLS)
            if df.empty:
                df = pd.DataFrame([{"Form Number": "(no forms returned)"}], columns=COLS)
            df.to_excel(xw, sheet_name=nm, index=False)
            ws = xw.sheets[nm]
            for col, w in zip("ABCDEF", [28, 18, 14, 70, 14, 45]):
                ws.column_dimensions[col].width = w
            ws.freeze_panes = "A2"
            for c in ws[1]:
                c.font = Font(bold=True)


# ------------------------- Per-LOB processing -------------------------------
def process_lob(driver, lob, results_for_lob, cache):
    """Returns (pages_read, status)."""
    apply_filters(driver, lob)
    n = wait_for_results(driver)
    if n == 0:
        return 0, "No forms returned (table empty or not found)"
    log(f"  Results loaded ({n} rows on first page)")

    page_no, seen_sigs = 1, set()
    while True:
        sig = page_signature(driver)
        if sig in seen_sigs:
            log("  Same page seen again - stopping pagination")
            break
        seen_sigs.add(sig)

        # 1) read all rows of THIS page
        rows = read_current_page(driver)
        log(f"  --- Results page {page_no}: {len(rows)} forms ---")
        session = get_requests_session(driver)

        # 2) check every PDF of this page
        for ri, row in enumerate(rows, start=1):
            fn, url = row["form_number"], row["pdf_url"]
            log(f"  [page {page_no} | {ri}/{len(rows)}] Form {fn}")
            rec = {"Form Number": fn, "Springfield Found": "No", "Page Number": "NA",
                   "PDF URL": "NA", "Results Page": page_no, "Remarks": ""}
            if not url:
                rec["Springfield Found"] = "Error"
                rec["Remarks"] = "PDF link not found in row"
                log("      !! No PDF link found for this row")
            else:
                try:
                    if url not in cache:
                        path = download_pdf(session, url, fn)
                        cache[url] = scan_pdf(path)
                    else:
                        log("      Already scanned earlier - reusing result")
                    found, pages, remark = cache[url]
                    rec["Remarks"] = remark
                    if found:
                        rec["Springfield Found"] = "Yes"
                        rec["Page Number"] = ", ".join(map(str, pages))
                        rec["PDF URL"] = url
                        log(f"      >>> '{SEARCH_TEXT}' FOUND on page(s) {pages}")
                    else:
                        log(f"      '{SEARCH_TEXT}' not found")
                except Exception as e:
                    rec["Springfield Found"] = "Error"
                    rec["Remarks"] = str(e)[:200]
                    log(f"      !! ERROR: {e}")
            results_for_lob.append(rec)

        # 3) only now go to the next page
        log(f"  Finished page {page_no}. Looking for Next page...")
        if not go_next_page(driver):
            log("  No more pages")
            break
        page_no += 1
    return page_no, "OK"


# ------------------------- Main ---------------------------------------------
def main():
    log("Script started")
    os.makedirs(PDF_FOLDER, exist_ok=True)

    opts = Options()
    opts.add_argument("--start-maximized")
    if USE_MY_EDGE_PROFILE:
        opts.add_argument(f"--user-data-dir={EDGE_USER_DATA_DIR}")
        opts.add_argument(f"--profile-directory={EDGE_PROFILE}")
    log("Opening Edge browser...")
    driver = webdriver.Edge(options=opts)

    results, summary, cache = {}, [], {}
    used_names = set()

    try:
        for li, lob in enumerate(LINES_OF_BUSINESS, start=1):
            log("=" * 64)
            log(f"LINE OF BUSINESS {li}/{len(LINES_OF_BUSINESS)}: {lob}")
            log("=" * 64)

            status, pages_read = "FAILED", 0
            for attempt in range(1, LOB_ATTEMPTS + 1):
                results[lob] = []          # start clean on each attempt
                try:
                    pages_read, status = process_lob(driver, lob, results[lob], cache)
                    if status == "OK" or attempt == LOB_ATTEMPTS:
                        break
                    log(f"  {status} - retrying ({attempt}/{LOB_ATTEMPTS})...")
                except Exception as e:
                    status = f"FAILED: {str(e)[:150]}"
                    log(f"  !! {lob} failed on attempt {attempt}: {e}")
                    if attempt < LOB_ATTEMPTS:
                        log("  Retrying...")

            recs = results[lob]
            summary.append({
                "Line of Business": lob,
                "Sheet Name": sheet_name(lob, used_names),
                "Results Pages Read": pages_read,
                "Forms Found": len(recs),
                "Springfield Yes": sum(r["Springfield Found"] == "Yes" for r in recs),
                "Springfield No": sum(r["Springfield Found"] == "No" for r in recs),
                "Errors": sum(r["Springfield Found"] == "Error" for r in recs),
                "Status": status,
            })
            save_excel(results, summary)    # checkpoint after every Line of Business
            s = summary[-1]
            log(f"Finished {lob}: {s['Forms Found']} forms | Yes {s['Springfield Yes']} | "
                f"No {s['Springfield No']} | Errors {s['Errors']} | {status}")
    finally:
        log("Closing browser...")
        driver.quit()

    save_excel(results, summary)
    log("=" * 64)
    log("SUMMARY")
    for s in summary:
        log(f"  {s['Line of Business']:<22} forms={s['Forms Found']:<4} yes={s['Springfield Yes']:<4} "
            f"errors={s['Errors']:<3} {s['Status']}")
    log(f"Output: {os.path.abspath(OUTPUT_XLSX)}")


if __name__ == "__main__":
    main()
