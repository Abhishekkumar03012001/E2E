PDF_FOLDER = os.path.abspath("downloaded_pdfs")
INCOMING = os.path.join(PDF_FOLDER, "_incoming")   # browser downloads land here first
WAIT = 20                 # seconds to wait for a page element
RESULTS_WAIT = 40         # seconds to wait for results table after Get Results
DOWNLOAD_WAIT = 30        # seconds to wait for a PDF to download after clicking its icon
LOB_ATTEMPTS = 2          # retry a Line of Business this many times if it fails

