# =============================================================================
# PART 2 - SEARCH FOR "Springfield"  ->  EXCEL  +  HIGHLIGHTED COPIES
# =============================================================================
# Step 2: searches every page of every PDF in  downloaded_pdfs/<Line of Business>/
#         and writes ONE Excel file with one sheet per Line of Business:
#             Form Number | Springfield Found | Page Number
#         (filters on every header, coloured header row; PDFs that were not
#          downloaded / failed are listed too, in red, + a "Not Downloaded" sheet)
# Step 3: every PDF that contains Springfield is COPIED to
#             Pdfs which have SpringField/<Line of Business>/<FormNumber>.pdf
#         and every "Springfield" in the copy is HIGHLIGHTED (yellow).
#         The originals in downloaded_pdfs are never changed.
#
# Install once:  pip install pymupdf pandas openpyxl
# =============================================================================
import os
import re
import shutil
import pandas as pd
from datetime import datetime

try:
    import pymupdf as fitz          # newer PyMuPDF
except ImportError:
    import fitz                      # older PyMuPDF

# ----------------------------- CONFIG ---------------------------------------
SEARCH_TEXT = "Springfield"
BASE_FOLDER = os.path.abspath("downloaded_pdfs")                 # same folder as Part 1
SPRINGFIELD_FOLDER = os.path.abspath("Pdfs which have SpringField")
OUTPUT_XLSX = "springfield_forms.xlsx"
MANIFEST_NAME = "_manifest.csv"

# Folders (Lines of Business) to search. Use [] to search EVERY folder found.
LINES_OF_BUSINESS = [
    "Homeowners",
]
# ---------------------------------------------------------------------------

COLS = ["Form Number", "Springfield Found", "Page Number"]
MISSING_COLS = ["Line of Business", "Form Number", "Reason"]
NOT_DL = "Not Downloaded"
HIGHLIGHT_COLOR = (1, 1, 0)          # yellow


def log(msg=""):
    print(f"[{datetime.now():%H:%M:%S}] {msg}", flush=True)


def folder_name(lob):
    return re.sub(r'[\\/*?:"<>|]', "_", lob).strip()


def safe_file_name(name):
    return (re.sub(r'[\\/*?:"<>|\r\n\t]+', "_", name).strip(" .") or "form")


# ------------------------- Search -------------------------------------------
def _normalize(text):
    return re.sub(r"\s+", " ", text.replace("\u00ad", "")).lower()


def scan_pdf(path):
    """Search every page. Returns (found, [page numbers], remark)."""
    pages, total_text = [], 0
    with fitz.open(path) as doc:
        if doc.needs_pass:
            return False, [], "PDF is password protected"
        total = len(doc)
        log(f"      Opened PDF - searching {total} page(s) for '{SEARCH_TEXT}'...")
        for i, page in enumerate(doc, start=1):
            text = page.get_text()
            total_text += len(text.strip())
            if SEARCH_TEXT.lower() in _normalize(text) or page.search_for(SEARCH_TEXT):
                pages.append(i)
    remark = ""
    if not pages and total_text == 0:
        remark = "PDF has no text layer (scanned image) - needs OCR"
    return bool(pages), pages, remark


# ------------------------- Highlight ----------------------------------------
def _hit_rects(page):
    """Rectangles of every 'Springfield' on the page (also when split / odd spacing)."""
    rects = list(page.search_for(SEARCH_TEXT))
    if not rects:                                        # fallback: look at the words
        key = SEARCH_TEXT.lower()
        for w in page.get_text("words"):                 # (x0, y0, x1, y1, word, ...)
            if key in w[4].lower():
                rects.append(fitz.Rect(w[:4]))
    return rects


def copy_and_highlight(src_path, dest_path, pages):
    """Copy the PDF to dest_path and highlight every Springfield in the copy."""
    os.makedirs(os.path.dirname(dest_path), exist_ok=True)
    shutil.copy2(src_path, dest_path)
    n = 0
    tmp = dest_path + ".tmp"
    with fitz.open(dest_path) as doc:
        for p in pages:
            page = doc[p - 1]
            for r in _hit_rects(page):
                annot = page.add_highlight_annot(r)
                annot.set_colors(stroke=HIGHLIGHT_COLOR)
                annot.update()
                n += 1
        doc.save(tmp, garbage=3, deflate=True)
    os.replace(tmp, dest_path)
    return n


# ------------------------- Collect PDFs of one folder ------------------------
def load_items(folder):
    """PDFs of one LOB folder, using the manifest from Part 1 if present."""
    items, listed = [], set()
    manifest = os.path.join(folder, MANIFEST_NAME)
    if os.path.exists(manifest):
        df = pd.read_csv(manifest, dtype=str, keep_default_na=False)
        for r in df.to_dict("records"):
            items.append({
                "Form Number": r.get("Form Number", ""),
                "PDF File": r.get("PDF File", ""),
                "Download Status": r.get("Download Status", "Downloaded"),
                "Remarks": r.get("Remarks", ""),
            })
            listed.add(r.get("PDF File", "").lower())
    # PDFs in the folder that are not in the manifest (or no manifest at all)
    for f in sorted(os.listdir(folder)):
        if f.lower().endswith(".pdf") and f.lower() not in listed:
            items.append({"Form Number": os.path.splitext(f)[0], "PDF File": f,
                          "Download Status": "Downloaded", "Remarks": ""})
    return items


def search_lob(lob):
    """Search all PDFs of one LOB. Returns list of result records (or None)."""
    folder = os.path.join(BASE_FOLDER, folder_name(lob))
    if not os.path.isdir(folder):
        log(f"  !! Folder not found: {folder}  (run Part 1 first)")
        return None
    items = load_items(folder)
    log(f"  {len(items)} PDFs listed in {folder}")

    out_dir = os.path.join(SPRINGFIELD_FOLDER, folder_name(lob))
    shutil.rmtree(out_dir, ignore_errors=True)           # fresh copy on every run

    recs = []
    for i, it in enumerate(items, start=1):
        fn = it["Form Number"]
        log(f"  [{i}/{len(items)}] Form {fn}")
        rec = {"Form Number": fn, "Springfield Found": "No", "Page Number": "NA", "_reason": ""}
        path = os.path.join(folder, it["PDF File"]) if it["PDF File"] else ""

        if it["Download Status"] != "Downloaded" or not path or not os.path.isfile(path):
            rec["Springfield Found"] = NOT_DL
            rec["_reason"] = it["Remarks"] or "PDF file is missing"
            log("      !!! NOT DOWNLOADED - no PDF file to search")
        else:
            try:
                found, pages, remark = scan_pdf(path)
                rec["_reason"] = remark
                if remark == "PDF is password protected":
                    rec["Springfield Found"] = "Error"
                elif found:
                    rec["Springfield Found"] = "Yes"
                    rec["Page Number"] = ", ".join(map(str, pages))
                    log(f"      >>> '{SEARCH_TEXT}' FOUND on page(s) {pages}")
                    dest = os.path.join(out_dir, safe_file_name(os.path.splitext(it["PDF File"])[0]) + ".pdf")
                    n = copy_and_highlight(path, dest, pages)
                    log(f"      copied + {n} highlight(s) -> {os.path.relpath(dest)}")
                else:
                    log(f"      '{SEARCH_TEXT}' not found")
            except Exception as e:
                rec["Springfield Found"] = "Error"
                rec["_reason"] = f"Downloaded but could not be opened: {str(e)[:150]}"
                log(f"      !! ERROR reading PDF: {e}")
        recs.append(rec)
    return recs


# ------------------------- Excel --------------------------------------------
def sheet_name(lob, used):
    name = re.sub(r"[\\/*?:\[\]]", "_", lob)[:31] or "Sheet"
    base, n = name, 2
    while name.lower() in used:
        name = f"{base[:28]}_{n}"
        n += 1
    used.add(name.lower())
    return name


def _style_header(ws, widths):
    from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
    head_fill = PatternFill("solid", start_color="1F4E78", end_color="1F4E78")
    thin = Side(style="medium", color="FFFFFF")
    for c in ws[1]:
        c.font = Font(bold=True, color="FFFFFF", size=12)
        c.fill = head_fill
        c.alignment = Alignment(horizontal="center", vertical="center")
        c.border = Border(left=thin, right=thin, top=thin, bottom=thin)
    ws.row_dimensions[1].height = 24
    for col, w in zip("ABCDEFGH", widths):
        ws.column_dimensions[col].width = w
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions                   # filter buttons on every header


def _write_excel(path, results):
    from openpyxl.styles import Font, PatternFill
    red = PatternFill("solid", start_color="FFC7CE", end_color="FFC7CE")
    orange = PatternFill("solid", start_color="FFD8A8", end_color="FFD8A8")
    green = PatternFill("solid", start_color="C6EFCE", end_color="C6EFCE")
    bold_red = Font(bold=True, color="9C0006")

    used, missing = {"not downloaded"}, []
    with pd.ExcelWriter(path, engine="openpyxl") as xw:
        for lob, recs in results.items():
            nm = sheet_name(lob, used)
            df = pd.DataFrame([{c: r[c] for c in COLS} for r in recs], columns=COLS)
            if df.empty:
                df = pd.DataFrame([{"Form Number": "(no PDFs found)"}], columns=COLS)
            df.to_excel(xw, sheet_name=nm, index=False)
            ws = xw.sheets[nm]
            _style_header(ws, [34, 22, 24])
            for r_idx, rec in enumerate(recs, start=2):
                status = rec["Springfield Found"]
                if status == NOT_DL:
                    fill, font = red, bold_red
                    missing.append({"Line of Business": lob, "Form Number": rec["Form Number"],
                                    "Reason": rec["_reason"]})
                elif status == "Error":
                    fill, font = orange, None
                    missing.append({"Line of Business": lob, "Form Number": rec["Form Number"],
                                    "Reason": rec["_reason"]})
                elif status == "Yes":
                    fill, font = green, None
                else:
                    continue
                for cell in ws[r_idx]:
                    cell.fill = fill
                    if font:
                        cell.font = font

        if not results:
            pd.DataFrame(columns=COLS).to_excel(xw, sheet_name="Results", index=False)
        mdf = pd.DataFrame(missing, columns=MISSING_COLS)
        if mdf.empty:
            mdf = pd.DataFrame([{"Line of Business": "-", "Form Number": "All PDFs downloaded and readable",
                                 "Reason": ""}], columns=MISSING_COLS)
        mdf.to_excel(xw, sheet_name="Not Downloaded", index=False)
        ws = xw.sheets["Not Downloaded"]
        _style_header(ws, [24, 34, 80])


def save_excel(results):
    try:
        _write_excel(OUTPUT_XLSX, results)
        return OUTPUT_XLSX
    except PermissionError:
        alt = OUTPUT_XLSX.replace(".xlsx", f"_{datetime.now():%H%M%S}.xlsx")
        log(f"  !! {OUTPUT_XLSX} is open in Excel - saving to {alt} instead")
        _write_excel(alt, results)
        return alt


def run_part2():
    log("PART 2 started - searching downloaded PDFs")
    log(f"Reading PDFs from: {BASE_FOLDER}")
    os.makedirs(SPRINGFIELD_FOLDER, exist_ok=True)

    lobs = list(LINES_OF_BUSINESS)
    if not lobs:
        lobs = sorted(d for d in os.listdir(BASE_FOLDER)
                      if os.path.isdir(os.path.join(BASE_FOLDER, d)) and not d.startswith("_"))
        log(f"No Lines of Business given - found folders: {lobs}")

    results = {}
    for li, lob in enumerate(lobs, start=1):
        log("=" * 64)
        log(f"LINE OF BUSINESS {li}/{len(lobs)}: {lob}")
        log("=" * 64)
        recs = search_lob(lob)
        if recs is None:
            continue
        results[lob] = recs
        yes = sum(r["Springfield Found"] == "Yes" for r in recs)
        nd = sum(r["Springfield Found"] == NOT_DL for r in recs)
        log(f"Finished {lob}: {len(recs)} PDFs | Springfield found in {yes} | not downloaded {nd}")
        save_excel(results)                        # checkpoint after every Line of Business

    out = save_excel(results)
    log("=" * 64)
    log("PART 2 DONE")
    missing = [(l, r["Form Number"]) for l, rs in results.items() for r in rs
               if r["Springfield Found"] == NOT_DL]
    if missing:
        log(f"!!! {len(missing)} PDF(s) were NOT DOWNLOADED (red in Excel / 'Not Downloaded' sheet):")
        for l, f in missing[:40]:
            log(f"!!!   [{l}] {f}")
    log(f"Excel file               : {os.path.abspath(out)}")
    log(f"Highlighted Springfield PDFs: {SPRINGFIELD_FOLDER}")


run_part2()
