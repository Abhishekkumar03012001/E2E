"""
Scan all PDFs in a folder for the word "SpringField" (case-insensitive)
and write the results to an Excel file.

Install requirements:
    pip install pdfplumber openpyxl

Usage:
    1. Set FOLDER_PATH below.
    2. Run:  python pdf_springfield_checker.py
"""

import sys
from pathlib import Path

import pdfplumber
from openpyxl import Workbook
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
from openpyxl.utils import get_column_letter

# ============================ EDIT HERE ============================
FOLDER_PATH = r"C:\path\to\your\pdf_folder"   # <-- put your folder path here
SEARCH_TEXT = "SpringField"                       # text to look for (case-insensitive)
OUTPUT_FILE = "springfield_results.xlsx"          # saved inside FOLDER_PATH
# ===================================================================


def find_pages(pdf_path: Path, search_text: str):
    """Return (list_of_page_numbers, error_message) for the search text in one PDF."""
    pages_found = []
    needle = search_text.lower()
    try:
        with pdfplumber.open(pdf_path) as pdf:
            for page_no, page in enumerate(pdf.pages, start=1):
                text = page.extract_text() or ""
                if needle in text.lower():
                    pages_found.append(page_no)
    except Exception as exc:  # corrupted / password protected PDFs
        return [], str(exc)
    return pages_found, None


def write_excel(rows, output_file: Path):
    wb = Workbook()
    ws = wb.active
    ws.title = "Results"

    headers = ["PDF Name", "SpringField Found (Yes/No)", "Page Number(s)"]
    ws.append(headers)

    # Header styling
    header_fill = PatternFill("solid", fgColor="1F4E78")
    header_font = Font(bold=True, color="FFFFFF", size=12)
    thin = Side(style="thin", color="999999")
    border = Border(left=thin, right=thin, top=thin, bottom=thin)

    for col in range(1, len(headers) + 1):
        cell = ws.cell(row=1, column=col)
        cell.fill = header_fill
        cell.font = header_font
        cell.alignment = Alignment(horizontal="center", vertical="center")
        cell.border = border
    ws.row_dimensions[1].height = 26

    # Data rows
    for row in rows:
        ws.append(row)

    for r in range(2, ws.max_row + 1):
        for c in range(1, 4):
            cell = ws.cell(row=r, column=c)
            cell.border = border
            cell.alignment = Alignment(
                horizontal="left" if c == 1 else "center", vertical="center", wrap_text=True
            )
        found_cell = ws.cell(row=r, column=2)
        if found_cell.value == "Yes":
            found_cell.font = Font(bold=True, color="006100")
            found_cell.fill = PatternFill("solid", fgColor="C6EFCE")
        elif found_cell.value == "No":
            found_cell.font = Font(bold=True, color="9C0006")
            found_cell.fill = PatternFill("solid", fgColor="FFC7CE")

    # Filters, frozen header, column widths
    ws.auto_filter.ref = f"A1:C{ws.max_row}"
    ws.freeze_panes = "A2"
    for col in range(1, 4):
        letter = get_column_letter(col)
        longest = max(len(str(c.value)) if c.value is not None else 0 for c in ws[letter])
        ws.column_dimensions[letter].width = min(max(longest + 4, 18), 60)

    wb.save(output_file)


def main():
    folder = Path(FOLDER_PATH.strip().strip('"'))
    if not folder.is_dir():
        sys.exit(f"Error: '{folder}' is not a valid folder. Check FOLDER_PATH at the top of the script.")

    pdf_files = sorted(
        p for p in folder.iterdir() if p.is_file() and p.suffix.lower() == ".pdf"
    )
    if not pdf_files:
        sys.exit("No PDF files found in the folder.")

    rows = []
    for i, pdf in enumerate(pdf_files, start=1):
        print(f"[{i}/{len(pdf_files)}] Scanning {pdf.name} ...")
        pages, error = find_pages(pdf, SEARCH_TEXT)
        if error:
            print(f"    Could not read file: {error}")
            rows.append([pdf.name, "No", "NA"])
        elif pages:
            rows.append([pdf.name, "Yes", ", ".join(map(str, pages))])
        else:
            rows.append([pdf.name, "No", "NA"])

    output_file = folder / OUTPUT_FILE
    write_excel(rows, output_file)
    print(f"\nDone. Results saved to: {output_file}")


if __name__ == "__main__":
    main()
