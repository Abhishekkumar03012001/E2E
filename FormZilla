"""
FormZilla scraper: for every Line of Business (IL, Liberty Agency), get results,
download each form's PDF, and record the Form Numbers whose PDF contains
"Springfield" along with the page numbers.

Install:
    pip install selenium requests pymupdf pandas openpyxl

Run:
    python formzilla_springfield.py
"""

import os
import re
import sys
import time
import requests
import fitz  # PyMuPDF
import pandas as pd
from datetime import datetime
from selenium import webdriver
from selenium.webdriver.edge.options import Options
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.common.exceptions import TimeoutException

# ----------------------------- CONFIG ---------------------------------------
SITE_URL = "https://doczilla.libertyec.com"   # <- put your exact link here
BRAND = "Liberty Agency"
STATE = "IL"
SEARCH_TEXT = "Springfield"
OUTPUT_XLSX = "springfield_forms.xlsx"
PDF_FOLDER = "downloaded_pdfs"
WAIT = 20

# Optional: reuse your normal Edge profile so you stay auto-logged-in.
# Close ALL Edge windows before running if you enable this.
USE_MY_EDGE_PROFILE = False
EDGE_USER_DATA_DIR = r"C:\Users\YOUR_NAME\AppData\Local\Microsoft\Edge\User Data"
EDGE_PROFILE = "Default"

LINES_OF_BUSINESS = [
    "Condo", "Dwelling fire", "Earthquake", "Homeowners", "Motorcycle",
    "Personal auto", "Personal umbrella", "Recreational vehicle",
    "Renters", "Watercraft",
]

X_FORMZILLA_TAB = "//a[normalize-space()='FormZilla'] | //*[normalize-space(text())='FormZilla']"
def x_select_button(label):
    return (f"(//*[contains(normalize-space(text()),'{label}')]"
            f"/following::*[normalize-space(text())='Select'][1])")
def x_menu_item(text):
    return (f"//*[(self::a or self::li or self::span or self::div or self::button) "
            f"and normalize-space(text())='{text}']")
X_STATE_INPUT = ("(//*[contains(normalize-space(text()),'State')]"
                 "/following::input[1])")
X_GET_RESULTS = "//*[self::button or self::input or self::a][contains(normalize-space(.),'Get Results') or @value='Get Results']"
X_RESULT_ROWS = "//table//tbody/tr[.//a]"
X_NEXT_PAGE = "//a[contains(@class,'next') or normalize-space(.)='Next' or normalize-space(.)='>']"
# ---------------------------------------------------------------------------


def log(msg=""):
    """Print with timestamp and flush immediately so progress shows live."""
    print(f"[{datetime.now():%H:%M:%S}] {msg}", flush=True)


def wait_click(driver, xpath, timeout=WAIT):
    el = WebDriverWait(driver, timeout).until(EC.element_to_be_clickable((By.XPATH, xpath)))
    try:
        el.click()
    except Exception:
        driver.execute_script("arguments[0].click();", el)
    return el


def apply_filters(driver, lob):
    """Re-enter Brand / Line of Business / State every time (page resets)."""
    log("  Opening site...")
    driver.get(SITE_URL)
    log("  Clicking FormZilla tab")
    wait_click(driver, X_FORMZILLA_TAB)
    time.sleep(1.5)

    log(f"  Selecting Brand = {BRAND}")
    wait_click(driver, x_select_button("Brand"))
    wait_click(driver, x_menu_item(BRAND))
    time.sleep(1)

    log(f"  Selecting Line of Business = {lob}")
    wait_click(driver, x_select_button("Line of Business"))
    wait_click(driver, x_menu_item(lob))
    time.sleep(1)

    log(f"  Entering State = {STATE}")
    st = WebDriverWait(driver, WAIT).until(
        EC.element_to_be_clickable((By.XPATH, X_STATE_INPUT)))
    st.clear()
    st.send_keys(STATE)
    time.sleep(0.5)

    log("  Clicking Get Results...")
    wait_click(driver, X_GET_RESULTS)
    time.sleep(3)
    log("  Results loaded")


def get_requests_session(driver):
    s = requests.Session()
    for c in driver.get_cookies():
        s.cookies.set(c["name"], c["value"], domain=c.get("domain"))
    s.headers["User-Agent"] = driver.execute_script("return navigator.userAgent;")
    return s


def collect_rows(driver):
    out = []
    rows = driver.find_elements(By.XPATH, X_RESULT_ROWS)
    for r in rows:
        cells = r.find_elements(By.TAG_NAME, "td")
        if len(cells) < 3:
            continue
        link = None
        for a in r.find_elements(By.TAG_NAME, "a"):
            href = a.get_attribute("href") or ""
            if href and not href.startswith("javascript"):
                link = href
                break
        if not link:
            continue
        out.append({
            "form_number": cells[1].text.strip(),
            "description": cells[2].text.strip(),
            "pdf_url": link,
        })
    return out


def collect_all_pages(driver):
    results, seen = [], set()
    page_no = 1
    while True:
        rows = collect_rows(driver)
        new = 0
        for row in rows:
            key = (row["form_number"], row["pdf_url"])
            if key not in seen:
                seen.add(key)
                results.append(row)
                new += 1
        log(f"  Results page {page_no}: {new} forms read (total {len(results)})")
        nxt = driver.find_elements(By.XPATH, X_NEXT_PAGE)
        nxt = [n for n in nxt if n.is_displayed() and "disabled" not in (n.get_attribute("class") or "")]
        if not nxt:
            break
        driver.execute_script("arguments[0].click();", nxt[0])
        page_no += 1
        time.sleep(2)
    return results


def search_pdf(session, url, form_number):
    """Download PDF and return (page_count, matching page numbers)."""
    safe = re.sub(r"[^\w\-]+", "_", form_number)
    path = os.path.join(PDF_FOLDER, f"{safe}.pdf")
    if not os.path.exists(path):
        log("      Downloading PDF...")
        resp = session.get(url, timeout=60)
        resp.raise_for_status()
        with open(path, "wb") as f:
            f.write(resp.content)
    else:
        log("      PDF already downloaded (using saved copy)")
    pages = []
    with fitz.open(path) as doc:
        total = len(doc)
        log(f"      Scanning {total} page(s) for '{SEARCH_TEXT}'...")
        for i, page in enumerate(doc, start=1):
            if SEARCH_TEXT.lower() in page.get_text().lower():
                pages.append(i)
    return total, pages


def main():
    log("Script started")
    os.makedirs(PDF_FOLDER, exist_ok=True)

    opts = Options()
    opts.add_argument("--start-maximized")
    if USE_MY_EDGE_PROFILE:
        opts.add_argument(f"--user-data-dir={EDGE_USER_DATA_DIR}")
        opts.add_argument(f"--profile-directory={EDGE_PROFILE}")
    log("Opening Edge browser...")
    driver = webdriver.Edge(options=opts)

    hits, errors = [], []
    checked = {}
    total_scanned = 0
    n_lob = len(LINES_OF_BUSINESS)

    try:
        for li, lob in enumerate(LINES_OF_BUSINESS, start=1):
            log("=" * 60)
            log(f"LINE OF BUSINESS {li}/{n_lob}: {lob}")
            log("=" * 60)
            try:
                apply_filters(driver, lob)
                rows = collect_all_pages(driver)
            except TimeoutException:
                log(f"  !! Could not apply filters / get results for {lob} (XPath not found?)")
                errors.append({"line_of_business": lob, "form_number": "", "error": "filter/result timeout"})
                continue

            log(f"  {len(rows)} forms found for {lob}")
            session = get_requests_session(driver)

            for ri, row in enumerate(rows, start=1):
                fn = row["form_number"]
                log(f"  [{ri}/{len(rows)}] Form {fn}")
                key = (fn, row["pdf_url"])
                try:
                    if key not in checked:
                        checked[key] = search_pdf(session, row["pdf_url"], fn)
                        total_scanned += 1
                    else:
                        log("      Already scanned under another Line of Business")
                    total, pages = checked[key]
                    if pages:
                        log(f"      >>> MATCH: '{SEARCH_TEXT}' on page(s) {pages}")
                        hits.append({
                            "line_of_business": lob,
                            "form_number": fn,
                            "description": row["description"],
                            "pages_with_text": ", ".join(map(str, pages)),
                            "pdf_url": row["pdf_url"],
                        })
                    else:
                        log(f"      No match")
                    log(f"      Done. (PDFs scanned so far: {total_scanned} | matches so far: {len(hits)})")
                except Exception as e:
                    log(f"      !! ERROR: {e}")
                    errors.append({"line_of_business": lob, "form_number": fn, "error": str(e)})

            log(f"Finished {lob}. Matches so far: {len(hits)}")
    finally:
        log("Closing browser...")
        driver.quit()

    log(f"Saving Excel file: {OUTPUT_XLSX}")
    # Final output: only Form Number + Page Number (one row per unique form)
    final = {}
    for h in hits:
        final.setdefault(h["form_number"], h["pages_with_text"])
    df = pd.DataFrame(
        [{"Form Number": fn, "Page Number": pg} for fn, pg in final.items()],
        columns=["Form Number", "Page Number"],
    )
    with pd.ExcelWriter(OUTPUT_XLSX, engine="openpyxl") as xw:
        df.to_excel(xw, sheet_name="Springfield forms", index=False)
        ws = xw.sheets["Springfield forms"]
        ws.column_dimensions["A"].width = 28
        ws.column_dimensions["B"].width = 18
        if errors:
            pd.DataFrame(errors).to_excel(xw, sheet_name="Errors", index=False)

    log("=" * 60)
    log(f"ALL DONE. PDFs scanned: {total_scanned} | Unique forms with match: {len(final)} | Errors: {len(errors)}")
    log(f"Output: {os.path.abspath(OUTPUT_XLSX)}")


if __name__ == "__main__":
    main()
