# Results table: column 1 = Icon (pdf), column 2 = Form Number
ICON_COL = 0
FORM_NUMBER_COL = 1

# XPaths - adjust if needed (F12 > right-click element > Copy > Copy XPath)
X_FORMZILLA_TAB = "//*[self::a or self::button or self::li or self::div or self::span][normalize-space(text())='FormZilla']"
X_GET_RESULTS = ("//*[self::button or self::input or self::a]"
                 "[contains(normalize-space(.),'Get Results') or @value='Get Results']")
X_RESULT_ROWS = "//table//tr[td]"

# Next / Previous buttons (taken from your Inspect screenshot: <button id="tableNext" ...>)
X_NEXT_OVERRIDE = "//button[@id='tableNext']"
# ---------------------------------------------------------------------------

UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
LOWER = "abcdefghijklmnopqrstuvwxyz"


def log(msg=""):
    print(f"[{datetime.now():%H:%M:%S}] {msg}", flush=True)


# ------------------------- Selenium helpers ---------------------------------
def is_shown(el):
    try:
        return el.is_displayed()
    except Exception:
        return False


def visible(driver, xpath):
    return [e for e in driver.find_elements(By.XPATH, xpath) if is_shown(e)]


def wait_visible(driver, xpath, timeout=WAIT):
    end = time.time() + timeout
    while time.time() < end:
        v = visible(driver, xpath)
        if v:
            return v[0]
        time.sleep(0.4)
    raise TimeoutError(f"Element not found/visible: {xpath}")


def click(driver, el):
    try:
        driver.execute_script("arguments[0].scrollIntoView({block:'center'});", el)
    except Exception:
        pass
    try:
        el.click()
    except Exception:
        driver.execute_script("arguments[0].click();", el)


def click_xpath(driver, xpath, timeout=WAIT):
    el = wait_visible(driver, xpath, timeout)
    click(driver, el)
    return el


def find_select_button(driver, label, timeout=WAIT):
    """The VISIBLE 'Select' button that follows the VISIBLE label (ignores hidden tabs)."""
    end = time.time() + timeout
    while time.time() < end:
        for lab in visible(driver, f"//*[contains(normalize-space(text()),'{label}')]"):
            for b in lab.find_elements(By.XPATH, "following::*[normalize-space(text())='Select']"):
                if is_shown(b):
                    return b
        time.sleep(0.4)
    raise TimeoutError(f"'Select' button for '{label}' not found")


def click_menu_item(driver, text, timeout=WAIT):
    t = text.lower()
    xp = ("//*[self::a or self::li or self::span or self::div or self::button or self::label or self::option]"
          f"[translate(normalize-space(text()),'{UPPER}','{LOWER}')='{t}']")
    click(driver, wait_visible(driver, xp, timeout))


# ------------------------- Filters ------------------------------------------
def set_state(driver):
    try:
        for lab in visible(driver, "//*[normalize-space(text())='State' or starts-with(normalize-space(text()),'State ')]"):
            for inp in lab.find_elements(By.XPATH, "following::input[1]"):
                if is_shown(inp):
                    cur = (inp.get_attribute("value") or "").strip().upper()
                    if cur == STATE.upper():
                        log(f"  State already = {STATE}")
                        return
                    inp.clear()
                    inp.send_keys(STATE)
                    log(f"  Entered State = {STATE}")
                    return
        log("  (State field not found - it may already be pre-filled)")
    except Exception as e:
        log(f"  (State step skipped: {e})")


def apply_filters(driver, lob):
    log("  Opening site...")
    driver.get(SITE_URL)
    log("  Clicking FormZilla tab")
    click_xpath(driver, X_FORMZILLA_TAB)
    time.sleep(1.5)

    log(f"  Selecting Brand = {BRAND}")
    click(driver, find_select_button(driver, "Brand"))
    click_menu_item(driver, BRAND)
    time.sleep(1.5)

    log(f"  Selecting Line of Business = {lob}")
    click(driver, find_select_button(driver, "Line of Business"))
    time.sleep(0.5)
    click_menu_item(driver, lob)
    time.sleep(1)

    set_state(driver)
    time.sleep(0.5)

    log("  Clicking Get Results...")
    click_xpath(driver, X_GET_RESULTS)


# ------------------------- Results table ------------------------------------
def valid_rows(driver):
    out = []
    for r in driver.find_elements(By.XPATH, X_RESULT_ROWS):
        try:
            if not r.is_displayed():
                continue
            tds = r.find_elements(By.TAG_NAME, "td")
            if len(tds) > max(ICON_COL, FORM_NUMBER_COL) and tds[FORM_NUMBER_COL].text.strip():
                out.append(r)
        except Exception:
            continue
    return out


def wait_for_results(driver, timeout=RESULTS_WAIT):
    end, last, stable = time.time() + timeout, -1, 0
    while time.time() < end:
        n = len(valid_rows(driver))
        if n > 0 and n == last:
            stable += 1
            if stable >= 2:
                return n
        else:
            stable = 0
        last = n
        time.sleep(1)
    return max(last, 0)


def page_signature(driver):
    nums = []
    for r in valid_rows(driver):
        try:
            nums.append(r.find_elements(By.TAG_NAME, "td")[FORM_NUMBER_COL].text.strip())
        except Exception:
            pass
    return hashlib.md5("|".join(nums).encode()).hexdigest() + f"#{len(nums)}"


# ------------------------- Pagination ---------------------------------------
def _lc(expr):
    return f"translate({expr},'{UPPER}','{LOWER}')"


def _is_disabled(el):
    try:
        cls = (el.get_attribute("class") or "").lower()
        pcls = (el.find_element(By.XPATH, "..").get_attribute("class") or "").lower()
        return bool("disabled" in cls or "disabled" in pcls or el.get_attribute("disabled")
                    or el.get_attribute("aria-disabled") == "true")
    except Exception:
        return False


def _usable(el):
    """Displayed, or at least has a real size (some pages report False inside scroll boxes)."""
    if is_shown(el):
        return True
    try:
        s = el.size
        return s["width"] > 0 and s["height"] > 0
    except Exception:
        return False


def log_next_diagnostics(driver):
    xp = ("//*[self::a or self::button or self::li or self::span or self::input]"
          f"[string-length(normalize-space(.))<=15 and ({_lc('normalize-space(.)')}='>' or "
          f"contains({_lc('normalize-space(.)')},'next') or contains({_lc('normalize-space(.)')},'page') "
          f"or contains({_lc('normalize-space(.)')},'prev') or normalize-space(.)='›' or normalize-space(.)='»')]")
    found = driver.find_elements(By.XPATH, xp)[:10]
    if not found:
        log("    (no pagination-looking elements found at all - the Next button may be inside an "
            "iframe or use an icon only. Right-click it > Inspect and send me the HTML.)")
    for el in found:
        try:
            log(f"    candidate: <{el.tag_name}> text='{el.text.strip()}' class='{el.get_attribute('class')}' "
                f"id='{el.get_attribute('id')}' displayed={is_shown(el)}")
        except Exception:
            pass


def find_next_button(driver):
    # Scroll to the bottom first - the Next button sits below the rows
    try:
        driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
        time.sleep(0.5)
    except Exception:
        pass

    if X_NEXT_OVERRIDE:
        for el in driver.find_elements(By.XPATH, X_NEXT_OVERRIDE):
            if _usable(el) and not _is_disabled(el):
                return el
        return None

    xp = ("//*[self::a or self::button or self::input or self::li or self::span or self::div or self::i]"
          "[string-length(normalize-space(.))<25 and ("
          f"contains({_lc('normalize-space(text())')},'next') or "
          f"contains({_lc('@value')},'next') or contains({_lc('@title')},'next') or "
          f"contains({_lc('@aria-label')},'next') or contains({_lc('@class')},'next') or "
          "normalize-space(text())='>' or normalize-space(text())='›' or normalize-space(text())='»')]")
    rank = {"a": 0, "button": 0, "input": 0, "li": 1, "span": 2, "i": 2, "div": 3}
    cands = [e for e in driver.find_elements(By.XPATH, xp) if _usable(e) and not _is_disabled(e)]
    cands.sort(key=lambda e: rank.get(e.tag_name.lower(), 4))
    return cands[0] if cands else None


def wait_page_changed(driver, before, timeout=20):
    end = time.time() + timeout
    while time.time() < end:
        time.sleep(0.5)
        try:
            if page_signature(driver) != before:
                wait_for_results(driver, 15)       # let the new rows finish loading
                return True
        except Exception:
            pass
    return False


def go_next_page(driver):
    """Click Next. True only if the rows really changed."""
    before = page_signature(driver)
    btn = find_next_button(driver)
    if not btn and X_NEXT_OVERRIDE and driver.find_elements(By.XPATH, X_NEXT_OVERRIDE):
        log("  Next button is disabled - this is the last page")
        return False
    if not btn:
        log("  Next button NOT found. Diagnostics:")
        log_next_diagnostics(driver)
        return False

    try:
        log(f"  Clicking Next: <{btn.tag_name}> text='{btn.text.strip()}' class='{btn.get_attribute('class')}'")
    except Exception:
        pass
    try:
        driver.execute_script("arguments[0].scrollIntoView({block:'center'});", btn)
    except Exception:
        pass
    try:
        btn.click()
    except Exception:
        driver.execute_script("arguments[0].click();", btn)

    if wait_page_changed(driver, before):
        return True
    # one more try with a JS click in case the normal click was swallowed
    try:
        driver.execute_script("arguments[0].click();", btn)
    except Exception:
        return False
    return wait_page_changed(driver, before, 12)


# ------------------------- Getting the PDF ----------------------------------
def get_requests_session(driver):
    s = requests.Session()
    for c in driver.get_cookies():
        s.cookies.set(c["name"], c["value"], domain=c.get("domain"))
    s.headers["User-Agent"] = driver.execute_script("return navigator.userAgent;")
    return s


def final_pdf_path(src_bytes_or_path, form_number):
    """Move/save into PDF_FOLDER with a readable, unique name; return the path."""
    safe = re.sub(r"[^\w\-]+", "_", form_number)[:80]
    if isinstance(src_bytes_or_path, bytes):
        h = hashlib.md5(src_bytes_or_path).hexdigest()[:8]
        dest = os.path.join(PDF_FOLDER, f"{safe}_{h}.pdf")
        with open(dest, "wb") as f:
            f.write(src_bytes_or_path)
        return dest
    with open(src_bytes_or_path, "rb") as f:
        h = hashlib.md5(f.read()).hexdigest()[:8]
    dest = os.path.join(PDF_FOLDER, f"{safe}_{h}.pdf")
    os.replace(src_bytes_or_path, dest)
    return dest


def download_via_http(session, url, form_number):
    resp = session.get(url, timeout=90)
    resp.raise_for_status()
    if b"%PDF" not in resp.content[:1024]:
        raise ValueError("not a PDF")
    return final_pdf_path(resp.content, form_number)


def direct_href(driver, row, icon_cell):
    base = driver.current_url
    for a in icon_cell.find_elements(By.TAG_NAME, "a") or row.find_elements(By.TAG_NAME, "a"):
        href = (a.get_attribute("href") or "").strip()
        if href and not href.lower().startswith(("javascript", "#")):
            return urljoin(base, href)
    return None


def pick_icon_element(icon_cell):
    """The actual clickable icon inside the Icon cell (a/button/img/i/span/svg), else the cell."""
    for xp in (".//a", ".//button", ".//img", ".//i", ".//*[name()='svg']", ".//span", ".//*"):
        for el in icon_cell.find_elements(By.XPATH, xp):
            if _usable(el):
                return el
    return icon_cell


def zone_identifier_url(path):
    """Windows stores the download's source URL in the Zone.Identifier stream."""
    try:
        with open(path + ":Zone.Identifier", "r", errors="ignore") as f:
            txt = f.read()
        m = re.search(r"HostUrl=(\S+)", txt) or re.search(r"ReferrerUrl=(\S+)", txt)
        return m.group(1) if m else None
    except Exception:
        return None


def click_icon_and_get_pdf(driver, session, icon_cell, form_number):
    """Click the icon; PDF either downloads straight away or opens in a new tab (which we
    force to download). Returns (local_path, url)."""
    target = pick_icon_element(icon_cell)
    before_files = set(os.listdir(INCOMING))
    main = driver.current_window_handle
    before_handles = set(driver.window_handles)

    click(driver, target)

    tab_url, new_file, last_size, end = None, None, -1, time.time() + DOWNLOAD_WAIT
    while time.time() < end:
        time.sleep(0.7)
        # capture the url of any new tab that opened
        for h in driver.window_handles:
            if h not in before_handles:
                try:
                    driver.switch_to.window(h)
                    u = driver.current_url
                    if u and not u.startswith(("about:", "edge:", "chrome:", "data:")):
                        tab_url = u
                except Exception:
                    pass
        try:
            driver.switch_to.window(main)
        except Exception:
            pass
        # finished download?
        cur = set(os.listdir(INCOMING)) - before_files
        partial = [f for f in cur if f.lower().endswith((".crdownload", ".tmp", ".partial"))]
        done = [f for f in cur if f not in partial]
        if done and not partial:
            p = os.path.join(INCOMING, done[0])
            size = os.path.getsize(p)
            if size == last_size and size > 0:
                new_file = p
                break
            last_size = size

    # close any extra tabs we opened
    for h in list(driver.window_handles):
        if h != main:
            try:
                driver.switch_to.window(h)
                driver.close()
            except Exception:
                pass
    driver.switch_to.window(main)

    if new_file:
        url = tab_url or zone_identifier_url(new_file) or "(downloaded by clicking icon)"
        return final_pdf_path(new_file, form_number), url

    # no file arrived - maybe the tab had a normal http url we can fetch ourselves
    if tab_url and tab_url.lower().startswith("http"):
        return download_via_http(session, tab_url, form_number), tab_url
    raise RuntimeError("Clicked the icon but no PDF downloaded (check popup blocker / PDF setting)")


def fetch_pdf(driver, session, row, icon_cell, form_number):
    href = direct_href(driver, row, icon_cell)
    if href:
        try:
            return download_via_http(session, href, form_number), href
        except Exception as e:
            log(f"      direct link failed ({e}) - trying icon click")
    return click_icon_and_get_pdf(driver, session, icon_cell, form_number)


# ------------------------- PDF search ---------------------------------------
def scan_pdf(path):
    """Open the PDF and return (found, [page numbers], remark)."""
    pages, total_text = [], 0
    with fitz.open(path) as doc:
        total = len(doc)
        log(f"      Opened PDF - searching {total} page(s) for '{SEARCH_TEXT}'...")
        for i, page in enumerate(doc, start=1):
            text = page.get_text()
            total_text += len(text.strip())
            norm = re.sub(r"\s+", " ", text.replace("\u00ad", "")).lower()
            if SEARCH_TEXT.lower() in norm or page.search_for(SEARCH_TEXT):
                pages.append(i)
    remark = ""
    if not pages and total_text == 0:
        remark = "PDF has no text layer (scanned image) - needs OCR"
    return bool(pages), pages, remark


# ------------------------- Excel --------------------------------------------
COLS = ["Form Number", "Springfield Found", "Page Number", "PDF URL", "Results Page", "Remarks"]
SUMMARY_COLS = ["Line of Business", "Sheet Name", "Results Pages Read", "Forms Found",
                "Springfield Yes", "Springfield No", "Errors", "Status"]


def sheet_name(lob, used):
    name = re.sub(r"[\\/*?:\[\]]", "_", lob)[:31] or "Sheet"
    base, n = name, 2
    while name.lower() in used:
        name = f"{base[:28]}_{n}"
        n += 1
    used.add(name.lower())
    return name


def save_excel(results, summary):
    """Save the workbook; if it is open in Excel (locked), save a timestamped copy instead."""
    try:
        _write_excel(OUTPUT_XLSX, results, summary)
    except PermissionError:
        alt = OUTPUT_XLSX.replace(".xlsx", f"_{datetime.now():%H%M%S}.xlsx")
        log(f"  !! {OUTPUT_XLSX} is open/locked - saving to {alt} instead (close Excel next time)")
        _write_excel(alt, results, summary)


def _write_excel(path, results, summary):
    from openpyxl.styles import Font
    used = {"summary"}
    with pd.ExcelWriter(path, engine="openpyxl") as xw:
        pd.DataFrame(summary, columns=SUMMARY_COLS).to_excel(xw, sheet_name="Summary", index=False)
        ws = xw.sheets["Summary"]
        for col, w in zip("ABCDEFGH", [24, 24, 20, 14, 16, 16, 10, 40]):
            ws.column_dimensions[col].width = w
        for c in ws[1]:
            c.font = Font(bold=True)

        for lob, recs in results.items():
            nm = sheet_name(lob, used)
            df = pd.DataFrame(recs, columns=COLS)
            if df.empty:
                df = pd.DataFrame([{"Form Number": "(no forms returned)"}], columns=COLS)
            df.to_excel(xw, sheet_name=nm, index=False)
            ws = xw.sheets[nm]
            for col, w in zip("ABCDEF", [28, 18, 14, 70, 14, 45]):
                ws.column_dimensions[col].width = w
            ws.freeze_panes = "A2"
            for c in ws[1]:
                c.font = Font(bold=True)


# ------------------------- Per-LOB processing -------------------------------
def process_lob(driver, lob, out):
    """Returns (pages_read, status). Appends one record per form to `out`."""
    apply_filters(driver, lob)
    n = wait_for_results(driver)
    if n == 0:
        return 0, "No forms returned (table empty or not found)"
    log(f"  Results loaded ({n} rows on first page)")

    page_no, seen_sigs = 1, set()
    while True:
        sig = page_signature(driver)
        if sig in seen_sigs:
            log("  Same page seen again - stopping pagination")
            break
        seen_sigs.add(sig)

        n_rows = len(valid_rows(driver))
        log(f"  --- Results page {page_no}: {n_rows} forms ---")
        session = get_requests_session(driver)

        # check every PDF of THIS page (click icon -> download -> search)
        for i in range(n_rows):
            rec = {"Form Number": "", "Springfield Found": "No", "Page Number": "NA",
                   "PDF URL": "NA", "Results Page": page_no, "Remarks": ""}
            try:
                rows = valid_rows(driver)
                row = rows[i]
                cells = row.find_elements(By.TAG_NAME, "td")
                fn = cells[FORM_NUMBER_COL].text.strip()
                rec["Form Number"] = fn
                log(f"  [page {page_no} | {i + 1}/{n_rows}] Form {fn}")
                log("      Clicking PDF icon...")
                path, url = fetch_pdf(driver, session, row, cells[ICON_COL], fn)
                log("      PDF downloaded")
                found, pages, remark = scan_pdf(path)
                rec["Remarks"] = remark
                if found:
                    rec["Springfield Found"] = "Yes"
                    rec["Page Number"] = ", ".join(map(str, pages))
                    rec["PDF URL"] = url
                    log(f"      >>> '{SEARCH_TEXT}' FOUND on page(s) {pages}")
                else:
                    log(f"      '{SEARCH_TEXT}' not found")
            except Exception as e:
                rec["Springfield Found"] = "Error"
                rec["Remarks"] = str(e)[:200]
                if not rec["Form Number"]:
                    rec["Form Number"] = f"(row {i + 1} unreadable)"
                log(f"      !! ERROR: {e}")
                try:   # make sure we are back on the main tab
                    driver.switch_to.window(driver.window_handles[0])
                except Exception:
                    pass
            out.append(rec)

        log(f"  Finished page {page_no}. Looking for Next page button...")
        if not go_next_page(driver):
            log("  No more pages")
            break
        page_no += 1
    return page_no, "OK"


# ------------------------- Main ---------------------------------------------
def main():
    log("Script started")
    os.makedirs(INCOMING, exist_ok=True)

    opts = Options()
    opts.add_argument("--start-maximized")
    opts.add_experimental_option("prefs", {
        "download.default_directory": INCOMING,
        "download.prompt_for_download": False,
        "download.directory_upgrade": True,
        "plugins.always_open_pdf_externally": True,   # download PDFs instead of showing the viewer
        "profile.default_content_settings.popups": 0,
    })
    if USE_MY_EDGE_PROFILE:
        opts.add_argument(f"--user-data-dir={EDGE_USER_DATA_DIR}")
        opts.add_argument(f"--profile-directory={EDGE_PROFILE}")
    log("Opening Edge browser...")
    driver = webdriver.Edge(options=opts)

    results, summary, used_names = {}, [], set()
    try:
        for li, lob in enumerate(LINES_OF_BUSINESS, start=1):
            log("=" * 64)
            log(f"LINE OF BUSINESS {li}/{len(LINES_OF_BUSINESS)}: {lob}")
            log("=" * 64)

            status, pages_read = "FAILED", 0
            for attempt in range(1, LOB_ATTEMPTS + 1):
                results[lob] = []
                try:
                    pages_read, status = process_lob(driver, lob, results[lob])
                    if status == "OK" or attempt == LOB_ATTEMPTS:
                        break
                    log(f"  {status} - retrying ({attempt}/{LOB_ATTEMPTS})...")
                except Exception as e:
                    status = f"FAILED: {str(e)[:150]}"
                    log(f"  !! {lob} failed on attempt {attempt}: {e}")
                    try:
                        driver.switch_to.window(driver.window_handles[0])
                    except Exception:
                        pass

            recs = results[lob]
            summary.append({
                "Line of Business": lob,
                "Sheet Name": sheet_name(lob, used_names),
                "Results Pages Read": pages_read,
                "Forms Found": len(recs),
                "Springfield Yes": sum(r["Springfield Found"] == "Yes" for r in recs),
                "Springfield No": sum(r["Springfield Found"] == "No" for r in recs),
                "Errors": sum(r["Springfield Found"] == "Error" for r in recs),
                "Status": status,
            })
            save_excel(results, summary)
            s = summary[-1]
            log(f"Finished {lob}: {s['Forms Found']} forms | Yes {s['Springfield Yes']} | "
                f"No {s['Springfield No']} | Errors {s['Errors']} | {status}")
    finally:
        log("Closing browser...")
        driver.quit()

    save_excel(results, summary)
    log("=" * 64)
    log("SUMMARY")
    for s in summary:
        log(f"  {s['Line of Business']:<22} forms={s['Forms Found']:<4} yes={s['Springfield Yes']:<4} "
            f"errors={s['Errors']:<3} {s['Status']}")
    log(f"Output: {os.path.abspath(OUTPUT_XLSX)}")


if __name__ == "__main__":
    main()
