'====================================================================
' CASE 5: R_O_EQExpense (unchanged - single value replace, not delete/insert)
' Config's existing "Rate" values get replaced by export's single "Expense Load" value
'====================================================================
Private Function ProcessCase5(wsExport As Worksheet, wsConfig As Worksheet, _
    ByRef statusMsg As String, ByRef copiedRows As Long) As Boolean
    On Error GoTo EH

    Dim expNames(1 To 1) As String, cfgNames(1 To 1) As String
    expNames(1) = "Expense Load"
    cfgNames(1) = "Rate"

    Dim expHeaderRow As Long, cfgHeaderRow As Long
    expHeaderRow = FindHeaderRow(wsExport, expNames)
    cfgHeaderRow = FindHeaderRow(wsConfig, cfgNames)

    Dim eExpense As Long, cRate As Long
    eExpense = FindColumn(wsExport, expHeaderRow, "Expense Load")
    cRate = FindColumn(wsConfig, cfgHeaderRow, "Rate")

    If eExpense = 0 Or cRate = 0 Then
        statusMsg = "Columns not found"
        ProcessCase5 = False
        Exit Function
    End If

    Dim expVal As Variant
    expVal = wsExport.Cells(expHeaderRow + 1, eExpense).Value

    If Trim(CStr(expVal)) = "" Then
        statusMsg = "Expense Load value is blank in export"
        ProcessCase5 = False
        Exit Function
    End If

    Dim lastRowC As Long, r As Long
    lastRowC = wsConfig.Cells(wsConfig.Rows.Count, cRate).End(xlUp).Row
    copiedRows = 0
    For r = cfgHeaderRow + 1 To lastRowC
        If Trim(wsConfig.Cells(r, cRate).Value) <> "" Then
            wsConfig.Cells(r, cRate).Value = expVal
            copiedRows = copiedRows + 1
        End If
    Next r

    If copiedRows = 0 Then
        statusMsg = "No existing value found to replace"
        ProcessCase5 = False
    Else
        statusMsg = "OK"
        ProcessCase5 = True
    End If
    Exit Function
EH:
    statusMsg = "Error: " & Err.Description
    ProcessCase5 = False
End Function

'====================================================================
' HELPER FUNCTIONS
'====================================================================

' Finds the best header row (1 to 4) using normalized matching
Private Function FindHeaderRow(ws As Worksheet, targetNames() As String) As Long
    Dim r As Long, bestRow As Long, bestMatches As Long, matches As Long, i As Long
    bestMatches = -1
    bestRow = 1
    For r = 1 To 4
        matches = 0
        For i = LBound(targetNames) To UBound(targetNames)
            If FindColumn(ws, r, targetNames(i)) > 0 Then matches = matches + 1
        Next i
        If matches > bestMatches Then
            bestMatches = matches
            bestRow = r
        End If
    Next r
    FindHeaderRow = bestRow
End Function

' Finds the FIRST column whose header matches targetName after normalization
' (case-insensitive, ignores extra spaces/punctuation) but requires FULL match, not partial/substring
Private Function FindColumn(ws As Worksheet, headerRow As Long, targetName As String) As Long
    Dim lastCol As Long, c As Long
    Dim normTarget As String, normHeader As String
    normTarget = NormalizeForCompare(targetName)
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    If lastCol < 1 Then lastCol = 1
    For c = 1 To lastCol
        normHeader = NormalizeForCompare(CStr(ws.Cells(headerRow, c).Value))
        If normHeader = normTarget Then
            FindColumn = c
            Exit Function
        End If
    Next c
    FindColumn = 0
End Function

' Finds TWO columns headered "County" in a row (used only for R_O_EQYearBuilt export sheet).
' The one whose first data value is numeric is treated as the County Code column;
' the one whose first data value is text is treated as the County name column.
Private Sub FindCountyColumns(ws As Worksheet, headerRow As Long, ByRef nameCol As Long, ByRef codeCol As Long)
    Dim lastCol As Long, c As Long
    Dim candidates As Collection: Set candidates = New Collection
    nameCol = 0: codeCol = 0

    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        If NormalizeForCompare(CStr(ws.Cells(headerRow, c).Value)) = NormalizeForCompare("County") Then
            candidates.Add c
        End If
    Next c

    Dim ci As Variant, sampleVal As Variant, r As Long, lastRowThis As Long
    For Each ci In candidates
        sampleVal = ""
        lastRowThis = ws.Cells(ws.Rows.Count, CLng(ci)).End(xlUp).Row
        For r = headerRow + 1 To lastRowThis
            If Trim(CStr(ws.Cells(r, CLng(ci)).Value)) <> "" Then
                sampleVal = ws.Cells(r, CLng(ci)).Value
                Exit For
            End If
        Next r
        If Trim(CStr(sampleVal)) <> "" And IsNumeric(sampleVal) Then
            If codeCol = 0 Then codeCol = CLng(ci)
        Else
            If nameCol = 0 Then nameCol = CLng(ci)
        End If
    Next ci
End Sub

' Strips spaces, punctuation, and non-breaking spaces; lowercases. Used ONLY for header comparison.
Private Function NormalizeForCompare(s As String) As String
    Dim i As Long, ch As String, res As String
    s = Replace(s, Chr(160), " ")  ' non-breaking space -> regular space
    s = LCase(Trim(s))
    For i = 1 To Len(s)
        ch = Mid(s, i, 1)
        If ch Like "[a-z0-9]" Then
            res = res & ch
        End If
    Next i
    NormalizeForCompare = res
End Function

' Normalizes a value for KEY comparison (used for county code dictionary lookups).
Private Function NormalizeKeyValue(v As Variant, fieldType As String) As String
    Dim s As String
    s = Trim(CStr(v))
    If IsNumeric(s) Then
        NormalizeKeyValue = CStr(CDbl(s))
    Else
        NormalizeKeyValue = LCase(s)
    End If
End Function

' Strips a trailing "%" and returns a plain number if possible (e.g. "5%" -> 5)
Private Function ConvertPercentToPlain(v As Variant) As Variant
    Dim s As String
    s = Trim(CStr(v))
    If Right(s, 1) = "%" Then s = Left(s, Len(s) - 1)
    If IsNumeric(s) Then
        ConvertPercentToPlain = CDbl(s)
    Else
        ConvertPercentToPlain = s
    End If
End Function

' Maps Retrofit Indicator (Yes/No) to Retrofit (Y/N)
Private Function MapRetrofit(v As Variant) As String
    Select Case LCase(Trim(CStr(v)))
        Case "yes", "y": MapRetrofit = "Y"
        Case "no", "n": MapRetrofit = "N"
        Case Else: MapRetrofit = CStr(v)
    End Select
End Function

' Deletes existing data in the given Config columns (below header) and writes new rows
' in the order given by outputRows. If new rows exceed the original data row count,
' formatting is copied down from the last original data row to preserve layout.
' Also captures and reapplies each column's original NumberFormat so values like
' county codes ("001") keep the same display format they had before being cleared.
Private Sub WriteRowsToConfig(wsConfig As Worksheet, cfgHeaderRow As Long, colIndices() As Long, outputRows As Collection)
    Dim neededRows As Long: neededRows = outputRows.Count
    Dim templateLastRow As Long: templateLastRow = cfgHeaderRow
    Dim i As Long, lr As Long

    For i = LBound(colIndices) To UBound(colIndices)
        lr = wsConfig.Cells(wsConfig.Rows.Count, colIndices(i)).End(xlUp).Row
        If lr > templateLastRow Then templateLastRow = lr
    Next i
    Dim templateRowCount As Long: templateRowCount = templateLastRow - cfgHeaderRow

    ' --- Capture original number format for each column BEFORE clearing ---
    Dim colFormats() As String
    ReDim colFormats(LBound(colIndices) To UBound(colIndices))
    If templateRowCount > 0 Then
        For i = LBound(colIndices) To UBound(colIndices)
            colFormats(i) = wsConfig.Cells(cfgHeaderRow + 1, colIndices(i)).NumberFormat
        Next i
    End If

    Dim clearLastRow As Long: clearLastRow = templateLastRow
    If cfgHeaderRow + neededRows > clearLastRow Then clearLastRow = cfgHeaderRow + neededRows

    ' Clear old values in relevant columns only (formatting untouched)
    Dim rr As Long
    For rr = cfgHeaderRow + 1 To clearLastRow
        For i = LBound(colIndices) To UBound(colIndices)
            wsConfig.Cells(rr, colIndices(i)).ClearContents
        Next i
    Next rr

    ' Write new rows
    Dim targetRow As Long, rowDict As Object, k As Variant
    For i = 1 To neededRows
        targetRow = cfgHeaderRow + i
        If templateRowCount > 0 And i > templateRowCount Then
            wsConfig.Rows(cfgHeaderRow + templateRowCount).Copy
            wsConfig.Rows(targetRow).PasteSpecial xlPasteFormats
            Application.CutCopyMode = False
        End If

        ' --- Reapply the original captured format to each target cell ---
        Dim j As Long
        For j = LBound(colIndices) To UBound(colIndices)
            If templateRowCount > 0 Then
                wsConfig.Cells(targetRow, colIndices(j)).NumberFormat = colFormats(j)
            End If
        Next j

        Set rowDict = outputRows(i)
        For Each k In rowDict.Keys
            wsConfig.Cells(targetRow, CLng(k)).Value = rowDict(k)
        Next k
    Next i
End Sub

' Writes status (D) and row-copied count (E). Pass copiedRows = -1 to leave E blank.
Private Sub WriteResult(ws As Worksheet, r As Long, statusMsg As String, colorType As String, copiedRows As Long)
    ws.Cells(r, 4).Value = statusMsg

    If copiedRows >= 0 Then
        ws.Cells(r, 5).Value = copiedRows
    Else
        ws.Cells(r, 5).ClearContents
    End If

    Select Case LCase(colorType)
        Case "red"
            ws.Cells(r, 4).Interior.Color = RGB(255, 199, 206)   ' light red
        Case "yellow"
            ws.Cells(r, 4).Interior.Color = RGB(255, 235, 156)   ' light yellow
        Case "green"
            ws.Cells(r, 4).Interior.Color = RGB(198, 239, 206)   ' light green
        Case Else
            ws.Cells(r, 4).Interior.ColorIndex = xlNone
    End Select
End Sub

' Builds a new file path: same folder, filename + "_updated_EQ", same extension
Private Function BuildSaveAsPath(originalPath As String) As String
    Dim folderPath As String, fileName As String, fileExt As String, baseName As String
    Dim dotPos As Long, slashPos As Long

    slashPos = InStrRev(originalPath, "\")
    folderPath = Left(originalPath, slashPos)
    fileName = Mid(originalPath, slashPos + 1)

    dotPos = InStrRev(fileName, ".")
    If dotPos > 0 Then
        baseName = Left(fileName, dotPos - 1)
        fileExt = Mid(fileName, dotPos)
    Else
        baseName = fileName
        fileExt = ""
    End If

    BuildSaveAsPath = folderPath & baseName & "_updated_EQ" & fileExt
End Function
