Option Explicit
Option Compare Text  '-- case-insensitive text comparisons (=, Like, Select Case)

'====================================================================
' MAIN ENTRY POINT
'====================================================================
Public Sub ImportEQData(Optional configPath As String = "", Optional exportPath As String = "")
    Dim wbConfig As Workbook, wbExport As Workbook
    Dim wsEQTabs As Worksheet
    Dim r As Long
    Dim exportSheetName As String, configSheetName As String, yesNo As String
    Dim wsExport As Worksheet, wsConfig As Worksheet
    Dim success As Boolean, statusMsg As String
    Dim copiedRows As Long
    Dim newConfigPath As String
    Dim matchedCase As Integer
    Dim countyDict As Object

    On Error GoTo ErrHandler

    If Trim(configPath) = "" Then
        configPath = Application.GetOpenFilename("Excel Files (*.xlsx; *.xlsm; *.xls),*.xlsx;*.xlsm;*.xls", , "Select CONFIG file")
        If configPath = "False" Then Exit Sub
    End If
    If Trim(exportPath) = "" Then
        exportPath = Application.GetOpenFilename("Excel Files (*.xlsx; *.xlsm; *.xls),*.xlsx;*.xlsm;*.xls", , "Select EXPORTS file")
        If exportPath = "False" Then Exit Sub
    End If

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.DisplayAlerts = False

    Set wbConfig = Workbooks.Open(Filename:=configPath, ReadOnly:=True, IgnoreReadOnlyRecommended:=True)
    Set wbExport = Workbooks.Open(Filename:=exportPath, ReadOnly:=True, IgnoreReadOnlyRecommended:=True)
    Set wsEQTabs = ThisWorkbook.Sheets("EQ Tabs")

    Set countyDict = LoadCountyLookup(wbExport)

    r = 2
    Do While Not (Trim(wsEQTabs.Cells(r, 1).Value) = "" And Trim(wsEQTabs.Cells(r, 2).Value) = "")

        exportSheetName = Trim(wsEQTabs.Cells(r, 1).Value)
        configSheetName = Trim(wsEQTabs.Cells(r, 2).Value)
        yesNo = Trim(wsEQTabs.Cells(r, 3).Value)

        copiedRows = 0

        If LCase(yesNo) = "no" Then
            '-- Column C is No: skip entirely, don't validate A/B, don't set counts
            WriteResult wsEQTabs, r, "Skipped", "none", -1

        ElseIf exportSheetName = "" Or configSheetName = "" Then
            '-- Either cell blank
            WriteResult wsEQTabs, r, "Invalide Sheet name config/export", "red", -1

        Else
            '-- STEP 1: does this sheet exist in Config, and does its name match a valid EQ pattern?
            Set wsConfig = Nothing
            On Error Resume Next
            Set wsConfig = wbConfig.Sheets(configSheetName)
            On Error GoTo ErrHandler

            matchedCase = GetCaseType(configSheetName)

            If wsConfig Is Nothing Or matchedCase = 0 Then
                WriteResult wsEQTabs, r, "Not a Valid EQ sheet in Config", "red", -1

            Else
                '-- STEP 2: does this sheet exist in Export?
                Set wsExport = Nothing
                On Error Resume Next
                Set wsExport = wbExport.Sheets(exportSheetName)
                On Error GoTo ErrHandler

                If wsExport Is Nothing Then
                    WriteResult wsEQTabs, r, "Sheet on found in Export", "red", -1

                Else
                    '-- STEP 3: proceed with the matched case
                    success = False
                    statusMsg = ""

                    Select Case matchedCase
                        Case 1
                            success = ProcessCase1(wsExport, wsConfig, countyDict, statusMsg, copiedRows)
                        Case 2
                            success = ProcessCase2(wsExport, wsConfig, statusMsg, copiedRows)
                        Case 3
                            success = ProcessCase3(wsExport, wsConfig, countyDict, statusMsg, copiedRows)
                        Case 4
                            success = ProcessCase4(wsExport, wsConfig, countyDict, statusMsg, copiedRows)
                        Case 5
                            success = ProcessCase5(wsExport, wsConfig, statusMsg, copiedRows)
                    End Select

                    If success Then
                        WriteResult wsEQTabs, r, "Validated", "green", copiedRows
                    Else
                        WriteResult wsEQTabs, r, statusMsg, "red", copiedRows
                    End If
                End If
            End If
        End If

        r = r + 1
    Loop

    newConfigPath = BuildSaveAsPath(configPath)
    wbConfig.SaveAs Filename:=newConfigPath, FileFormat:=wbConfig.FileFormat
    wbConfig.Close SaveChanges:=False

    wbExport.Close SaveChanges:=False

    Application.DisplayAlerts = True
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True

    MsgBox "Processing complete." & vbCrLf & "Saved as: " & newConfigPath, vbInformation
    Exit Sub

ErrHandler:
    Application.DisplayAlerts = True
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    MsgBox "Unexpected error: " & Err.Description, vbCritical
End Sub

'====================================================================
' Returns which case (1-5) a config sheet name matches, or 0 if none
'====================================================================
Private Function GetCaseType(configSheetName As String) As Integer
    Select Case True
        Case configSheetName Like "R_O_EQCov*", configSheetName Like "R_O_EQIncrCov*"
            GetCaseType = 1
        Case configSheetName Like "R_O_EQDed*"
            GetCaseType = 2
        Case configSheetName Like "R_O_EQYearBuilt*"
            GetCaseType = 3
        Case configSheetName Like "R_O_LossAssessmentEQ*"
            GetCaseType = 4
        Case configSheetName Like "R_O_EQExpense*"
            GetCaseType = 5
        Case Else
            GetCaseType = 0
    End Select
End Function

'====================================================================
' Loads County -> County Code lookup from the "County" sheet in Export workbook
' Column A = County (name), Column B = "new code" / "County Code"
'====================================================================
Private Function LoadCountyLookup(wbExport As Workbook) As Object
    Dim dict As Object: Set dict = CreateObject("Scripting.Dictionary")
    Dim wsCounty As Worksheet

    On Error Resume Next
    Set wsCounty = wbExport.Sheets("County")
    On Error GoTo 0

    If wsCounty Is Nothing Then
        Set LoadCountyLookup = dict
        Exit Function
    End If

    Dim hdrNames(1 To 2) As String
    hdrNames(1) = "County": hdrNames(2) = "new code"
    Dim hdrRow As Long
    hdrRow = FindHeaderRow(wsCounty, hdrNames)

    Dim nameCol As Long, codeCol As Long
    nameCol = FindColumn(wsCounty, hdrRow, "County")
    codeCol = FindColumn(wsCounty, hdrRow, "new code")
    If codeCol = 0 Then codeCol = FindColumn(wsCounty, hdrRow, "County Code")

    If nameCol = 0 Or codeCol = 0 Then
        Set LoadCountyLookup = dict
        Exit Function
    End If

    Dim lastRow As Long, r As Long, key As String
    lastRow = wsCounty.Cells(wsCounty.Rows.Count, codeCol).End(xlUp).Row
    For r = hdrRow + 1 To lastRow
        If Trim(wsCounty.Cells(r, codeCol).Value) <> "" Then
            key = NormalizeKeyValue(wsCounty.Cells(r, codeCol).Value, "text")
            If Not dict.Exists(key) Then dict.Add key, wsCounty.Cells(r, nameCol).Value
        End If
    Next r

    Set LoadCountyLookup = dict
End Function

' Looks up a county name by code from the dictionary; returns "" if not found
Private Function LookupCounty(dict As Object, codeVal As Variant) As String
    Dim key As String
    key = NormalizeKeyValue(codeVal, "text")
    If dict.Exists(key) Then
        LookupCounty = dict(key)
    Else
        LookupCounty = ""
    End If
End Function

'====================================================================
' CASE 1: R_O_EQCovA/B/C/D , R_O_EQIncrCovA/B/C/D
' Export: County Code | Earthquake Construction Type | Rate per $1000  (optional: County)
' Config: County | County Code | EQ Construction Type | Rate
' Deletes old Config data rows, writes new rows in Export's order
'====================================================================
Private Function ProcessCase1(wsExport As Worksheet, wsConfig As Worksheet, countyDict As Object, _
    ByRef statusMsg As String, ByRef copiedRows As Long) As Boolean
    On Error GoTo EH

    Dim expNames(1 To 3) As String, cfgNames(1 To 4) As String
    expNames(1) = "County Code": expNames(2) = "Earthquake Construction Type": expNames(3) = "Rate per $1000"
    cfgNames(1) = "County": cfgNames(2) = "County Code": cfgNames(3) = "EQ Construction Type": cfgNames(4) = "Rate"

    Dim expHeaderRow As Long, cfgHeaderRow As Long
    expHeaderRow = FindHeaderRow(wsExport, expNames)
    cfgHeaderRow = FindHeaderRow(wsConfig, cfgNames)

    Dim eCC As Long, eCT As Long, eRate As Long, eCountyDirect As Long
    Dim cCounty As Long, cCC As Long, cCT As Long, cRate As Long
    eCC = FindColumn(wsExport, expHeaderRow, "County Code")
    eCT = FindColumn(wsExport, expHeaderRow, "Earthquake Construction Type")
    eRate = FindColumn(wsExport, expHeaderRow, "Rate per $1000")
    eCountyDirect = FindColumn(wsExport, expHeaderRow, "County")

    cCounty = FindColumn(wsConfig, cfgHeaderRow, "County")
    cCC = FindColumn(wsConfig, cfgHeaderRow, "County Code")
    cCT = FindColumn(wsConfig, cfgHeaderRow, "EQ Construction Type")
    cRate = FindColumn(wsConfig, cfgHeaderRow, "Rate")

    If eCC = 0 Or eCT = 0 Or eRate = 0 Or cCounty = 0 Or cCC = 0 Or cCT = 0 Or cRate = 0 Then
        statusMsg = "Columns not found"
        ProcessCase1 = False
        Exit Function
    End If

    Dim outputRows As Collection: Set outputRows = New Collection
    Dim lastRowE As Long, r As Long, rowDict As Object, countyName As String
    lastRowE = wsExport.Cells(wsExport.Rows.Count, eCC).End(xlUp).Row
    For r = expHeaderRow + 1 To lastRowE
        If Trim(wsExport.Cells(r, eCC).Value) <> "" Then
            Set rowDict = CreateObject("Scripting.Dictionary")
            If eCountyDirect > 0 Then
                countyName = wsExport.Cells(r, eCountyDirect).Value
            Else
                countyName = LookupCounty(countyDict, wsExport.Cells(r, eCC).Value)
            End If
            rowDict.Add cCounty, countyName
            rowDict.Add cCC, wsExport.Cells(r, eCC).Value
            rowDict.Add cCT, wsExport.Cells(r, eCT).Value
            rowDict.Add cRate, wsExport.Cells(r, eRate).Value
            outputRows.Add rowDict
        End If
    Next r

    copiedRows = outputRows.Count
    If copiedRows = 0 Then
        statusMsg = "No data rows found in export"
        ProcessCase1 = False
        Exit Function
    End If

    Dim colIdx(0 To 3) As Long
    colIdx(0) = cCounty: colIdx(1) = cCC: colIdx(2) = cCT: colIdx(3) = cRate
    WriteRowsToConfig wsConfig, cfgHeaderRow, colIdx, outputRows

    statusMsg = "OK"
    ProcessCase1 = True
    Exit Function
EH:
    statusMsg = "Error: " & Err.Description
    ProcessCase1 = False
End Function

