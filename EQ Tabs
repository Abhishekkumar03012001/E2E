                  NormalizeKeyValue(wsExport.Cells(r, eRetro).Value, "yn") & "||" & _
                  NormalizeKeyValue(wsExport.Cells(r, eCounty).Value, "text") & "||" & _
                  NormalizeKeyValue(wsExport.Cells(r, eCT).Value, "text")
            dict(key) = wsExport.Cells(r, eFactor).Value
