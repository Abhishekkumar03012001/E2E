' Export: Year Build | Retrofit Indicator | County | Construction Type | Factor
' Config: Year Build (Upper Bound) | Retrofit | County | County Code | EQ Construction Type | Rate
' NOTE: export's "County" is matched against config's "County Code" (not config's "County")
' Retrofit Indicator (Yes/No) maps to Retrofit (Y/N)
'====================================================================
Private Function ProcessCase3(wsExport As Worksheet, wsConfig As Worksheet, ByRef msg As String) As Boolean
    On Error GoTo EH

    Dim expNames(1 To 5) As String, cfgNames(1 To 6) As String
    expNames(1) = "Year Build": expNames(2) = "Retrofit Indicator": expNames(3) = "County"
    expNames(4) = "Construction Type": expNames(5) = "Factor"
    cfgNames(1) = "Year Build (Upper Bound)": cfgNames(2) = "Retrofit": cfgNames(3) = "County"
    cfgNames(4) = "County Code": cfgNames(5) = "EQ Construction Type": cfgNames(6) = "Rate"

    Dim expHeaderRow As Long, cfgHeaderRow As Long
    expHeaderRow = FindHeaderRow(wsExport, expNames)
    cfgHeaderRow = FindHeaderRow(wsConfig, cfgNames)

    Dim eYB As Long, eRetro As Long, eCounty As Long, eCT As Long, eFactor As Long
    Dim cYB As Long, cRetro As Long, cCC As Long, cCT As Long, cRate As Long
    eYB = FindColumn(wsExport, expHeaderRow, "Year Build")
    eRetro = FindColumn(wsExport, expHeaderRow, "Retrofit Indicator")
    eCounty = FindColumn(wsExport, expHeaderRow, "County")
    eCT = FindColumn(wsExport, expHeaderRow, "Construction Type")
    eFactor = FindColumn(wsExport, expHeaderRow, "Factor")

    cYB = FindColumn(wsConfig, cfgHeaderRow, "Year Build (Upper Bound)")
    cRetro = FindColumn(wsConfig, cfgHeaderRow, "Retrofit")
    cCC = FindColumn(wsConfig, cfgHeaderRow, "County Code")
    cCT = FindColumn(wsConfig, cfgHeaderRow, "EQ Construction Type")
    cRate = FindColumn(wsConfig, cfgHeaderRow, "Rate")

    If eYB = 0 Or eRetro = 0 Or eCounty = 0 Or eCT = 0 Or eFactor = 0 Or _
       cYB = 0 Or cRetro = 0 Or cCC = 0 Or cCT = 0 Or cRate = 0 Then
        msg = "Required columns not found"
        ProcessCase3 = False
        Exit Function
