'====================================================================
' CASE 5: R_O_EQExpense
' Config's single "Rate" value gets replaced by export's "Expense Load" value
'====================================================================
Private Function ProcessCase5(wsExport As Worksheet, wsConfig As Worksheet, ByRef statusMsg As String, _
    ByRef cfgRows As Long, ByRef expRows As Long, ByRef copiedRows As Long) As Boolean
    On Error GoTo EH

    Dim expNames(1 To 1) As String, cfgNames(1 To 1) As String
    expNames(1) = "Expense Load"
    cfgNames(1) = "Rate"

    Dim expHeaderRow As Long, cfgHeaderRow As Long
    expHeaderRow = FindHeaderRow(wsExport, expNames)
    cfgHeaderRow = FindHeaderRow(wsConfig, cfgNames)

    Dim eExpense As Long, cRate As Long
    eExpense = FindColumn(wsExport, expHeaderRow, "Expense Load")
    cRate = FindColumn(wsConfig, cfgHeaderRow, "Rate")

    If eExpense = 0 Or cRate = 0 Then
        statusMsg = "Columns not found"
        ProcessCase5 = False
        Exit Function
    End If

    Dim expVal As Variant
    expVal = wsExport.Cells(expHeaderRow + 1, eExpense).Value
    expRows = 1

    If Trim(CStr(expVal)) = "" Then
        statusMsg = "Expense Load value is blank in export"
        ProcessCase5 = False
        Exit Function
    End If

    Dim lastRowC As Long, r As Long
    lastRowC = wsConfig.Cells(wsConfig.Rows.Count, cRate).End(xlUp).Row
    For r = cfgHeaderRow + 1 To lastRowC
        If Trim(wsConfig.Cells(r, cRate).Value) <> "" Then
            cfgRows = cfgRows + 1
            wsConfig.Cells(r, cRate).Value = expVal
            copiedRows = copiedRows + 1
        End If
    Next r

    If copiedRows = 0 Then
        statusMsg = "No existing value found to replace"
        ProcessCase5 = False
    Else
        statusMsg = "OK"
        ProcessCase5 = True
    End If
    Exit Function
EH:
    statusMsg = "Error: " & Err.Description
    ProcessCase5 = False
End Function

'====================================================================
' HELPER FUNCTIONS
'====================================================================

' Finds the best header row (1 to 4) using EXACT case-insensitive matching
Private Function FindHeaderRow(ws As Worksheet, targetNames() As String) As Long
    Dim r As Long, bestRow As Long, bestMatches As Long, matches As Long, i As Long
    bestMatches = -1
    bestRow = 1
    For r = 1 To 4
        matches = 0
        For i = LBound(targetNames) To UBound(targetNames)
            If FindColumn(ws, r, targetNames(i)) > 0 Then matches = matches + 1
        Next i
        If matches > bestMatches Then
            bestMatches = matches
            bestRow = r
        End If
    Next r
    FindHeaderRow = bestRow
End Function

' Finds the column number whose header EXACTLY matches targetName (case-insensitive, trimmed only)
' Finds the column number whose header matches targetName after normalization
' (case-insensitive, ignores extra spaces/punctuation) but requires FULL match, not partial/substring
Private Function FindColumn(ws As Worksheet, headerRow As Long, targetName As String) As Long
    Dim lastCol As Long, c As Long
    Dim normTarget As String, normHeader As String
    normTarget = NormalizeForCompare(targetName)
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    If lastCol < 1 Then lastCol = 1
    For c = 1 To lastCol
        normHeader = NormalizeForCompare(CStr(ws.Cells(headerRow, c).Value))
        If normHeader = normTarget Then
            FindColumn = c
            Exit Function
        End If
    Next c
    FindColumn = 0
End Function

' Strips spaces, punctuation, and non-breaking spaces; lowercases. Used ONLY for header comparison.
Private Function NormalizeForCompare(s As String) As String
    Dim i As Long, ch As String, res As String
    s = Replace(s, Chr(160), " ")  ' non-breaking space -> regular space
    s = LCase(Trim(s))
    For i = 1 To Len(s)
        ch = Mid(s, i, 1)
        If ch Like "[a-z0-9]" Then
            res = res & ch
        End If
    Next i
    NormalizeForCompare = res
End Function

' Normalizes a cell value for key comparison.
' fieldType: "text" (general), "percent" (strips trailing %), "yn" (Yes/No -> Y/N)
Private Function NormalizeKeyValue(v As Variant, fieldType As String) As String
    Dim s As String
    s = Trim(CStr(v))

    Select Case LCase(fieldType)
        Case "percent"
            If Right(s, 1) = "%" Then s = Left(s, Len(s) - 1)
            If IsNumeric(s) Then
                NormalizeKeyValue = CStr(CDbl(s))
            Else
                NormalizeKeyValue = LCase(s)
            End If

        Case "yn"
            Select Case LCase(s)
                Case "yes", "y": NormalizeKeyValue = "Y"
                Case "no", "n": NormalizeKeyValue = "N"
                Case Else: NormalizeKeyValue = UCase(s)
            End Select

        Case Else
            If IsNumeric(s) Then
                NormalizeKeyValue = CStr(CDbl(s))
            Else
                NormalizeKeyValue = LCase(s)
            End If
    End Select
End Function

' Writes status (D), config row count (E), export row count (F), copied row count (G)
Private Sub WriteResult(ws As Worksheet, r As Long, statusMsg As String, colorType As String, _
    cfgRows As Long, expRows As Long, copiedRows As Long)

    ws.Cells(r, 4).Value = statusMsg
    If cfgRows > 0 Or expRows > 0 Or copiedRows > 0 Then
        ws.Cells(r, 5).Value = cfgRows
        ws.Cells(r, 6).Value = expRows
        ws.Cells(r, 7).Value = copiedRows
    End If

    Select Case LCase(colorType)
        Case "red"
            ws.Cells(r, 4).Interior.Color = RGB(255, 199, 206)   ' light red
        Case "yellow"
            ws.Cells(r, 4).Interior.Color = RGB(255, 235, 156)   ' light yellow
        Case "green"
            ws.Cells(r, 4).Interior.Color = RGB(198, 239, 206)   ' light green
        Case Else
            ws.Cells(r, 4).Interior.ColorIndex = xlNone
    End Select
End Sub

' Builds a new file path: same folder, filename + "_updated_EQ", same extension
Private Function BuildSaveAsPath(originalPath As String) As String
    Dim folderPath As String, fileName As String, fileExt As String, baseName As String
    Dim dotPos As Long, slashPos As Long

    slashPos = InStrRev(originalPath, "\")
    folderPath = Left(originalPath, slashPos)
    fileName = Mid(originalPath, slashPos + 1)

    dotPos = InStrRev(fileName, ".")
    If dotPos > 0 Then
        baseName = Left(fileName, dotPos - 1)
        fileExt = Mid(fileName, dotPos)
    Else
        baseName = fileName
        fileExt = ""
    End If

    BuildSaveAsPath = folderPath & baseName & "_updated_EQ" & fileExt
End Function
