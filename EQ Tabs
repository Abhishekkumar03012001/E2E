Option Explicit
Option Compare Text  '-- case-insensitive text comparisons (=, Like, Select Case)

'====================================================================
' MAIN ENTRY POINT
'====================================================================
'====================================================================
' MAIN ENTRY POINT
'====================================================================
Public Sub ImportEQData(Optional configPath As String = "", Optional exportPath As String = "")
    Dim wbConfig As Workbook, wbExport As Workbook
    Dim wsEQTabs As Worksheet
    Dim r As Long
    Dim exportSheetName As String, configSheetName As String, yesNo As String
    Dim wsExport As Worksheet, wsConfig As Worksheet
    Dim success As Boolean, statusMsg As String
    Dim cfgRows As Long, expRows As Long, copiedRows As Long
    Dim newConfigPath As String
    Dim matchedCase As Integer

    On Error GoTo ErrHandler

    If Trim(configPath) = "" Then
        configPath = Application.GetOpenFilename("Excel Files (*.xlsx; *.xlsm; *.xls),*.xlsx;*.xlsm;*.xls", , "Select CONFIG file")
        If configPath = "False" Then Exit Sub
    End If
    If Trim(exportPath) = "" Then
        exportPath = Application.GetOpenFilename("Excel Files (*.xlsx; *.xlsm; *.xls),*.xlsx;*.xlsm;*.xls", , "Select EXPORTS file")
        If exportPath = "False" Then Exit Sub
    End If

    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.DisplayAlerts = False

    Set wbConfig = Workbooks.Open(Filename:=configPath, ReadOnly:=True, IgnoreReadOnlyRecommended:=True)
    Set wbExport = Workbooks.Open(Filename:=exportPath, ReadOnly:=True, IgnoreReadOnlyRecommended:=True)
    Set wsEQTabs = ThisWorkbook.Sheets("EQ Tabs")

    r = 2
    Do While Not (Trim(wsEQTabs.Cells(r, 1).Value) = "" And Trim(wsEQTabs.Cells(r, 2).Value) = "")

        exportSheetName = Trim(wsEQTabs.Cells(r, 1).Value)
        configSheetName = Trim(wsEQTabs.Cells(r, 2).Value)
        yesNo = Trim(wsEQTabs.Cells(r, 3).Value)

        cfgRows = 0: expRows = 0: copiedRows = 0

        If exportSheetName = "" Or configSheetName = "" Then
            '-- Either cell blank
            WriteResult wsEQTabs, r, "Invalide Sheet name config/export", "red", 0, 0, 0

        Else
            '-- STEP 1: does this sheet exist in Config, and does its name match a valid EQ pattern?
            Set wsConfig = Nothing
            On Error Resume Next
            Set wsConfig = wbConfig.Sheets(configSheetName)
            On Error GoTo ErrHandler

            matchedCase = GetCaseType(configSheetName)

            If wsConfig Is Nothing Or matchedCase = 0 Then
                WriteResult wsEQTabs, r, "Not a Valid EQ sheet in Config", "red", 0, 0, 0

            Else
                '-- STEP 2: does this sheet exist in Export?
                Set wsExport = Nothing
                On Error Resume Next
                Set wsExport = wbExport.Sheets(exportSheetName)
                On Error GoTo ErrHandler

                If wsExport Is Nothing Then
                    WriteResult wsEQTabs, r, "Sheet on found in Export", "red", 0, 0, 0

                ElseIf LCase(yesNo) <> "yes" Then
                    WriteResult wsEQTabs, r, "Skipped (flag = '" & yesNo & "')", "none", 0, 0, 0

                Else
                    '-- STEP 3: proceed with the matched case
                    success = False
                    statusMsg = ""

                    Select Case matchedCase
                        Case 1
                            success = ProcessCase1(wsExport, wsConfig, statusMsg, cfgRows, expRows, copiedRows)
                        Case 2
                            success = ProcessCase2(wsExport, wsConfig, statusMsg, cfgRows, expRows, copiedRows)
                        Case 3
                            success = ProcessCase3(wsExport, wsConfig, statusMsg, cfgRows, expRows, copiedRows)
                        Case 4
                            success = ProcessCase4(wsExport, wsConfig, statusMsg, cfgRows, expRows, copiedRows)
                        Case 5
                            success = ProcessCase5(wsExport, wsConfig, statusMsg, cfgRows, expRows, copiedRows)
                    End Select

                    If success Then
                        WriteResult wsEQTabs, r, "Validated", "green", cfgRows, expRows, copiedRows
                    Else
                        WriteResult wsEQTabs, r, statusMsg, "red", cfgRows, expRows, copiedRows
                    End If
                End If
            End If
        End If

        r = r + 1
    Loop

    newConfigPath = BuildSaveAsPath(configPath)
    wbConfig.SaveAs Filename:=newConfigPath, FileFormat:=wbConfig.FileFormat
    wbConfig.Close SaveChanges:=False

    wbExport.Close SaveChanges:=False

    Application.DisplayAlerts = True
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True

    MsgBox "Processing complete." & vbCrLf & "Saved as: " & newConfigPath, vbInformation
    Exit Sub

ErrHandler:
    Application.DisplayAlerts = True
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    MsgBox "Unexpected error: " & Err.Description, vbCritical
End Sub

'====================================================================
' Returns which case (1-5) a config sheet name matches, or 0 if none
'====================================================================
Private Function GetCaseType(configSheetName As String) As Integer
    Select Case True
        Case configSheetName Like "R_O_EQCov*", configSheetName Like "R_O_EQIncrCov*"
            GetCaseType = 1
        Case configSheetName Like "R_O_EQDed*"
            GetCaseType = 2
        Case configSheetName Like "R_O_EQYearBuilt*"
            GetCaseType = 3
        Case configSheetName Like "R_O_LossAssessmentEQ*"
            GetCaseType = 4
        Case configSheetName Like "R_O_EQExpense*"
            GetCaseType = 5
        Case Else
            GetCaseType = 0
    End Select
End Function

'====================================================================
' CASE 1: R_O_EQCovA/B/C/D , R_O_EQIncrCovA/B/C/D
' Export: County Code | Earthquake Construction Type | Rate per $1000
' Config: County | County Code | EQ Construction Type | Rate
'====================================================================
Private Function ProcessCase1(wsExport As Worksheet, wsConfig As Worksheet, ByRef statusMsg As String, _
    ByRef cfgRows As Long, ByRef expRows As Long, ByRef copiedRows As Long) As Boolean
    On Error GoTo EH

    Dim expNames(1 To 3) As String, cfgNames(1 To 4) As String
    expNames(1) = "County Code": expNames(2) = "Earthquake Construction Type": expNames(3) = "Rate per $1000"
    cfgNames(1) = "County": cfgNames(2) = "County Code": cfgNames(3) = "EQ Construction Type": cfgNames(4) = "Rate"

    Dim expHeaderRow As Long, cfgHeaderRow As Long
    expHeaderRow = FindHeaderRow(wsExport, expNames)
    cfgHeaderRow = FindHeaderRow(wsConfig, cfgNames)

    Dim eCC As Long, eCT As Long, eRate As Long
    Dim cCC As Long, cCT As Long, cRate As Long
    eCC = FindColumn(wsExport, expHeaderRow, "County Code")
    eCT = FindColumn(wsExport, expHeaderRow, "Earthquake Construction Type")
    eRate = FindColumn(wsExport, expHeaderRow, "Rate per $1000")
    cCC = FindColumn(wsConfig, cfgHeaderRow, "County Code")
    cCT = FindColumn(wsConfig, cfgHeaderRow, "EQ Construction Type")
    cRate = FindColumn(wsConfig, cfgHeaderRow, "Rate")

    If eCC = 0 Or eCT = 0 Or eRate = 0 Or cCC = 0 Or cCT = 0 Or cRate = 0 Then
        statusMsg = "Columns not found"
        ProcessCase1 = False
        Exit Function
    End If

    Dim dict As Object: Set dict = CreateObject("Scripting.Dictionary")
    Dim lastRowE As Long, r As Long, key As String
    lastRowE = wsExport.Cells(wsExport.Rows.Count, eCC).End(xlUp).Row
    For r = expHeaderRow + 1 To lastRowE
        If Trim(wsExport.Cells(r, eCC).Value) <> "" Then
            expRows = expRows + 1
            key = NormalizeKeyValue(wsExport.Cells(r, eCC).Value, "text") & "||" & _
                  NormalizeKeyValue(wsExport.Cells(r, eCT).Value, "text")
            dict(key) = wsExport.Cells(r, eRate).Value
        End If
    Next r

    Dim lastRowC As Long
    lastRowC = wsConfig.Cells(wsConfig.Rows.Count, cCC).End(xlUp).Row
    For r = cfgHeaderRow + 1 To lastRowC
        If Trim(wsConfig.Cells(r, cCC).Value) <> "" Then
            cfgRows = cfgRows + 1
            key = NormalizeKeyValue(wsConfig.Cells(r, cCC).Value, "text") & "||" & _
                  NormalizeKeyValue(wsConfig.Cells(r, cCT).Value, "text")
            If dict.Exists(key) Then
                wsConfig.Cells(r, cRate).Value = dict(key)
                copiedRows = copiedRows + 1
            End If
        End If
    Next r

    If copiedRows = 0 Then
        statusMsg = "No matches found"
        ProcessCase1 = False
    Else
        statusMsg = "OK"
        ProcessCase1 = True
    End If
    Exit Function
EH:
    statusMsg = "Error: " & Err.Description
    ProcessCase1 = False
End Function

