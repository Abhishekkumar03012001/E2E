'====================================================================
' CASE 3: R_O_EQYearBuilt
' Export: Year Built | Retrofit Indicator | County (x2, name+code) | Construction Type | Factor
' Config: Year Built (Upper Bound) | Retrofit | County | County Code | EQ Construction Type | Rate
' Export has TWO columns headered "County" - the numeric one is County Code, the text one is County name
'====================================================================
Private Function ProcessCase3(wsExport As Worksheet, wsConfig As Worksheet, countyDict As Object, _
    ByRef statusMsg As String, ByRef copiedRows As Long) As Boolean
    On Error GoTo EH

    Dim expNames(1 To 4) As String, cfgNames(1 To 6) As String
    expNames(1) = "Year Built": expNames(2) = "Retrofit Indicator": expNames(3) = "Construction Type": expNames(4) = "Factor"
    cfgNames(1) = "Year Built (Upper Bound)": cfgNames(2) = "Retrofit": cfgNames(3) = "County"
    cfgNames(4) = "County Code": cfgNames(5) = "EQ Construction Type": cfgNames(6) = "Rate"

    Dim expHeaderRow As Long, cfgHeaderRow As Long
    expHeaderRow = FindHeaderRow(wsExport, expNames)
    cfgHeaderRow = FindHeaderRow(wsConfig, cfgNames)

    Dim eYB As Long, eRetro As Long, eCT As Long, eFactor As Long
    Dim eCountyName As Long, eCountyCode As Long
    eYB = FindColumn(wsExport, expHeaderRow, "Year Built")
    eRetro = FindColumn(wsExport, expHeaderRow, "Retrofit Indicator")
    eCT = FindColumn(wsExport, expHeaderRow, "Construction Type")
    eFactor = FindColumn(wsExport, expHeaderRow, "Factor")
    FindCountyColumns wsExport, expHeaderRow, eCountyName, eCountyCode

    Dim cYB As Long, cRetro As Long, cCountyName As Long, cCountyCode As Long, cCT As Long, cRate As Long
    cYB = FindColumn(wsConfig, cfgHeaderRow, "Year Built (Upper Bound)")
    cRetro = FindColumn(wsConfig, cfgHeaderRow, "Retrofit")
    cCountyName = FindColumn(wsConfig, cfgHeaderRow, "County")
    cCountyCode = FindColumn(wsConfig, cfgHeaderRow, "County Code")
    cCT = FindColumn(wsConfig, cfgHeaderRow, "EQ Construction Type")
    cRate = FindColumn(wsConfig, cfgHeaderRow, "Rate")

    If eYB = 0 Or eRetro = 0 Or eCT = 0 Or eFactor = 0 Or eCountyCode = 0 Or _
       cYB = 0 Or cRetro = 0 Or cCountyName = 0 Or cCountyCode = 0 Or cCT = 0 Or cRate = 0 Then
        statusMsg = "Columns not found"
        ProcessCase3 = False
        Exit Function
    End If

    Dim outputRows As Collection: Set outputRows = New Collection
    Dim lastRowE As Long, r As Long, rowDict As Object, countyNameVal As String
    lastRowE = wsExport.Cells(wsExport.Rows.Count, eCountyCode).End(xlUp).Row
    For r = expHeaderRow + 1 To lastRowE
        If Trim(wsExport.Cells(r, eCountyCode).Value) <> "" Then
            Set rowDict = CreateObject("Scripting.Dictionary")
            If eCountyName > 0 Then
                countyNameVal = wsExport.Cells(r, eCountyName).Value
            Else
                countyNameVal = LookupCounty(countyDict, wsExport.Cells(r, eCountyCode).Value)
            End If
            rowDict.Add cYB, wsExport.Cells(r, eYB).Value
            rowDict.Add cRetro, MapRetrofit(wsExport.Cells(r, eRetro).Value)
            rowDict.Add cCountyName, countyNameVal
            rowDict.Add cCountyCode, wsExport.Cells(r, eCountyCode).Value
            rowDict.Add cCT, wsExport.Cells(r, eCT).Value
            rowDict.Add cRate, wsExport.Cells(r, eFactor).Value
            outputRows.Add rowDict
        End If
    Next r

    copiedRows = outputRows.Count
    If copiedRows = 0 Then
        statusMsg = "No data rows found in export"
        ProcessCase3 = False
        Exit Function
    End If

    Dim colIdx(0 To 5) As Long
    colIdx(0) = cYB: colIdx(1) = cRetro: colIdx(2) = cCountyName: colIdx(3) = cCountyCode
    colIdx(4) = cCT: colIdx(5) = cRate
    WriteRowsToConfig wsConfig, cfgHeaderRow, colIdx, outputRows

    statusMsg = "OK"
    ProcessCase3 = True
    Exit Function
EH:
    statusMsg = "Error: " & Err.Description
    ProcessCase3 = False
End Function

