'====================================================================
' CASE 5: R_O_EQExpense
' Config's single "Rate" value gets replaced by export's "Expense Load" value
'====================================================================
Private Function ProcessCase5(wsExport As Worksheet, wsConfig As Worksheet, ByRef msg As String) As Boolean
    On Error GoTo EH

    Dim expNames(1 To 1) As String, cfgNames(1 To 1) As String
    expNames(1) = "Expense Load"
    cfgNames(1) = "Rate"

    Dim expHeaderRow As Long, cfgHeaderRow As Long
    expHeaderRow = FindHeaderRow(wsExport, expNames)
    cfgHeaderRow = FindHeaderRow(wsConfig, cfgNames)

    Dim eExpense As Long, cRate As Long
    eExpense = FindColumn(wsExport, expHeaderRow, "Expense Load")
    cRate = FindColumn(wsConfig, cfgHeaderRow, "Rate")

    If eExpense = 0 Or cRate = 0 Then
        msg = "Required columns not found (Expense Load / Rate)"
        ProcessCase5 = False
        Exit Function
    End If

    Dim expVal As Variant
    expVal = wsExport.Cells(expHeaderRow + 1, eExpense).Value
    If Trim(CStr(expVal)) = "" Then
        msg = "Expense Load value is blank in export"
        ProcessCase5 = False
        Exit Function
    End If

    Dim lastRowC As Long, r As Long, cnt As Long
    lastRowC = wsConfig.Cells(wsConfig.Rows.Count, cRate).End(xlUp).Row
    cnt = 0
    For r = cfgHeaderRow + 1 To lastRowC
        If Trim(wsConfig.Cells(r, cRate).Value) <> "" Then
            wsConfig.Cells(r, cRate).Value = expVal
            cnt = cnt + 1
        End If
    Next r

    If cnt = 0 Then
        msg = "No existing value found to replace in Rate column"
        ProcessCase5 = False
    Else
        msg = "Copied successfully (Expense Load applied to " & cnt & " row(s))"
        ProcessCase5 = True
    End If
    Exit Function
EH:
    msg = "Error: " & Err.Description
    ProcessCase5 = False
End Function

'====================================================================
' HELPER FUNCTIONS
'====================================================================

' Finds the best header row (1 to 4) for a sheet given a list of expected header names
Private Function FindHeaderRow(ws As Worksheet, targetNames() As String) As Long
    Dim r As Long, bestRow As Long, bestMatches As Long, matches As Long, i As Long
    bestMatches = -1
    bestRow = 1
    For r = 1 To 4
        matches = 0
        For i = LBound(targetNames) To UBound(targetNames)
            If FindColumn(ws, r, targetNames(i)) > 0 Then matches = matches + 1
        Next i
        If matches > bestMatches Then
            bestMatches = matches
            bestRow = r
        End If
    Next r
    FindHeaderRow = bestRow
End Function

' Finds the column number in a given header row whose text best matches targetName
Private Function FindColumn(ws As Worksheet, headerRow As Long, targetName As String) As Long
    Dim lastCol As Long, c As Long, bestCol As Long, bestScore As Long, score As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    If lastCol < 1 Then lastCol = 1
    bestScore = 0: bestCol = 0
    For c = 1 To lastCol
        score = HeaderSimilarity(CStr(ws.Cells(headerRow, c).Value), targetName)
        If score > bestScore Then
            bestScore = score
            bestCol = c
        End If
    Next c
    If bestScore >= 40 Then
        FindColumn = bestCol
    Else
        FindColumn = 0
    End If
End Function

' Strips spaces/punctuation and lowercases a header string for comparison
Private Function NormalizeHeader(s As String) As String
    Dim i As Long, c As String, res As String
    s = LCase(Trim(s))
    For i = 1 To Len(s)
        c = Mid(s, i, 1)
        If c Like "[a-z0-9]" Then res = res & c
    Next i
    NormalizeHeader = res
End Function

' Returns a similarity score (0-100) between two header strings
Private Function HeaderSimilarity(a As String, b As String) As Long
    Dim na As String, nb As String
    na = NormalizeHeader(a): nb = NormalizeHeader(b)
    If na = "" Or nb = "" Then
        HeaderSimilarity = 0
        Exit Function
    End If
    If na = nb Then
        HeaderSimilarity = 100
        Exit Function
    End If
    If InStr(na, nb) > 0 Or InStr(nb, na) > 0 Then
        HeaderSimilarity = 80
        Exit Function
    End If

    Dim tokensA() As String, tokensB() As String
    Dim i As Long, j As Long, matchCount As Long
    tokensA = Split(LCase(Trim(a)), " ")
    tokensB = Split(LCase(Trim(b)), " ")
    matchCount = 0
    For i = LBound(tokensA) To UBound(tokensA)
        For j = LBound(tokensB) To UBound(tokensB)
            If tokensA(i) <> "" And tokensA(i) = tokensB(j) Then matchCount = matchCount + 1
        Next j
    Next i
    If matchCount > 0 Then
        HeaderSimilarity = 50 + (matchCount * 10)
    Else
        HeaderSimilarity = 0
    End If
End Function

' Normalizes a cell value for key comparison.
' fieldType: "text" (default/general), "percent" (strips trailing %), "yn" (Yes/No -> Y/N)
Private Function NormalizeKeyValue(v As Variant, fieldType As String) As String
    Dim s As String
    s = Trim(CStr(v))

    Select Case LCase(fieldType)
        Case "percent"
            If Right(s, 1) = "%" Then s = Left(s, Len(s) - 1)
            If IsNumeric(s) Then
                NormalizeKeyValue = CStr(CDbl(s))
            Else
                NormalizeKeyValue = LCase(s)
            End If

        Case "yn"
            Select Case LCase(s)
                Case "yes", "y": NormalizeKeyValue = "Y"
                Case "no", "n": NormalizeKeyValue = "N"
                Case Else: NormalizeKeyValue = UCase(s)
            End Select

        Case Else
            If IsNumeric(s) Then
                NormalizeKeyValue = CStr(CDbl(s))
            Else
                NormalizeKeyValue = LCase(s)
            End If
    End Select
End Function

' Writes a message + background color into Column D of the EQ Tabs sheet
Private Sub WriteComment(ws As Worksheet, r As Long, msg As String, colorType As String)
    ws.Cells(r, 4).Value = msg
    Select Case LCase(colorType)
        Case "red"
            ws.Cells(r, 4).Interior.Color = RGB(255, 199, 206)   ' light red
        Case "yellow"
            ws.Cells(r, 4).Interior.Color = RGB(255, 235, 156)   ' light yellow
        Case "green"
            ws.Cells(r, 4).Interior.Color = RGB(198, 239, 206)   ' light green
        Case Else
            ws.Cells(r, 4).Interior.ColorIndex = xlNone
    End Select
End Sub
' Builds a new file path: same folder, filename + "_updated_EQ", same extension
Private Function BuildSaveAsPath(originalPath As String) As String
    Dim folderPath As String, fileName As String, fileExt As String, baseName As String
    Dim dotPos As Long, slashPos As Long

    slashPos = InStrRev(originalPath, "\")
    folderPath = Left(originalPath, slashPos)
    fileName = Mid(originalPath, slashPos + 1)

    dotPos = InStrRev(fileName, ".")
    If dotPos > 0 Then
        baseName = Left(fileName, dotPos - 1)
        fileExt = Mid(fileName, dotPos) ' includes the dot, e.g. ".xlsx"
    Else
        baseName = fileName
        fileExt = ""
    End If

    BuildSaveAsPath = folderPath & baseName & "_updated_EQ" & fileExt
End Function
