Option Explicit

' Module-level variable holding the path to the updated config file
' Available to all 4 options
Private strUpdatedConfigPath As String

'---------------------------------------------------
' INITIALIZE
'---------------------------------------------------
Private Sub UserForm_Initialize()

    ' Force each OptionButton into its own group so they act independently
    ' (this is what lets you select any combination of them)
    Option1.GroupName = "Grp1"
    Option2.GroupName = "Grp2"
    Option3.GroupName = "Grp3"
    Option4.GroupName = "Grp4"

    btnRUN.Enabled = False

End Sub

