Dim cellValue As Variant

cellValue = ThisWorkbook.Worksheets("MasterList").Cells(i + 2, "E").Value

If IsError(cellValue) Then
    MsgBox "Error in MasterList cell E" & i + 2, vbCritical
    Exit Sub
End If

a = Trim$(CStr(cellValue))

If a = "" Then
    MsgBox "Blank sheet name in MasterList cell E" & i + 2, vbCritical
    Exit Sub
End If

Set sh = Nothing

On Error Resume Next
Set sh = ThisWorkbook.Worksheets(a)
On Error GoTo 0

If sh Is Nothing Then
    MsgBox "Worksheet not found: " & a & vbCrLf & _
           "MasterList cell: E" & i + 2, vbCritical
    Exit Sub
End If

sh.Activate
