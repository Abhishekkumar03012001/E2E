Dim ws As Worksheet
Dim masterWs As Worksheet
Dim cellValue As Variant

Set masterWs = ThisWorkbook.Worksheets("MasterList")

For Each ws In ThisWorkbook.Worksheets

    cellValue = masterWs.Cells(p, 5).Value

    If Not IsError(cellValue) Then

        If Len(Trim$(CStr(cellValue))) > 0 Then

            ws.Name = CStr(cellValue)
            p = p + 1

        End If

    Else

        Debug.Print "Error in MasterList!E" & p

    End If

Next ws
