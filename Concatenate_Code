import fitz  # PyMuPDF
from openpyxl import load_workbook
from openpyxl.styles import PatternFill, Font

# =====================================================
# INPUT FILES
# =====================================================
excel_file = r"input.xlsx"
pdf_file = r"input.pdf"
output_excel = r"Output.xlsx"

sheet_name = "Inputs"

# =====================================================
# OPEN PDF
# =====================================================
doc = fitz.open(pdf_file)
total_pages = len(doc)

# Store text of every page
page_texts = []
for page in doc:
    text = page.get_text("text")
    page_texts.append(text.lower())

# =====================================================
# OPEN EXCEL
# =====================================================
wb = load_workbook(excel_file)
ws = wb[sheet_name]

# =====================================================
# HEADER FORMATTING
# =====================================================
header_fill = PatternFill(fill_type="solid", start_color="00005A", end_color="00005A")
header_font = Font(color="FFFFFF", bold=True)

green_fill = PatternFill(fill_type="solid", start_color="92D050", end_color="92D050")
yellow_fill = PatternFill(fill_type="solid", start_color="FFD966", end_color="FFD966")
red_fill = PatternFill(fill_type="solid", start_color="FF6666", end_color="FF6666")

# Ensure headers exist
ws["A1"] = "Inputs"
ws["B1"] = "Pages"
ws["C1"] = "Status"

for cell in ws[1]:
    cell.fill = header_fill
    cell.font = header_font

# =====================================================
# SEARCH VALUES
# =====================================================
row = 2

while True:
    value = ws[f"A{row}"].value

    if value is None:
        break

    search_text = str(value).strip().lower()

    found_pages = []

    for i, page_text in enumerate(page_texts, start=1):
        if search_text in page_text:
            found_pages.append(i)

    # -------------------------------
    # Write Results
    # -------------------------------
    if len(found_pages) == 0:
        ws[f"B{row}"] = "NA"
        ws[f"C{row}"] = "Not Found"
        ws[f"C{row}"].fill = red_fill

    elif len(found_pages) == total_pages:
        ws[f"B{row}"] = ", ".join(map(str, found_pages))
        ws[f"C{row}"] = "Found in all pages"
        ws[f"C{row}"].fill = green_fill

    else:
        ws[f"B{row}"] = ", ".join(map(str, found_pages))
        ws[f"C{row}"] = "Found in some pages"
        ws[f"C{row}"].fill = yellow_fill

    row += 1

# =====================================================
# AUTO WIDTH
# =====================================================
for column in ws.columns:
    max_length = 0
    column_letter = column[0].column_letter

    for cell in column:
        try:
            if cell.value:
                max_length = max(max_length, len(str(cell.value)))
        except:
            pass

    ws.column_dimensions[column_letter].width = max_length + 3

# =====================================================
# SAVE
# =====================================================
wb.save(output_excel)
doc.close()

print("Done!")
print(f"Output saved as: {output_excel}")
