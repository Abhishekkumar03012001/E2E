"""
extract_headers_footers.py

Extracts the header and footer text from up to 3 PDFs (page by page) and
writes them into an Excel workbook:

    Column A = PDF 1 headers   Column B = PDF 1 footers
    Column C = PDF 2 headers   Column D = PDF 2 footers
    Column E = PDF 3 headers   Column F = PDF 3 footers

Row 2 = page 1 of each pdf, Row 3 = page 2, and so on.

It also detects which of the 3 known formats a PDF is in, based on the
header text of its first page, and prints that to the console (this is
informational — it does not change how text is extracted):

    Case 1: header contains "Rating Manual"
    Case 2: header contains "Rate Order Calculation"
    Case 3: header contains "Rule Manual"

HOW HEADER/FOOTER IS DETECTED
------------------------------
Since a PDF has no built-in "this is the header" tag, this script grabs the
text sitting in the TOP band and BOTTOM band of every page (by page
percentage, not fixed points, so it works across differently-sized pages).

You can tune HEADER_BAND_PCT / FOOTER_BAND_PCT below if your headers/footers
are taller or shorter than the default guess.

USAGE
-----
    python extract_headers_footers.py pdf1.pdf [pdf2.pdf] [pdf3.pdf] \
        --output output.xlsx

    # or just edit the DEFAULT_PDF_PATHS list below and run with no args.
"""

import argparse
import sys
from pathlib import Path

import pdfplumber
from openpyxl import Workbook
from openpyxl.styles import Font
from openpyxl.utils import get_column_letter

# ----------------------------------------------------------------------
# CONFIG — tune these if headers/footers are being over/under captured
# ----------------------------------------------------------------------

# Fraction of page height (from the top) considered the "header" band.
HEADER_BAND_PCT = 0.15

# Fraction of page height (from the bottom) considered the "footer" band.
FOOTER_BAND_PCT = 0.10

# If you'd rather hardcode paths instead of passing them as CLI args,
# fill these in and just run: python extract_headers_footers.py
DEFAULT_PDF_PATHS = []

CASE_KEYWORDS = {
    "Case 1 (Rating Manual)": "rating manual",
    "Case 2 (Rate Order Calculation)": "rate order calculation",
    "Case 3 (Rule Manual)": "rule manual",
}


def detect_case(header_text: str) -> str:
    """Identify which of the 3 known header formats this is, based on
    keywords found anywhere in the header text (case-insensitive)."""
    lowered = header_text.lower()
    for case_name, keyword in CASE_KEYWORDS.items():
        if keyword in lowered:
            return case_name
    return "Unknown format"


def extract_header_footer(pdf_path: str):
    """
    Returns a list of (header_text, footer_text) tuples, one per page.
    """
    results = []
    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            width = page.width
            height = page.height

            header_bbox = (0, 0, width, height * HEADER_BAND_PCT)
            footer_bbox = (0, height * (1 - FOOTER_BAND_PCT), width, height)

            header_crop = page.crop(header_bbox)
            footer_crop = page.crop(footer_bbox)

            header_text = (header_crop.extract_text() or "").strip()
            footer_text = (footer_crop.extract_text() or "").strip()

            results.append((header_text, footer_text))
    return results


def build_excel(all_pdfs_data, output_path: str):
    """
    all_pdfs_data: list of lists of (header, footer) tuples, one list per pdf
    (in the order pdf1, pdf2, pdf3).
    """
    wb = Workbook()
    ws = wb.active
    ws.title = "Headers and Footers"

    bold = Font(bold=True)

    # Header row (row 1): PDF1 Header, PDF1 Footer, PDF2 Header, PDF2 Footer, ...
    for pdf_index in range(len(all_pdfs_data)):
        header_col = pdf_index * 2 + 1       # A, C, E ...
        footer_col = header_col + 1          # B, D, F ...
        ws.cell(row=1, column=header_col, value=f"PDF{pdf_index + 1} Header").font = bold
        ws.cell(row=1, column=footer_col, value=f"PDF{pdf_index + 1} Footer").font = bold

    # Figure out the max number of pages across all pdfs so every column
    # gets a row even if one pdf is shorter than the others.
    max_pages = max((len(pdf_data) for pdf_data in all_pdfs_data), default=0)

    for page_idx in range(max_pages):
        row = page_idx + 2  # row 2 = page 1, row 3 = page 2, ...
        for pdf_index, pdf_data in enumerate(all_pdfs_data):
            header_col = pdf_index * 2 + 1
            footer_col = header_col + 1
            if page_idx < len(pdf_data):
                header_text, footer_text = pdf_data[page_idx]
            else:
                header_text, footer_text = "", ""
            ws.cell(row=row, column=header_col, value=header_text)
            ws.cell(row=row, column=footer_col, value=footer_text)

    # Reasonable column widths + wrap text so multi-line headers/footers
    # are readable instead of one giant unreadable line.
    from openpyxl.styles import Alignment
    for col_idx in range(1, len(all_pdfs_data) * 2 + 1):
        col_letter = get_column_letter(col_idx)
        ws.column_dimensions[col_letter].width = 45
    for row in ws.iter_rows(min_row=2, max_row=max_pages + 1):
        for cell in row:
            cell.alignment = Alignment(wrap_text=True, vertical="top")

    wb.save(output_path)


def main():
    parser = argparse.ArgumentParser(
        description="Extract PDF headers/footers (up to 3 PDFs) into an Excel file."
    )
    parser.add_argument(
        "pdfs",
        nargs="*",
        default=DEFAULT_PDF_PATHS,
        help="Path(s) to 1, 2, or 3 PDF files.",
    )
    parser.add_argument(
        "--output",
        "-o",
        default="headers_footers_output.xlsx",
        help="Path to the output Excel file (default: headers_footers_output.xlsx)",
    )
    args = parser.parse_args()

    pdf_paths = args.pdfs
    if not pdf_paths:
        print("No PDF paths given. Pass 1-3 pdf paths as arguments, e.g.:")
        print("  python extract_headers_footers.py pdf1.pdf pdf2.pdf pdf3.pdf")
        sys.exit(1)
    if len(pdf_paths) > 3:
        print("This script supports a maximum of 3 PDFs at a time.")
        sys.exit(1)

    all_pdfs_data = []
    for i, pdf_path in enumerate(pdf_paths, start=1):
        path = Path(pdf_path)
        if not path.exists():
            print(f"ERROR: file not found: {pdf_path}")
            sys.exit(1)

        print(f"\nProcessing PDF {i}: {pdf_path}")
        page_data = extract_header_footer(str(path))
        all_pdfs_data.append(page_data)

        # Report detected case using the first page's header
        if page_data:
            case = detect_case(page_data[0][0])
            print(f"  Detected format: {case}")
            print(f"  Pages processed: {len(page_data)}")
        else:
            print("  WARNING: no pages found in this PDF.")

    build_excel(all_pdfs_data, args.output)
    print(f"\nDone. Excel file written to: {args.output}")


if __name__ == "__main__":
    main()
