"""
extract_headers_footers.py

Extracts the header and footer text from EVERY PDF found in a folder
(page by page) and writes them into an Excel workbook:

    Column A = PDF 1 headers   Column B = PDF 1 footers
    Column C = PDF 2 headers   Column D = PDF 2 footers
    Column E = PDF 3 headers   Column F = PDF 3 footers
    ... and so on for however many PDFs are in the folder.

Row 2 = page 1 of each pdf, Row 3 = page 2, and so on.

HOW HEADER/FOOTER IS DETECTED (line-count based, not position-based)
---------------------------------------------------------------------
Each PDF is first classified into one of 3 known formats, based on keywords
found on its first page:

    Case 1: "Rating Manual"            -> header = first 4 lines of the page
                                           footer = last line of the page
    Case 2: "Rate Order Calculation"   -> header = first 2 lines of the page
                                           footer = (none - this format has no footer)
    Case 3: "Rule Manual"              -> header = first 3 lines of the page
                                           footer = last line of the page

The case is detected ONCE per pdf (from page 1) and then applied to every
page in that pdf, since the format is consistent throughout a document.

If a PDF doesn't match any of the 3 known keywords, it falls back to
DEFAULT_HEADER_LINES / DEFAULT_HAS_FOOTER (edit below if needed).

HOW TO USE
----------
1. Set FOLDER_PATH below to the folder containing your PDFs.
2. (Optional) Set OUTPUT_PATH to where you want the Excel file saved.
3. Run:  python extract_headers_footers.py

The script picks up every ".pdf" file in FOLDER_PATH (sorted alphabetically)
as PDF1, PDF2, PDF3, ... — there is no limit on how many.
"""

import sys
from pathlib import Path

import pdfplumber
from openpyxl import Workbook
from openpyxl.styles import Font, Alignment
from openpyxl.utils import get_column_letter

# ----------------------------------------------------------------------
# SET THIS: folder containing your PDFs. Every .pdf file inside it will
# be processed, in alphabetical order, as PDF1, PDF2, PDF3, ...
# ----------------------------------------------------------------------
FOLDER_PATH = r"/path/to/your/pdf/folder"

# Where to save the resulting Excel file.
OUTPUT_PATH = r"headers_footers_output.xlsx"

# ----------------------------------------------------------------------
# CASE CONFIG — exact line counts per known format.
# keyword: searched (case-insensitive) anywhere in the first few lines of
# page 1 to classify the pdf.
# header_lines: how many lines from the TOP of each page make up the header.
# has_footer: whether the LAST line of each page should be captured as footer.
# ----------------------------------------------------------------------
CASE_CONFIG = [
    {
        "name": "Case 1 (Rating Manual)",
        "keyword": "rating manual",
        "header_lines": 4,
        "has_footer": True,
    },
    {
        "name": "Case 2 (Rate Order Calculation)",
        "keyword": "rate order calculation",
        "header_lines": 2,
        "has_footer": False,
    },
    {
        "name": "Case 3 (Rule Manual)",
        "keyword": "rule manual",
        "header_lines": 3,
        "has_footer": True,
    },
]

# Used only if a pdf doesn't match any of the 3 known keywords above.
DEFAULT_HEADER_LINES = 4
DEFAULT_HAS_FOOTER = True

# How many of the first lines on page 1 to scan when detecting the case
# (keep this >= the largest header_lines above, with a little buffer).
CASE_DETECTION_SCAN_LINES = 6


def detect_case(first_page_text: str):
    """
    Look at the first few lines of page 1 and match against known keywords.
    Returns the matching config dict, or a default config if no match.
    """
    lines = [l.strip() for l in first_page_text.split("\n") if l.strip()]
    scan_text = " ".join(lines[:CASE_DETECTION_SCAN_LINES]).lower()

    for config in CASE_CONFIG:
        if config["keyword"] in scan_text:
            return config

    return {
        "name": "Unknown format (using defaults)",
        "keyword": None,
        "header_lines": DEFAULT_HEADER_LINES,
        "has_footer": DEFAULT_HAS_FOOTER,
    }


def extract_header_footer(pdf_path: str):
    """
    Returns (case_name, list of (header_text, footer_text) tuples - one per page).
    """
    results = []
    case_config = None

    with pdfplumber.open(pdf_path) as pdf:
        if not pdf.pages:
            return "No pages found", results

        # Detect case using page 1 only.
        first_page_text = pdf.pages[0].extract_text() or ""
        case_config = detect_case(first_page_text)

        header_lines = case_config["header_lines"]
        has_footer = case_config["has_footer"]

        for page in pdf.pages:
            text = page.extract_text() or ""
            # Keep only non-empty lines so blank lines don't throw off counts.
            lines = [l.strip() for l in text.split("\n") if l.strip()]

            header_text = "\n".join(lines[:header_lines])

            if has_footer and len(lines) > header_lines:
                footer_text = lines[-1]
            else:
                footer_text = ""

            results.append((header_text, footer_text))

    return case_config["name"], results


def get_pdf_files(folder_path: str):
    """Return every .pdf file in folder_path, sorted alphabetically."""
    folder = Path(folder_path)
    if not folder.exists() or not folder.is_dir():
        print(f"ERROR: folder not found: {folder_path}")
        sys.exit(1)

    pdf_files = sorted(folder.glob("*.pdf"))
    if not pdf_files:
        print(f"ERROR: no .pdf files found in: {folder_path}")
        sys.exit(1)

    return pdf_files


def build_excel(all_pdfs_data, pdf_names, output_path: str):
    """
    all_pdfs_data: list of lists of (header, footer) tuples, one list per pdf
    pdf_names: list of filenames, same order as all_pdfs_data
    """
    wb = Workbook()
    ws = wb.active
    ws.title = "Headers and Footers"

    bold = Font(bold=True)

    for pdf_index, pdf_name in enumerate(pdf_names):
        header_col = pdf_index * 2 + 1       # A, C, E ...
        footer_col = header_col + 1          # B, D, F ...
        ws.cell(row=1, column=header_col, value=f"PDF{pdf_index + 1} Header ({pdf_name})").font = bold
        ws.cell(row=1, column=footer_col, value=f"PDF{pdf_index + 1} Footer ({pdf_name})").font = bold

    max_pages = max((len(pdf_data) for pdf_data in all_pdfs_data), default=0)

    for page_idx in range(max_pages):
        row = page_idx + 2  # row 2 = page 1, row 3 = page 2, ...
        for pdf_index, pdf_data in enumerate(all_pdfs_data):
            header_col = pdf_index * 2 + 1
            footer_col = header_col + 1
            if page_idx < len(pdf_data):
                header_text, footer_text = pdf_data[page_idx]
            else:
                header_text, footer_text = "", ""
            ws.cell(row=row, column=header_col, value=header_text)
            ws.cell(row=row, column=footer_col, value=footer_text)

    total_cols = len(all_pdfs_data) * 2
    for col_idx in range(1, total_cols + 1):
        col_letter = get_column_letter(col_idx)
        ws.column_dimensions[col_letter].width = 45
    for row in ws.iter_rows(min_row=2, max_row=max_pages + 1):
        for cell in row:
            cell.alignment = Alignment(wrap_text=True, vertical="top")

    wb.save(output_path)


def main():
    pdf_files = get_pdf_files(FOLDER_PATH)
    print(f"Found {len(pdf_files)} PDF(s) in {FOLDER_PATH}:")
    for f in pdf_files:
        print(f"  - {f.name}")

    all_pdfs_data = []
    pdf_names = []

    for i, pdf_path in enumerate(pdf_files, start=1):
        print(f"\nProcessing PDF {i}: {pdf_path.name}")
        case_name, page_data = extract_header_footer(str(pdf_path))
        all_pdfs_data.append(page_data)
        pdf_names.append(pdf_path.name)

        print(f"  Detected format: {case_name}")
        print(f"  Pages processed: {len(page_data)}")

    build_excel(all_pdfs_data, pdf_names, OUTPUT_PATH)
    print(f"\nDone. Excel file written to: {OUTPUT_PATH}")


if __name__ == "__main__":
    main()
