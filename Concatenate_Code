import fitz  # PyMuPDF
from openpyxl import load_workbook, Workbook
from openpyxl.styles import PatternFill, Font


def process_pdfs(
    excel_file,
    pdf_rating_file,
    pdf_rule_file,
    pdf_roc_file,
    output_excel,
    pages_column_width=15,
):
    """
    Search terms listed in 3 sheets of an input Excel workbook against
    3 corresponding PDF files, and write the results to a new Excel
    workbook with 3 matching tabs.

    Parameters
    ----------
    excel_file : str
        Path to the input Excel file. Must contain the sheets:
        "Input_rating", "Input_Rule", "Input_ROC".
    pdf_rating_file : str
        Path to the PDF corresponding to sheet "Input_rating".
    pdf_rule_file : str
        Path to the PDF corresponding to sheet "Input_Rule".
    pdf_roc_file : str
        Path to the PDF corresponding to sheet "Input_ROC".
    output_excel : str
        Path where the output workbook will be saved.
    pages_column_width : int, optional
        Fixed column width for the "Pages" column (default 15).
        This column will NOT autofit.

    Returns
    -------
    str
        The path to the saved output Excel file.
    """

    # Map: sheet name in input Excel -> corresponding PDF file
    sheet_pdf_map = {
        "Input_rating": pdf_rating_file,
        "Input_Rule":   pdf_rule_file,
        "Input_ROC":    pdf_roc_file,
    }

    # =====================================================
    # STYLES
    # =====================================================
    header_fill = PatternFill(fill_type="solid", start_color="00005A", end_color="00005A")
    header_font = Font(color="FFFFFF", bold=True)
    green_fill  = PatternFill(fill_type="solid", start_color="92D050", end_color="92D050")
    yellow_fill = PatternFill(fill_type="solid", start_color="FFD966", end_color="FFD966")
    red_fill    = PatternFill(fill_type="solid", start_color="FF6666", end_color="FF6666")

    # =====================================================
    # OPEN INPUT EXCEL (source of search terms)
    # =====================================================
    wb_in = load_workbook(excel_file)

    # Create a fresh output workbook
    wb_out = Workbook()
    wb_out.remove(wb_out.active)  # remove default sheet, we'll add our own named sheets

    # =====================================================
    # PROCESS EACH SHEET / PDF PAIR
    # =====================================================
    for sheet_name, pdf_file in sheet_pdf_map.items():

        if sheet_name not in wb_in.sheetnames:
            print(f"Skipping '{sheet_name}' - sheet not found in {excel_file}")
            continue

        ws_in = wb_in[sheet_name]

        # ---- Open PDF and extract text per page ----
        doc = fitz.open(pdf_file)
        total_pages = len(doc)
        page_texts = []
        for page in doc:
            text = page.get_text("text")
            page_texts.append(text.lower())
        doc.close()

        # ---- Create output sheet with same name ----
        ws_out = wb_out.create_sheet(title=sheet_name)

        # Headers
        ws_out["A1"] = "Inputs"
        ws_out["B1"] = "Pages"
        ws_out["C1"] = "Status"
        for cell in ws_out[1]:
            cell.fill = header_fill
            cell.font = header_font

        # ---- Search values from input sheet, write to output sheet ----
        in_row = 2
        out_row = 2
        while True:
            value = ws_in[f"A{in_row}"].value
            if value is None:
                break

            search_text = str(value).strip().lower()
            found_pages = []
            for i, page_text in enumerate(page_texts, start=1):
                if search_text in page_text:
                    found_pages.append(i)

            ws_out[f"A{out_row}"] = value

            if len(found_pages) == 0:
                ws_out[f"B{out_row}"] = "NA"
                ws_out[f"C{out_row}"] = "Not Found"
                ws_out[f"C{out_row}"].fill = red_fill
            elif len(found_pages) == total_pages:
                ws_out[f"B{out_row}"] = ", ".join(map(str, found_pages))
                ws_out[f"C{out_row}"] = "Found in all pages"
                ws_out[f"C{out_row}"].fill = green_fill
            else:
                ws_out[f"B{out_row}"] = ", ".join(map(str, found_pages))
                ws_out[f"C{out_row}"] = "Found in some pages"
                ws_out[f"C{out_row}"].fill = yellow_fill

            in_row += 1
            out_row += 1

        # ---- Auto width for all columns EXCEPT "Pages" (column B) ----
        for column in ws_out.columns:
            column_letter = column[0].column_letter

            if column_letter == "B":
                # Keep Pages column fixed width, don't autofit
                ws_out.column_dimensions[column_letter].width = pages_column_width
                continue

            max_length = 0
            for cell in column:
                try:
                    if cell.value:
                        max_length = max(max_length, len(str(cell.value)))
                except Exception:
                    pass
            ws_out.column_dimensions[column_letter].width = max_length + 3

        print(f"Processed sheet '{sheet_name}' against '{pdf_file}' ({total_pages} pages)")

    # =====================================================
    # SAVE
    # =====================================================
    wb_out.save(output_excel)
    print("Done!")
    print(f"Output saved as: {output_excel}")

    return output_excel


# =====================================================
# EXAMPLE: calling the function directly
# =====================================================
if __name__ == "__main__":
    process_pdfs(
        excel_file=r"input.xlsx",
        pdf_rating_file=r"rating.pdf",
        pdf_rule_file=r"rule.pdf",
        pdf_roc_file=r"roc.pdf",
        output_excel=r"Output.xlsx",
    )
