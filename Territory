Option Explicit

Sub CopyCatToConfig(ByVal configPath As String, ByVal catPath As String)

    Dim wbConfig As Workbook, wbCat As Workbook
    Dim wsCat As Worksheet, wsConfig As Worksheet
    Dim catTerrCol As Long, configTerrCol As Long
    Dim lastRowCat As Long, lastRowConfig As Long
    Dim dictTerr As Object
    Dim colNames As Variant
    Dim colName As Variant
    Dim catCol As Long, configCol As Long
    Dim i As Long, r As Long
    Dim key As String, terrVal As String, catRow As Long
    Dim isNewCol As Boolean

    On Error GoTo ErrHandler

    ' ---- Basic validation ----
    If configPath = "" Or catPath = "" Then
        MsgBox "Please select both Config and Cat file paths.", vbExclamation
        Exit Sub
    End If
    If Dir(configPath) = "" Then
        MsgBox "Config file not found: " & configPath, vbExclamation
        Exit Sub
    End If
    If Dir(catPath) = "" Then
        MsgBox "Cat file not found: " & catPath, vbExclamation
        Exit Sub
    End If

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.AskToUpdateLinks = False
    Application.Calculation = xlCalculationManual

    ' ---- Close if open in THIS Excel session ----
    CloseIfAlreadyOpen configPath
    CloseIfAlreadyOpen catPath

    ' ---- Real OS-level lock check + stale lock-file cleanup for Config ----
    If IsFileLocked(configPath) Then
        MsgBox "Config file is genuinely open/locked by another user or process and cannot be edited right now:" & vbCrLf & configPath, vbExclamation
        GoTo CleanExit
    End If
    RemoveStaleLockFile configPath

    If IsFileLocked(catPath) Then
        MsgBox "Cat file is genuinely open/locked by another user or process:" & vbCrLf & catPath, vbExclamation
        GoTo CleanExit
    End If
    RemoveStaleLockFile catPath

    ' ---- Open workbooks fresh ----
    Set wbConfig = Workbooks.Open(FileName:=configPath, UpdateLinks:=0, ReadOnly:=False, IgnoreReadOnlyRecommended:=True)
    Set wbCat = Workbooks.Open(FileName:=catPath, UpdateLinks:=0, ReadOnly:=True, IgnoreReadOnlyRecommended:=True)

    If wbConfig.ReadOnly Then
        MsgBox "Config file opened as READ-ONLY even after lock checks. It may be locked by another process/user on the network share: " & configPath, vbExclamation
        GoTo CleanExit
    End If

    ' ---- Find cat sheet: R_L_Territory -> ratingTerritory -> first sheet ----
    Set wsCat = FindSheetByName(wbCat, Array("R_L_Territory", "ratingTerritory"))

    ' ---- Config sheet: first sheet ----
    Set wsConfig = wbConfig.Worksheets(1)

    ' ---- Find Territory column in both sheets ----
    catTerrCol = FindColumn(wsCat, Array("Territory", "ratingTerritory"))
    configTerrCol = FindColumn(wsConfig, Array("Territory", "ratingTerritory"))

    If catTerrCol = 0 Or configTerrCol = 0 Then
        MsgBox "Territory column not found in one of the files.", vbExclamation
        GoTo CleanExit
    End If

    ' ---- Build lookup: territory value -> row number in cat sheet ----
    Set dictTerr = CreateObject("Scripting.Dictionary")
    dictTerr.CompareMode = vbTextCompare

    lastRowCat = wsCat.Cells(wsCat.Rows.Count, catTerrCol).End(xlUp).Row
    For i = 2 To lastRowCat
        key = Trim(LCase(CStr(wsCat.Cells(i, catTerrCol).Value)))
        If key <> "" Then
            If Not dictTerr.Exists(key) Then dictTerr.Add key, i
        End If
    Next i

    lastRowConfig = wsConfig.Cells(wsConfig.Rows.Count, configTerrCol).End(xlUp).Row

    ' ---- Columns to copy ----
    colNames = Array("Hurricane", "Reinsurance", "Capital", "WildFire", "Fixed")

    For Each colName In colNames

        catCol = FindColumn(wsCat, Array(CStr(colName)))

        If catCol = 0 Then
            ' Column missing in cat file -> skip entirely
        Else
            configCol = FindColumn(wsConfig, Array(CStr(colName)))
            isNewCol = False

            If configCol = 0 Then
                isNewCol = True
                configCol = wsConfig.Cells(1, wsConfig.Columns.Count).End(xlToLeft).Column + 1
                wsConfig.Cells(1, configCol).Value = colName
                Call ApplyFormatFromTemplate(wsConfig.Cells(1, configTerrCol), wsConfig.Cells(1, configCol))
            End If

            For r = 2 To lastRowConfig
                terrVal = Trim(LCase(CStr(wsConfig.Cells(r, configTerrCol).Value)))
                If terrVal <> "" Then
                    If dictTerr.Exists(terrVal) Then
                        catRow = dictTerr(terrVal)

                        ' Skip copying if this is the Fixed column and source value is empty
                        If LCase(CStr(colName)) = "fixed" And Trim(CStr(wsCat.Cells(catRow, catCol).Value)) = "" Then
                            ' do nothing - leave config cell as is
                        Else
                            If isNewCol Then
                                Call ApplyFormatFromTemplate(wsCat.Cells(catRow, catCol), wsConfig.Cells(r, configCol))
                            End If
                            wsConfig.Cells(r, configCol).Value2 = wsCat.Cells(catRow, catCol).Value2
                        End If

                    End If
                End If
            Next r
        End If

    Next colName

    ' ---- Save safely (with retries + verification) ----
    Call SafeSaveWorkbook(wbConfig, configPath)

    wbCat.Close SaveChanges:=False
    wbConfig.Close SaveChanges:=False

CleanExit:
    Application.Calculation = xlCalculationAutomatic
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.AskToUpdateLinks = True

    If Err.Number = 0 Then MsgBox "Done"
    Exit Sub

ErrHandler:
    MsgBox "Error: " & Err.Description, vbCritical
    On Error Resume Next
    If Not wbCat Is Nothing Then wbCat.Close SaveChanges:=False
    If Not wbConfig Is Nothing Then wbConfig.Close SaveChanges:=False
    On Error GoTo 0
    Resume CleanExit

End Sub

'========================================================
' Closes a workbook if it's already open in THIS Excel
' session, so we can get a clean copy.
'========================================================
Private Sub CloseIfAlreadyOpen(ByVal FullPath As String)
    Dim wb As Workbook
    Dim fName As String
    fName = Mid$(FullPath, InStrRev(FullPath, "\") + 1)

    On Error Resume Next
    Set wb = Workbooks(fName)
    On Error GoTo 0

    If Not wb Is Nothing Then
        Application.DisplayAlerts = False
        wb.Close SaveChanges:=False
        Set wb = Nothing
    End If
End Sub

'========================================================
' TRUE OS-level lock test. Tries to open the file for
' exclusive Read/Write access at the file-system level.
' This catches locks held by OTHER Excel processes/users
' that Application.Workbooks can't see.
'========================================================
Private Function IsFileLocked(ByVal FullPath As String) As Boolean
    Dim fnum As Integer
    IsFileLocked = False
    fnum = FreeFile
    On Error Resume Next
    Open FullPath For Binary Access Read Write Lock Read Write As #fnum
    If Err.Number <> 0 Then
        IsFileLocked = True
        Err.Clear
    Else
        Close #fnum
    End If
    On Error GoTo 0
End Function

'========================================================
' Removes a stale Excel lock/owner file (~$FileName.xlsx)
' if it exists but the real file is NOT actually locked
' (i.e. leftover from a crashed session). Safe because
' IsFileLocked already confirmed nobody really has it open.
'========================================================
Private Sub RemoveStaleLockFile(ByVal FullPath As String)
    Dim folderPath As String, fName As String, lockPath As String
    Dim slashPos As Long

    slashPos = InStrRev(FullPath, "\")
    folderPath = Left$(FullPath, slashPos)
    fName = Mid$(FullPath, slashPos + 1)
    lockPath = folderPath & "~$" & fName

    On Error Resume Next
    If Dir(lockPath, vbHidden + vbSystem) <> "" Then
        SetAttr lockPath, vbNormal
        Kill lockPath
    End If
    On Error GoTo 0
End Sub

'========================================================
' Copies formatting from a template cell to a range,
' without using the clipboard (safe for automation).
'========================================================
Private Sub ApplyFormatFromTemplate(ByVal templateCell As Range, ByVal targetRange As Range)
    With targetRange
        .NumberFormat = templateCell.NumberFormat
        .HorizontalAlignment = templateCell.HorizontalAlignment
        .VerticalAlignment = templateCell.VerticalAlignment
        .WrapText = templateCell.WrapText
        .IndentLevel = templateCell.IndentLevel
        .Font.Name = templateCell.Font.Name
        .Font.Size = templateCell.Font.Size
        .Font.Bold = templateCell.Font.Bold
        .Font.Italic = templateCell.Font.Italic
        .Font.Color = templateCell.Font.Color
        .Interior.Color = templateCell.Interior.Color
        .Interior.Pattern = templateCell.Interior.Pattern
    End With
End Sub

'========================================================
' Saves via SaveAs (more reliable than .Save on network
' shares), retries, and verifies the file's timestamp
' actually changed.
'========================================================
Private Sub SafeSaveWorkbook(ByVal wb As Workbook, ByVal FullPath As String)
    Dim attempt As Long
    Dim fileFormat As Long
    Dim ext As String
    Dim beforeTime As Date

    ext = LCase$(Mid$(FullPath, InStrRev(FullPath, ".") + 1))
    Select Case ext
        Case "xlsm": fileFormat = xlOpenXMLWorkbookMacroEnabled
        Case "xlsb": fileFormat = xlExcel12
        Case "xls":  fileFormat = xlExcel8
        Case Else:   fileFormat = xlOpenXMLWorkbook
    End Select

    If Dir(FullPath) <> "" Then
        beforeTime = FileDateTime(FullPath)
    Else
        beforeTime = 0
    End If

    On Error Resume Next
    For attempt = 1 To 3
        Err.Clear
        wb.SaveAs FileName:=FullPath, FileFormat:=fileFormat, CreateBackup:=False
        DoEvents
        If Err.Number = 0 And wb.Saved Then
            If Dir(FullPath) <> "" Then
                If FileDateTime(FullPath) > beforeTime Or beforeTime = 0 Then
                    On Error GoTo 0
                    Exit Sub
                End If
            End If
        End If
        Application.Wait Now + TimeValue("0:00:02")
    Next attempt
    On Error GoTo 0

    Err.Raise vbObjectError + 10, , "Save did not take effect after 3 attempts on: " & FullPath
End Sub

'========================================================
' Finds a worksheet by trying names in priority order.
' Falls back to the first sheet if none match.
'========================================================
Private Function FindSheetByName(wb As Workbook, ByVal names As Variant) As Worksheet
    Dim ws As Worksheet
    Dim n As Variant

    For Each n In names
        For Each ws In wb.Worksheets
            If Trim(LCase(ws.Name)) = Trim(LCase(CStr(n))) Then
                Set FindSheetByName = ws
                Exit Function
            End If
        Next ws
    Next n

    Set FindSheetByName = wb.Worksheets(1)
End Function

'========================================================
' Finds a column by header name (row 1), case-insensitive.
' Returns 0 if not found.
'========================================================
Private Function FindColumn(ws As Worksheet, ByVal names As Variant) As Long
    Dim lastCol As Long, c As Long
    Dim n As Variant
    Dim headerVal As String

    lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column

    For c = 1 To lastCol
        headerVal = Trim(LCase(CStr(ws.Cells(1, c).Value)))
        For Each n In names
            If headerVal = Trim(LCase(CStr(n))) Then
                FindColumn = c
                Exit Function
            End If
        Next n
    Next c

    FindColumn = 0
End Function
