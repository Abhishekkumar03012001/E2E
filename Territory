Option Explicit

'====================================================================
' MAIN ENTRY POINT - copies ONLY Hurricane, Capital, Reinsurance, Fixed
' Call this from anywhere, e.g.:
'   Call UpdateSelectedColumns("C:\Files\Config.xlsx", "C:\Files\Export.xlsx")
'====================================================================
Public Sub UpdateSelectedColumns(ByVal configPath As String, ByVal exportPath As String)

    Dim wbConfig As Workbook, wbExport As Workbook
    Dim wsConfig As Worksheet, wsExport As Worksheet
    Dim configHeaders As Object, exportHeaders As Object
    Dim configLastRow As Long, configLastCol As Long
    Dim exportLastRow As Long, exportLastCol As Long
    Dim configKeyCol As Long, exportKeyCol As Long
    Dim targetCols As Variant, tName As Variant
    Dim colPairs As Object          ' Config col index -> Export col index (only for the 4 target cols)
    Dim rowLookup As Object         ' NormalizedKey -> Config row number
    Dim r As Long
    Dim origCalc As XlCalculation
    Dim origScreenUpdating As Boolean, origEvents As Boolean, origAlerts As Boolean
    Dim success As Boolean

    success = False
    origCalc = Application.Calculation
    origScreenUpdating = Application.ScreenUpdating
    origEvents = Application.EnableEvents
    origAlerts = Application.DisplayAlerts

    On Error GoTo ErrHandler

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False
    Application.Calculation = xlCalculationManual

    ' ---- Close files first if already open (no prompts) ----
    CloseWorkbookIfOpen2 configPath
    CloseWorkbookIfOpen2 exportPath

    ' ---- Open both workbooks silently ----
    Set wbConfig = Workbooks.Open(configPath, UpdateLinks:=0, ReadOnly:=False, _
                    IgnoreReadOnlyRecommended:=True, Notify:=False, AddToMru:=False)
    Set wbExport = Workbooks.Open(exportPath, UpdateLinks:=0, ReadOnly:=False, _
                    IgnoreReadOnlyRecommended:=True, Notify:=False, AddToMru:=False)

    ' ---- Get required sheets (case-insensitive) ----
    Set wsConfig = FindSheet2(wbConfig, Array("R_L_Territory"))
    If wsConfig Is Nothing Then
        MsgBox "Sheet 'R_L_Territory' not found in Config file.", vbExclamation
        GoTo CleanExit
    End If

    Set wsExport = FindSheet2(wbExport, Array("R_L_Territory", "ratingTerritory"))
    If wsExport Is Nothing Then
        Set wsExport = wbExport.Worksheets(1)   ' fallback: first/only sheet
    End If

    ' ---- Read headers ----
    Set configHeaders = GetHeaderMap2(wsConfig, configLastCol)
    Set exportHeaders = GetHeaderMap2(wsExport, exportLastCol)

    configLastRow = GetLastDataRow2(wsConfig)
    exportLastRow = GetLastDataRow2(wsExport)

    ' ---- Locate key (Territory) columns ----
    configKeyCol = DictLookup2(configHeaders, "TERRITORY")
    If configKeyCol = 0 Then configKeyCol = DictLookup2(configHeaders, "RATINGTERRITORY")
    If configKeyCol = 0 Then
        MsgBox "Column 'Territory'/'ratingTerritory' not found in Config sheet.", vbExclamation
        GoTo CleanExit
    End If

    exportKeyCol = DictLookup2(exportHeaders, "TERRITORY")
    If exportKeyCol = 0 Then exportKeyCol = DictLookup2(exportHeaders, "RATINGTERRITORY")
    If exportKeyCol = 0 Then
        MsgBox "Column 'Territory'/'ratingTerritory' not found in Export sheet.", vbExclamation
        GoTo CleanExit
    End If

    ' ---- Only these 4 columns are ever touched ----
    targetCols = Array("Hurricane", "Capital", "Reinsurance", "Fixed")

    Set colPairs = CreateObject("Scripting.Dictionary")
    Dim cIdx As Long, eIdx As Long
    For Each tName In targetCols
        cIdx = DictLookup2(configHeaders, CStr(tName))
        eIdx = DictLookup2(exportHeaders, CStr(tName))
        If cIdx > 0 And eIdx > 0 Then
            colPairs.Add cIdx, eIdx
        End If
        ' if a target column is missing in either file, it's simply skipped (not an error)
    Next tName

    If colPairs.Count = 0 Then
        MsgBox "None of the target columns (Hurricane, Capital, Reinsurance, Fixed) " & _
               "were found in both files.", vbExclamation
        GoTo CleanExit
    End If

    ' ---- Build Territory -> Config row lookup (numeric-aware, case-insensitive) ----
    Set rowLookup = CreateObject("Scripting.Dictionary")
    Dim kVal As String, keyDisplay As Variant
    For r = 2 To configLastRow
        keyDisplay = GetKeyValue2(wsConfig.Cells(r, configKeyCol))
        kVal = NormalizeKey2(keyDisplay)
        If Len(Trim$(CStr(keyDisplay))) > 0 Then
            If Not rowLookup.Exists(kVal) Then rowLookup.Add kVal, r
        End If
    Next r

    ' ---- Copy values ONLY for matching Territories, ONLY for the 4 target columns ----
    Dim exportKeyVal As Variant, keyStr As String, targetRow As Long
    Dim cPairKey As Variant, srcVal As Variant

    For r = 2 To exportLastRow
        exportKeyVal = GetKeyValue2(wsExport.Cells(r, exportKeyCol))

        If Len(Trim$(CStr(exportKeyVal))) > 0 Then
            keyStr = NormalizeKey2(exportKeyVal)

            If rowLookup.Exists(keyStr) Then
                targetRow = rowLookup(keyStr)

                For Each cPairKey In colPairs.Keys
                    srcVal = wsExport.Cells(r, colPairs(cPairKey)).Value
                    If Len(Trim$(CStr(srcVal))) > 0 Then     ' skip empty - never paste blanks
                        wsConfig.Cells(targetRow, CLng(cPairKey)).Value = srcVal
                    End If
                Next cPairKey
            End If
            ' Territories not already present in Config are ignored here -
            ' this routine only updates existing rows, it never adds rows
            ' or touches any column other than the 4 listed above.
        End If
    Next r

    ' ---- Save & close ----
    wbConfig.Close SaveChanges:=True
    wbExport.Close SaveChanges:=False
    success = True

CleanExit:
    Application.Calculation = origCalc
    Application.ScreenUpdating = origScreenUpdating
    Application.EnableEvents = origEvents
    Application.DisplayAlerts = origAlerts
    Application.CutCopyMode = False

    If success Then MsgBox "Done", vbInformation
    Exit Sub

ErrHandler:
    On Error Resume Next
    If Not wbConfig Is Nothing Then wbConfig.Close SaveChanges:=False
    If Not wbExport Is Nothing Then wbExport.Close SaveChanges:=False
    On Error GoTo 0
    MsgBox "Error: " & Err.Description, vbCritical
    Resume CleanExit

End Sub

'====================================================================
' HELPER FUNCTIONS (suffixed "2" to avoid clashing with your other macro)
'====================================================================

Private Sub CloseWorkbookIfOpen2(ByVal path As String)
    Dim wb As Workbook, fname As String
    fname = Mid$(path, InStrRev(path, Application.PathSeparator) + 1)
    On Error Resume Next
    Set wb = Workbooks(fname)
    On Error GoTo 0
    If Not wb Is Nothing Then
        Application.DisplayAlerts = False
        wb.Close SaveChanges:=False
        Application.DisplayAlerts = True
    End If
End Sub

Private Function FindSheet2(wb As Workbook, names As Variant) As Worksheet
    Dim ws As Worksheet, n As Variant
    For Each n In names
        For Each ws In wb.Worksheets
            If StrComp(ws.Name, CStr(n), vbTextCompare) = 0 Then
                Set FindSheet2 = ws
                Exit Function
            End If
        Next ws
    Next n
    Set FindSheet2 = Nothing
End Function

Private Function GetHeaderMap2(ws As Worksheet, ByRef lastCol As Long) As Object
    Dim dict As Object, c As Long, h As String
    Set dict = CreateObject("Scripting.Dictionary")
    lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastCol
        h = Trim$(CStr(ws.Cells(1, c).Value))
        If Len(h) > 0 Then
            If Not dict.Exists(UCase$(h)) Then dict.Add UCase$(h), c
        End If
    Next c
    Set GetHeaderMap2 = dict
End Function

Private Function DictLookup2(dict As Object, key As String) As Long
    If dict.Exists(UCase$(key)) Then
        DictLookup2 = dict(UCase$(key))
    Else
        DictLookup2 = 0
    End If
End Function

Private Function GetLastDataRow2(ws As Worksheet) As Long
    Dim lr As Long
    On Error Resume Next
    lr = ws.Cells.Find(What:="*", After:=ws.Cells(1, 1), _
        SearchOrder:=xlByRows, SearchDirection:=xlPrevious).Row
    On Error GoTo 0
    If lr < 1 Then lr = 1
    GetLastDataRow2 = lr
End Function

' Returns the Territory key's true display value, preferring padded text
' (e.g. "0558409") when the cell is a zero-padded number format.
Private Function GetKeyValue2(cell As Range) As Variant
    Dim v As Variant, nf As String
    v = cell.Value

    If VarType(v) = vbString Then
        GetKeyValue2 = v
        Exit Function
    End If

    If IsNumeric(v) And Len(Trim$(CStr(v))) > 0 Then
        nf = cell.NumberFormat
        If nf <> "General" And nf <> "@" And InStr(1, nf, "0") > 0 _
           And Len(Replace(Replace(nf, "0", ""), "#", "")) = 0 Then
            GetKeyValue2 = cell.Text
        Else
            GetKeyValue2 = v
        End If
    Else
        GetKeyValue2 = v
    End If
End Function

' Numeric-aware, case-insensitive key normalization so "0558409" and "558409"
' are treated as the same Territory.
Private Function NormalizeKey2(ByVal v As Variant) As String
    Dim s As String
    s = Trim$(CStr(v))
    If Len(s) > 0 And IsNumeric(s) Then
        NormalizeKey2 = "NUM:" & CStr(CDbl(s))
    Else
        NormalizeKey2 = "TXT:" & UCase$(s)
    End If
End Function
