Sub RunProcess()

    Dim path1 As String
    Dim path2 As String

    path1 = Application.GetOpenFilename( _
                FileFilter:="Excel Files (*.xlsx;*.xlsm),*.xlsx;*.xlsm", _
                Title:="Select First Excel File")

    If path1 = "False" Then Exit Sub

    path2 = Application.GetOpenFilename( _
                FileFilter:="Excel Files (*.xlsx;*.xlsm),*.xlsx;*.xlsm", _
                Title:="Select Second Excel File")

    If path2 = "False" Then Exit Sub

    Call MyFunction(path1, path2)

End Sub


