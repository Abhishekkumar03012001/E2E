Option Explicit

' ==== CONFIGURE THESE IF YOUR HEADER ROW IS NOT ROW 1 ====
Private Const HEADER_ROW As Long = 1
Private Const CONFIG_SHEET_NAME As String = "R_L_Territory"
' ===========================================================

Public Function RunTerritoryMapping(ByVal configPath As String, ByVal catPath As String) As String

    Dim configWB As Workbook, catWB As Workbook
    Dim configWasAlreadyOpen As Boolean, catWasAlreadyOpen As Boolean
    Dim origScreenUpdating As Boolean, origDisplayAlerts As Boolean
    Dim origEnableEvents As Boolean, origCalc As XlCalculation

    On Error GoTo ErrHandler

    ' ---- Save original app settings ----
    origScreenUpdating = Application.ScreenUpdating
    origDisplayAlerts = Application.DisplayAlerts
    origEnableEvents = Application.EnableEvents
    origCalc = Application.Calculation

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual
    Application.AskToUpdateLinks = False

    ' ---- Open (or reuse) workbooks without any prompts ----
    Set configWB = GetOrOpenWorkbook(configPath, False, configWasAlreadyOpen)
    Set catWB = GetOrOpenWorkbook(catPath, True, catWasAlreadyOpen)

    ' ---- Get sheets ----
    Dim configWS As Worksheet, catWS As Worksheet
    On Error Resume Next
    Set configWS = configWB.Sheets(CONFIG_SHEET_NAME)
    On Error GoTo ErrHandler
    If configWS Is Nothing Then
        RunTerritoryMapping = "Sheet '" & CONFIG_SHEET_NAME & "' not found in Config file."
        GoTo CleanExit
    End If

    Set catWS = catWB.Sheets(1) ' CAT has only one sheet / use first sheet

    ' ---- Find territory columns (case-insensitive: "Territory" or "ratingTerritory") ----
    Dim territoryNames(1) As String
    territoryNames(0) = "territory"
    territoryNames(1) = "ratingterritory"

    Dim configTerrCol As Long, catTerrCol As Long
    configTerrCol = FindColumnByHeader(configWS, HEADER_ROW, territoryNames)
    catTerrCol = FindColumnByHeader(catWS, HEADER_ROW, territoryNames)

    If configTerrCol = 0 Then
        RunTerritoryMapping = "Territory column not found in Config sheet '" & CONFIG_SHEET_NAME & "'."
        GoTo CleanExit
    End If
    If catTerrCol = 0 Then
        RunTerritoryMapping = "Territory column not found in CAT sheet."
        GoTo CleanExit
    End If

    ' ---- Build dictionary: territory value -> Config row number ----
    Dim dictConfigRows As Object
    Set dictConfigRows = CreateObject("Scripting.Dictionary")

    Dim configLastRow As Long
    configLastRow = configWS.Cells(configWS.Rows.Count, configTerrCol).End(xlUp).Row

    Dim r As Long
    Dim key As String
    For r = HEADER_ROW + 1 To configLastRow
        key = NormalizeKey(configWS.Cells(r, configTerrCol).Value)
        If key <> "" Then
            If Not dictConfigRows.Exists(key) Then
                dictConfigRows.Add key, r
            End If
        End If
    Next r

    ' ---- Determine last used column/row in CAT sheet ----
    Dim catLastCol As Long, catLastRow As Long
    catLastCol = catWS.Cells(HEADER_ROW, catWS.Columns.Count).End(xlToLeft).Column
    catLastRow = catWS.Cells(catWS.Rows.Count, catTerrCol).End(xlUp).Row

    ' ---- Pre-fetch Config header names (case-insensitive lookup) ----
    Dim configLastCol As Long
    configLastCol = configWS.Cells(HEADER_ROW, configWS.Columns.Count).End(xlToLeft).Column

    Dim dictConfigHeaders As Object
    Set dictConfigHeaders = CreateObject("Scripting.Dictionary")
    Dim c As Long
    For c = 1 To configLastCol
        Dim hName As String
        hName = LCase(Trim(CStr(configWS.Cells(HEADER_ROW, c).Value)))
        If hName <> "" And Not dictConfigHeaders.Exists(hName) Then
            dictConfigHeaders.Add hName, c
        End If
    Next c

    ' ---- Loop through each CAT column (skip territory column) ----
    Dim colsProcessed As Long, valuesWritten As Long
    Dim catCol As Long
    For catCol = 1 To catLastCol
        If catCol <> catTerrCol Then
            Dim catHeader As String
            catHeader = LCase(Trim(CStr(catWS.Cells(HEADER_ROW, catCol).Value)))

            If catHeader <> "" And dictConfigHeaders.Exists(catHeader) Then
                Dim targetCol As Long
                targetCol = dictConfigHeaders(catHeader)

                If targetCol <> configTerrCol Then
                    colsProcessed = colsProcessed + 1

                    ' Loop through CAT rows, match by territory, write value only
                    Dim rr As Long
                    For rr = HEADER_ROW + 1 To catLastRow
                        Dim tKey As String
                        tKey = NormalizeKey(catWS.Cells(rr, catTerrCol).Value)
                        If tKey <> "" Then
                            If dictConfigRows.Exists(tKey) Then
                                Dim destRow As Long
                                destRow = dictConfigRows(tKey)
                                ' Only value is written -> Config's existing
                                ' number format / alignment / layout is preserved
                                configWS.Cells(destRow, targetCol).Value = catWS.Cells(rr, catCol).Value
                                valuesWritten = valuesWritten + 1
                            End If
                        End If
                    Next rr
                End If
            End If
        End If
    Next catCol

    ' ---- Save Config file silently (no format/keep-as prompts) ----
    Application.DisplayAlerts = False
    configWB.Save

    RunTerritoryMapping = "OK"

CleanExit:
    ' ---- Close CAT without saving (we only read from it) ----
    If Not catWB Is Nothing Then
        If Not catWasAlreadyOpen Then
            catWB.Close SaveChanges:=False
        End If
    End If

    ' Leave Config open (already saved) if it was already open before;
    ' if we opened it ourselves, keep it open too so user can review it.

    ' ---- Restore app settings ----
    Application.ScreenUpdating = origScreenUpdating
    Application.DisplayAlerts = origDisplayAlerts
    Application.EnableEvents = origEnableEvents
    Application.Calculation = origCalc

    Exit Function

ErrHandler:
    RunTerritoryMapping = Err.Description
    Resume CleanExit

End Function

' ------------------------------------------------------------------
' Opens a workbook without any pop-ups (read-only recommended, links,
' format prompts, etc.), or returns it if already open.
' ------------------------------------------------------------------
Private Function GetOrOpenWorkbook(ByVal fullPath As String, ByVal openReadOnly As Boolean, ByRef wasAlreadyOpen As Boolean) As Workbook
    Dim wb As Workbook
    Dim fileName As String
    fileName = Mid(fullPath, InStrRev(fullPath, "\") + 1)

    wasAlreadyOpen = False
    For Each wb In Workbooks
        If LCase(wb.Name) = LCase(fileName) Then
            Set GetOrOpenWorkbook = wb
            wasAlreadyOpen = True
            Exit Function
        End If
    Next wb

    Set GetOrOpenWorkbook = Workbooks.Open( _
        Filename:=fullPath, _
        UpdateLinks:=0, _
        ReadOnly:=openReadOnly, _
        IgnoreReadOnlyRecommended:=True, _
        Notify:=False)
End Function

' ------------------------------------------------------------------
' Finds a column in headerRow whose header (case-insensitive, trimmed)
' matches any name in acceptedNames(). Returns 0 if not found.
' ------------------------------------------------------------------
Private Function FindColumnByHeader(ws As Worksheet, ByVal headerRow As Long, acceptedNames() As String) As Long
    Dim lastCol As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    Dim c As Long, i As Long
    Dim hVal As String
    For c = 1 To lastCol
        hVal = LCase(Trim(CStr(ws.Cells(headerRow, c).Value)))
        For i = LBound(acceptedNames) To UBound(acceptedNames)
            If hVal = acceptedNames(i) Then
                FindColumnByHeader = c
                Exit Function
            End If
        Next i
    Next c

    FindColumnByHeader = 0
End Function

' ------------------------------------------------------------------
' Normalizes a territory value into a comparable string key so that
' 11020, "11020", and 11020.0 all match the same key.
' ------------------------------------------------------------------
Private Function NormalizeKey(ByVal v As Variant) As String
    If IsError(v) Then
        NormalizeKey = ""
        Exit Function
    End If
    If Trim(CStr(v)) = "" Then
        NormalizeKey = ""
        Exit Function
    End If
    If IsNumeric(v) Then
        NormalizeKey = CStr(CDbl(v))
    Else
        NormalizeKey = LCase(Trim(CStr(v)))
    End If
End Function

' ------------------------------------------------------------------
' Call this to launch the form (e.g. assign to a button/shortcut)
' ------------------------------------------------------------------
Public Sub ShowTerritoryMapperForm()
    frmTerritoryMapper.Show
End Sub
