Option Explicit

'====================================================================
' MAIN CALLABLE PROCEDURE
' Call this from anywhere, e.g.:
'   Call MergeExportIntoConfig("C:\Files\Config.xlsx", "C:\Files\Export.xlsx")
'====================================================================
Public Sub MergeExportIntoConfig(ByVal ConfigPath As String, _
                                  ByVal ExportPath As String, _
                                  Optional ByVal ShowDoneMsg As Boolean = True)

    Dim wbConfig As Workbook, wbExport As Workbook
    Dim wsConfig As Worksheet, wsExport As Worksheet
    Dim mapDict As Object, configHeaders As Object, exportHeaders As Object
    Dim lastColConfig As Long, lastColExport As Long
    Dim lastRowConfig As Long, lastRowExport As Long
    Dim c As Long, r As Long
    Dim configName As String, exportLookupName As String, keyLower As String
    Dim eCol As Long
    Dim neededRows As Long, existingRows As Long
    Dim origCalc As XlCalculation

    On Error GoTo ErrHandler

    'Speed / no popups
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.AskToUpdateLinks = False
    origCalc = Application.Calculation
    Application.Calculation = xlCalculationManual

    'Basic file checks
    If Dir(ConfigPath) = "" Then Err.Raise vbObjectError + 1, , "Config file not found: " & ConfigPath
    If Dir(ExportPath) = "" Then Err.Raise vbObjectError + 2, , "Export file not found: " & ExportPath

    'Open Config normally (we need to write to it)
    Set wbConfig = Workbooks.Open(Filename:=ConfigPath, UpdateLinks:=0, ReadOnly:=False, Notify:=False)

    'Open Export as ReadOnly (we only read from it) - avoids any read-only prompts
    Set wbExport = Workbooks.Open(Filename:=ExportPath, UpdateLinks:=0, ReadOnly:=True, Notify:=False, IgnoreReadOnlyRecommended:=True)

    'Target sheets
    Set wsConfig = wbConfig.Sheets("R_L_Territory")
    Set wsExport = wbExport.Sheets(1)   'first and only sheet

    '----------------------------------------------------------------
    'Build mapping dictionary: Config column name (lower) -> Export column name (lower)
    '----------------------------------------------------------------
    Set mapDict = CreateObject("Scripting.Dictionary")
    mapDict.CompareMode = 1 'vbTextCompare (case-insensitive keys)

    mapDict.Add "territory", "rating territory"
    mapDict.Add "waterwinter", "winterwater"
    mapDict.Add "waternonwinter", "nwwtr"
    mapDict.Add "windsummer", "summerwind"
    mapDict.Add "windwinter", "winterwind"
    mapDict.Add "liabilitypollution", "liab"
    mapDict.Add "theftvandalism", "theft"

    '----------------------------------------------------------------
    'Read headers (assumes header row = row 1 on both sheets)
    '----------------------------------------------------------------
    lastColConfig = wsConfig.Cells(1, wsConfig.Columns.Count).End(xlToLeft).Column
    lastColExport = wsExport.Cells(1, wsExport.Columns.Count).End(xlToLeft).Column

    Set configHeaders = CreateObject("Scripting.Dictionary") 'lower name -> col index
    configHeaders.CompareMode = 1
    Set exportHeaders = CreateObject("Scripting.Dictionary")
    exportHeaders.CompareMode = 1

    For c = 1 To lastColConfig
        keyLower = LCase(Trim(CStr(wsConfig.Cells(1, c).Value)))
        If Len(keyLower) > 0 Then
            If Not configHeaders.Exists(keyLower) Then configHeaders.Add keyLower, c
        End If
    Next c

    For c = 1 To lastColExport
        keyLower = LCase(Trim(CStr(wsExport.Cells(1, c).Value)))
        If Len(keyLower) > 0 Then
            If Not exportHeaders.Exists(keyLower) Then exportHeaders.Add keyLower, c
        End If
    Next c

    'Last data rows (based on column A, row 2 downward)
    lastRowConfig = wsConfig.Cells(wsConfig.Rows.Count, 1).End(xlUp).Row
    If lastRowConfig < 1 Then lastRowConfig = 1
    lastRowExport = wsExport.Cells(wsExport.Rows.Count, 1).End(xlUp).Row
    If lastRowExport < 1 Then lastRowExport = 1

    neededRows = lastRowExport - 1        'export data rows (excluding header)
    existingRows = lastRowConfig - 1      'existing config data rows (excluding header)
    If neededRows < 0 Then neededRows = 0
    If existingRows < 0 Then existingRows = 0

    '----------------------------------------------------------------
    'Loop through each Config column, find matching Export column, replace values
    '----------------------------------------------------------------
    Dim configKey As Variant
    For Each configKey In configHeaders.Keys

        c = configHeaders(configKey)
        configName = CStr(configKey)

        'Determine which export column name to look for
        If mapDict.Exists(configName) Then
            exportLookupName = LCase(Trim(mapDict(configName)))
        Else
            exportLookupName = configName 'direct case-insensitive match
        End If

        If exportHeaders.Exists(exportLookupName) Then
            eCol = exportHeaders(exportLookupName)

            'Extend Config's row formatting downward if Export has more rows than Config currently has
            If neededRows > existingRows And existingRows >= 1 Then
                wsConfig.Cells(2, c).Copy
                wsConfig.Range(wsConfig.Cells(existingRows + 2, c), _
                                wsConfig.Cells(neededRows + 1, c)).PasteSpecial Paste:=xlPasteFormats
                Application.CutCopyMode = False
            End If

            'Clear existing values only (keep formatting) across the full needed range
            Dim clearRows As Long
            clearRows = existingRows
            If neededRows > clearRows Then clearRows = neededRows
            If clearRows > 0 Then
                wsConfig.Range(wsConfig.Cells(2, c), wsConfig.Cells(clearRows + 1, c)).ClearContents
            End If

            'Paste Export values into Config column, same order, row by row
            For r = 1 To neededRows
                wsConfig.Cells(r + 1, c).Value = wsExport.Cells(r + 1, eCol).Value
            Next r
        End If

    Next configKey

    '----------------------------------------------------------------
    'Save & close
    '----------------------------------------------------------------
    wbConfig.Save
    wbConfig.Close SaveChanges:=False
    wbExport.Close SaveChanges:=False

    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.AskToUpdateLinks = True
    Application.Calculation = origCalc

    If ShowDoneMsg Then MsgBox "Done", vbInformation

    Exit Sub

ErrHandler:
    Dim errMsg As String
    errMsg = "Error " & Err.Number & ": " & Err.Description

    On Error Resume Next
    If Not wbConfig Is Nothing Then wbConfig.Close SaveChanges:=False
    If Not wbExport Is Nothing Then wbExport.Close SaveChanges:=False
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.AskToUpdateLinks = True
    Application.Calculation = origCalc
    On Error GoTo 0

    MsgBox errMsg, vbCritical

End Sub

'====================================================================
' EXAMPLE CALLER - edit the paths and run this, or call
' MergeExportIntoConfig directly from your own Sub/Userform
'====================================================================
Public Sub RunMergeExample()
    Call MergeExportIntoConfig("C:\Files\Config.xlsx", "C:\Files\Export.xlsx")
End Sub
