Option Explicit

'====================================================================
' EDIT THESE 3 PATHS BEFORE RUNNING
'====================================================================
Sub CopyTerritoryData()

    Dim configPath As String, exportPath As String, catPath As String
    configPath = "C:\path\to\Config.xlsx"
    exportPath = "C:\path\to\Export.xlsx"
    catPath = "C:\path\to\CAT.xlsx"

    Dim wbConfig As Workbook, wbExport As Workbook, wbCat As Workbook
    Dim wsConfig As Worksheet, wsExport As Worksheet, wsCat As Worksheet

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    Set wbConfig = Workbooks.Open(configPath)
    Set wbExport = Workbooks.Open(exportPath)
    Set wbCat = Workbooks.Open(catPath)

    Set wsConfig = wbConfig.Sheets("R_L_Territory")
    Set wsExport = wbExport.Sheets(1)
    Set wsCat = wbCat.Sheets(1)

    '----------------------------------------------------------------
    ' Alias mapping: Config header (key) -> Export/CAT header (value)
    '----------------------------------------------------------------
    Dim aliasMap As Object
    Set aliasMap = CreateObject("Scripting.Dictionary")
    aliasMap.Add "territory", "rating territory"
    aliasMap.Add "waterwinter", "winterwater"
    aliasMap.Add "waternonwinter", "nwwtr"
    aliasMap.Add "windsummer", "summerwind"
    aliasMap.Add "windwinter", "winterwind"
    aliasMap.Add "liabilitypollution", "liab"
    aliasMap.Add "theftvandalism", "theft"

    '----------------------------------------------------------------
    ' Step 1: Capture Config header names + previous number formats
    ' (based on row 2, before we delete anything)
    '----------------------------------------------------------------
    Dim lastColConfig As Long
    lastColConfig = wsConfig.Cells(1, wsConfig.Columns.Count).End(xlToLeft).Column

    Dim lastRowConfig As Long
    lastRowConfig = wsConfig.Cells(wsConfig.Rows.Count, 1).End(xlUp).Row

    Dim configHeaders() As String
    Dim configFormats() As String
    ReDim configHeaders(1 To lastColConfig)
    ReDim configFormats(1 To lastColConfig)

    Dim c As Long
    For c = 1 To lastColConfig
        configHeaders(c) = LCase(Trim(CStr(wsConfig.Cells(1, c).Value)))
        If lastRowConfig >= 2 Then
            configFormats(c) = wsConfig.Cells(2, c).NumberFormat
        Else
            configFormats(c) = "General"
        End If
    Next c

    '----------------------------------------------------------------
    ' Step 2: Delete all non-header rows in R_L_Territory
    '----------------------------------------------------------------
    If lastRowConfig >= 2 Then
        wsConfig.Rows("2:" & lastRowConfig).Delete
    End If

    '----------------------------------------------------------------
    ' Step 3: Paste Export data, then CAT data, into matching columns
    '----------------------------------------------------------------
    Dim nextRow As Long
    nextRow = 2

    nextRow = PasteMatchingColumns(wsExport, wsConfig, configHeaders, configFormats, aliasMap, nextRow)
    nextRow = PasteMatchingColumns(wsCat, wsConfig, configHeaders, configFormats, aliasMap, nextRow)

    '----------------------------------------------------------------
    ' Step 4: Set "Fixed" column to 1.0000 for all pasted rows,
    ' keeping the original format
    '----------------------------------------------------------------
    Dim fixedCol As Long
    fixedCol = 0
    For c = 1 To lastColConfig
        If configHeaders(c) = "fixed" Then
            fixedCol = c
            Exit For
        End If
    Next c

    If fixedCol > 0 And nextRow > 2 Then
        Dim r As Long
        For r = 2 To nextRow - 1
            wsConfig.Cells(r, fixedCol).Value = 1
            wsConfig.Cells(r, fixedCol).NumberFormat = configFormats(fixedCol)
        Next r
    End If

    '----------------------------------------------------------------
    ' Step 5: Save Config as new file: <original name> updated territories
    '----------------------------------------------------------------
    Dim newPath As String, folderPath As String, baseName As String, ext As String

    folderPath = wbConfig.Path & "\"
    ext = "." & LCase(Right(wbConfig.Name, Len(wbConfig.Name) - InStrRev(wbConfig.Name, ".")))
    baseName = Left(wbConfig.Name, Len(wbConfig.Name) - Len(ext))

    newPath = folderPath & baseName & " updated territories" & ext

    wbConfig.SaveAs newPath, FileFormat:=wbConfig.FileFormat

    wbExport.Close SaveChanges:=False
    wbCat.Close SaveChanges:=False

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    MsgBox "Done. Saved as:" & vbCrLf & newPath, vbInformation

End Sub

'====================================================================
' Copies matching columns from a source sheet (Export or CAT) into
' wsConfig, starting at startRow. Returns the next free row after
' pasting. Matching is case-insensitive, using direct header match
' first, then the alias map.
'====================================================================
Function PasteMatchingColumns(wsSource As Worksheet, wsConfig As Worksheet, _
    configHeaders() As String, configFormats() As String, aliasMap As Object, _
    startRow As Long) As Long

    Dim lastColSrc As Long, lastRowSrc As Long
    lastColSrc = wsSource.Cells(1, wsSource.Columns.Count).End(xlToLeft).Column
    lastRowSrc = wsSource.Cells(wsSource.Rows.Count, 1).End(xlUp).Row

    If lastRowSrc < 2 Then
        PasteMatchingColumns = startRow
        Exit Function
    End If

    Dim srcHeaders() As String
    ReDim srcHeaders(1 To lastColSrc)

    Dim sc As Long
    For sc = 1 To lastColSrc
        srcHeaders(sc) = LCase(Trim(CStr(wsSource.Cells(1, sc).Value)))
    Next sc

    ' For each Config column, find the matching source column (if any)
    Dim lastColConfig As Long
    lastColConfig = UBound(configHeaders)

    Dim colMatch() As Long
    ReDim colMatch(1 To lastColConfig)

    Dim cc As Long
    For cc = 1 To lastColConfig
        colMatch(cc) = 0
        If configHeaders(cc) <> "" Then
            For sc = 1 To lastColSrc
                If srcHeaders(sc) = configHeaders(cc) Then
                    colMatch(cc) = sc
                    Exit For
                ElseIf aliasMap.Exists(configHeaders(cc)) Then
                    If srcHeaders(sc) = aliasMap(configHeaders(cc)) Then
                        colMatch(cc) = sc
                        Exit For
                    End If
                End If
            Next sc
        End If
    Next cc

    ' Copy the data rows
    Dim srcRow As Long, destRow As Long
    destRow = startRow

    For srcRow = 2 To lastRowSrc
        For cc = 1 To lastColConfig
            If colMatch(cc) > 0 Then
                wsConfig.Cells(destRow, cc).Value = wsSource.Cells(srcRow, colMatch(cc)).Value
                wsConfig.Cells(destRow, cc).NumberFormat = configFormats(cc)
            End If
        Next cc
        destRow = destRow + 1
    Next srcRow

    PasteMatchingColumns = destRow

End Function
