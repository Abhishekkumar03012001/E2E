Option Explicit

'=========================================================
' PUBLIC ENTRY POINT — call this from anywhere
'   Call MapConfigExportData "C:\path\Config.xlsx", "C:\path\Export.xlsx"
'=========================================================
Public Sub MapConfigExportData(ByVal ConfigPath As String, ByVal ExportPath As String)

    Dim wbConfig As Workbook, wbExport As Workbook
    Dim wsConfig As Worksheet, wsExport As Worksheet
    Dim aliasMap As Object, exportHeaders As Object
    Dim c As Long, lastColConfig As Long, lastColExport As Long
    Dim configHeader As String, key As String, exportHeaderWanted As String
    Dim matchedExportCol As Long
    Dim exportLastRow As Long, oldConfigLastRow As Long, newLastRow As Long
    Dim arrData As Variant
    Dim matchCount As Long

    Const HEADER_ROW As Long = 1
    Const DATA_START_ROW As Long = 2

    On Error GoTo ErrHandler

    '--- Silence everything ---
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    Application.AskToUpdateLinks = False
    Application.Calculation = xlCalculationManual

    '--- Validate files exist ---
    If Dir(ConfigPath) = "" Then Err.Raise vbObjectError + 1, , "Config file not found: " & ConfigPath
    If Dir(ExportPath) = "" Then Err.Raise vbObjectError + 2, , "Export file not found: " & ExportPath

    '--- Open workbooks ---
    Set wbConfig = Workbooks.Open(FileName:=ConfigPath, UpdateLinks:=0, ReadOnly:=False)
    Set wbExport = Workbooks.Open(FileName:=ExportPath, UpdateLinks:=0, ReadOnly:=True)

    Set wsConfig = wbConfig.Sheets("R_L_Territory")
    Set wsExport = wbExport.Sheets(1) ' first & only sheet

    '--- Build alias map: ConfigHeader(lowercase) -> ExportHeader ---
    Set aliasMap = CreateObject("Scripting.Dictionary")
    aliasMap.CompareMode = vbTextCompare
    aliasMap.Add "territory", "rating territory"
    aliasMap.Add "waterwinter", "winterwater"
    aliasMap.Add "waternonwinter", "nwwtr"
    aliasMap.Add "windsummer", "summerwind"
    aliasMap.Add "windwinter", "winterwind"
    aliasMap.Add "liabilitypollution", "liab"
    aliasMap.Add "theftvandalism", "theft"

    '--- Build export header lookup: header(lowercase, trimmed) -> column index ---
    Set exportHeaders = CreateObject("Scripting.Dictionary")
    exportHeaders.CompareMode = vbTextCompare
    lastColExport = wsExport.Cells(HEADER_ROW, wsExport.Columns.Count).End(xlToLeft).Column
    For c = 1 To lastColExport
        key = LCase$(Trim$(CStr(wsExport.Cells(HEADER_ROW, c).Value)))
        If key <> "" Then
            If Not exportHeaders.Exists(key) Then exportHeaders.Add key, c
        End If
    Next c

    '--- Loop through Config columns, find match, copy data ---
    lastColConfig = wsConfig.Cells(HEADER_ROW, wsConfig.Columns.Count).End(xlToLeft).Column
    matchCount = 0

    For c = 1 To lastColConfig
        configHeader = Trim$(CStr(wsConfig.Cells(HEADER_ROW, c).Value))
        If configHeader <> "" Then

            key = LCase$(configHeader)
            matchedExportCol = 0

            ' 1) Try alias mapping first
            If aliasMap.Exists(key) Then
                exportHeaderWanted = LCase$(aliasMap(key))
                If exportHeaders.Exists(exportHeaderWanted) Then
                    matchedExportCol = exportHeaders(exportHeaderWanted)
                End If
            End If

            ' 2) Fall back to direct case-insensitive name match
            If matchedExportCol = 0 Then
                If exportHeaders.Exists(key) Then
                    matchedExportCol = exportHeaders(key)
                End If
            End If

            ' 3) If matched, replace values keeping Config's formatting
            If matchedExportCol > 0 Then

                exportLastRow = wsExport.Cells(wsExport.Rows.Count, matchedExportCol).End(xlUp).Row
                If exportLastRow < DATA_START_ROW Then
                    ' no data rows in export for this column — just clear config column
                    oldConfigLastRow = wsConfig.Cells(wsConfig.Rows.Count, c).End(xlUp).Row
                    If oldConfigLastRow >= DATA_START_ROW Then
                        wsConfig.Range(wsConfig.Cells(DATA_START_ROW, c), wsConfig.Cells(oldConfigLastRow, c)).ClearContents
                    End If
                Else
                    newLastRow = DATA_START_ROW + (exportLastRow - DATA_START_ROW) ' = exportLastRow

                    ' Stretch/apply Config's own row-2 formatting across the needed range
                    wsConfig.Cells(DATA_START_ROW, c).Copy
                    wsConfig.Range(wsConfig.Cells(DATA_START_ROW, c), wsConfig.Cells(newLastRow, c)).PasteSpecial Paste:=xlPasteFormats
                    Application.CutCopyMode = False

                    ' Clear any leftover old rows beyond the new data length
                    oldConfigLastRow = wsConfig.Cells(wsConfig.Rows.Count, c).End(xlUp).Row
                    If oldConfigLastRow > newLastRow Then
                        wsConfig.Range(wsConfig.Cells(newLastRow + 1, c), wsConfig.Cells(oldConfigLastRow, c)).ClearContents
                    End If

                    ' Pull export values and write them in (values only, format untouched)
                    arrData = wsExport.Range(wsExport.Cells(DATA_START_ROW, matchedExportCol), _
                                              wsExport.Cells(exportLastRow, matchedExportCol)).Value2
                    wsConfig.Range(wsConfig.Cells(DATA_START_ROW, c), wsConfig.Cells(newLastRow, c)).Value2 = arrData
                End If

                matchCount = matchCount + 1
            End If
        End If
    Next c

    '--- Save Config safely (retry-proof, no popups) ---
    Call SafeSaveWorkbook(wbConfig)

    '--- Close everything ---
    wbExport.Close SaveChanges:=False
    wbConfig.Close SaveChanges:=False

    '--- Restore app state ---
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    MsgBox "Done. " & matchCount & " column(s) updated.", vbInformation, "Config/Export Mapping"
    Exit Sub

ErrHandler:
    On Error Resume Next
    If Not wbExport Is Nothing Then wbExport.Close SaveChanges:=False
    If Not wbConfig Is Nothing Then wbConfig.Close SaveChanges:=False
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    MsgBox "Failed: " & Err.Description, vbCritical, "Config/Export Mapping"
End Sub


'=========================================================
' Helper — saves without triggering "Keep current format?"
' or file-lock popups, with one retry if the file is briefly
' locked (e.g. antivirus/OneDrive sync).
'=========================================================
Private Sub SafeSaveWorkbook(ByVal wb As Workbook)
    Dim attempt As Long
    On Error Resume Next
    For attempt = 1 To 3
        Err.Clear
        wb.Save
        If Err.Number = 0 Then Exit Sub
        Application.Wait Now + TimeValue("0:00:01")
    Next attempt
    On Error GoTo 0
    If Err.Number <> 0 Then
        Err.Raise Err.Number, , "Could not save Config file: " & Err.Description
    End If
End Sub


'=========================================================
' STANDALONE LAUNCHER — run this directly (Alt+F8) if you
' just want to pick the two files manually.
'=========================================================
Public Sub RunConfigExportMapping()
    Dim configPath As Variant, exportPath As Variant

    configPath = Application.GetOpenFilename("Excel Files (*.xlsx; *.xlsm; *.xls),*.xlsx;*.xlsm;*.xls", , "Select the CONFIG file")
    If configPath = False Then Exit Sub

    exportPath = Application.GetOpenFilename("Excel Files (*.xlsx; *.xlsm; *.xls),*.xlsx;*.xlsm;*.xls", , "Select the EXPORT file")
    If exportPath = False Then Exit Sub

    MapConfigExportData CStr(configPath), CStr(exportPath)
End Sub
