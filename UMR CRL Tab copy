Option Explicit

Private Sub UserForm_Initialize()

    'Initially both textboxes are empty
    txtProp.Value = ""
    txtCRL.Value = ""

    'Update button states
    UpdateButtonStates

End Sub


'========================================================
' Browse button for Property file/folder
'========================================================
Private Sub btnProp_Click()

    Dim selectedPath As String

    With Application.FileDialog(msoFileDialogFilePicker)

        .Title = "Select Property File"
        .AllowMultiSelect = False

        If .Show = -1 Then
            selectedPath = .SelectedItems(1)
            txtProp.Value = selectedPath
        End If

    End With

    UpdateButtonStates

End Sub


'========================================================
' Browse button for CRL file/folder
'========================================================
Private Sub btnCRL_Click()

    Dim selectedPath As String

    With Application.FileDialog(msoFileDialogFilePicker)

        .Title = "Select CRL File"
        .AllowMultiSelect = False

        If .Show = -1 Then
            selectedPath = .SelectedItems(1)
            txtCRL.Value = selectedPath
        End If

    End With

    UpdateButtonStates

End Sub


'========================================================
' Refresh button
' Clears both textboxes
'========================================================
Private Sub btnRefresh_Click()

    txtProp.Value = ""
    txtCRL.Value = ""

    UpdateButtonStates

End Sub


'========================================================
' QC button
' Runs QCrun only when both paths are provided
'========================================================
Private Sub btnQC_Click()

    If Trim(txtProp.Value) = "" Or Trim(txtCRL.Value) = "" Then
        MsgBox "Please provide both Property and CRL paths.", _
               vbExclamation, "Missing Path"
        Exit Sub
    End If

    'Call your QC procedure
    QCrun txtProp.Value, txtCRL.Value

End Sub


'========================================================
' Detect changes when user manually types paths
'========================================================
Private Sub txtProp_Change()

    UpdateButtonStates

End Sub


Private Sub txtCRL_Change()

    UpdateButtonStates

End Sub


'========================================================
' Enable / Disable buttons
'========================================================
Private Sub UpdateButtonStates()

    Dim propEntered As Boolean
    Dim crlEntered As Boolean

    propEntered = (Trim(txtProp.Value) <> "")
    crlEntered = (Trim(txtCRL.Value) <> "")

    'Refresh works if at least one textbox has a value
    btnRefresh.Enabled = (propEntered Or crlEntered)

    'QC works only if BOTH textboxes have values
    btnQC.Enabled = (propEntered And crlEntered)

End Sub
