Option Explicit


'========================================================
' USERFORM INITIALIZE
'========================================================
Private Sub UserForm_Initialize()

    txtProp.Value = ""
    txtCRL.Value = ""

    UpdateButtonStates

End Sub


'========================================================
' PROPERTY BROWSE BUTTON
'========================================================
Private Sub btnProp_Click()

    With Application.FileDialog(msoFileDialogFilePicker)

        .Title = "Select Property File"
        .AllowMultiSelect = False

        If .Show = -1 Then
            txtProp.Value = .SelectedItems(1)
        End If

    End With

    UpdateButtonStates

End Sub


'========================================================
' CRL BROWSE BUTTON
'========================================================
Private Sub btnCRL_Click()

    With Application.FileDialog(msoFileDialogFilePicker)

        .Title = "Select CRL File"
        .AllowMultiSelect = False

        If .Show = -1 Then
            txtCRL.Value = .SelectedItems(1)
        End If

    End With

    UpdateButtonStates

End Sub


'========================================================
' REFRESH BUTTON
' Clears both textboxes
'========================================================
Private Sub btnRefresh_Click()

    txtProp.Value = ""
    txtCRL.Value = ""

    UpdateButtonStates

End Sub


'========================================================
' QC BUTTON
'
' Cases:
'
' 1. Both have values:
'       QCrun txtProp.Value, txtCRL.Value
'
' 2. Only CRL has value:
'       QCrun "", txtCRL.Value
'
' 3. Neither has value:
'       Button is disabled, so this will not normally run.
'========================================================
Private Sub btnQC_Click()

    Dim propPath As String
    Dim crlPath As String

    propPath = Trim(txtProp.Value)
    crlPath = Trim(txtCRL.Value)

    'Safety check
    If crlPath = "" Then
        MsgBox "Please provide the CRL path.", _
               vbExclamation, "Missing CRL Path"
        Exit Sub
    End If

    'If Property path is empty, pass an empty string
    If propPath = "" Then
        QCrun "", crlPath
    Else
        QCrun propPath, crlPath
    End If

End Sub


'========================================================
' TEXTBOX CHANGE EVENTS
' These detect manually typed paths
'========================================================
Private Sub txtProp_Change()

    UpdateButtonStates

End Sub


Private Sub txtCRL_Change()

    UpdateButtonStates

End Sub


'========================================================
' UPDATE BUTTON STATES
'========================================================
Private Sub UpdateButtonStates()

    Dim propEntered As Boolean
    Dim crlEntered As Boolean

    propEntered = (Trim(txtProp.Value) <> "")
    crlEntered = (Trim(txtCRL.Value) <> "")

    '----------------------------------------------------
    ' REFRESH
    ' Enabled if either textbox contains something
    '----------------------------------------------------
    btnRefresh.Enabled = (propEntered Or crlEntered)

    '----------------------------------------------------
    ' QC
    '
    ' CRL MUST have a value.
    ' Property can be empty.
    '----------------------------------------------------
    btnQC.Enabled = crlEntered

End Sub
