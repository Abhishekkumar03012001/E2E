"""
Territory Buffer Build + Compare (standalone)
==============================================

What this script does, step by step:

1. Reads the Config file's "R_L_Territory" tab.
2. Reads the main Territory export file (Inputs!D57).
3. Reads the supplemental CAT file (Inputs!D56).
4. Builds a NEW in-memory "buffer" sheet:
     - starts as an EXACT COPY of the Territory file's own columns + values
       (all of them, nothing dropped)
     - for each of "Hurricane", "Reinsurance", "Capital", "WildFire", "Fixed"
       that is NOT already present in the Territory file, pulls that
       column's values from the CAT file and adds them to the buffer,
       matched row-by-row on the "Territory" column (join key)
     - if a column IS already present in the Territory file, it is left
       completely untouched -- the CAT file's version is ignored
5. Writes that buffer as an actual new sheet in an output workbook (so you
   can open it and visually confirm it's correct).
6. Compares Config's "R_L_Territory" tab against the buffer sheet using
   the SAME column-matching logic as the main tool:
     - exact column name match first
     - then the "Column Match_Tr" mapping sheet from the Input file
   and reports matched/unmatched columns + row-level differences.

Run:
    Edit the file paths in the CONFIG SECTION below, then:
    python territory_buffer_compare.py
-------------------------------------------------------------------------
"""

import os
import re
import sys
import traceback
from collections import Counter
from decimal import Decimal, ROUND_HALF_UP, InvalidOperation

import pandas as pd
from openpyxl import Workbook, load_workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter


# ==================================================================
# >>> CONFIG SECTION -- EDIT THESE PATHS <<<
# ==================================================================
CONFIG_FILE_PATH    = r"C:\path\to\Config_File.xlsx"
TERRITORY_FILE_PATH = r"C:\path\to\Territory_Export.xlsx"   # Inputs!D57
CAT_FILE_PATH       = r"C:\path\to\CAT_Export.xlsx"          # Inputs!D56 (set to "" or None if you don't have one)
INPUT_FILE_PATH     = r"C:\path\to\Input_File.xlsx"          # only used to read "Column Match_Tr"
OUTPUT_FILE_PATH    = r"C:\path\to\Territory_Buffer_Output.xlsx"

TERRITORY_CONFIG_TAB = "R_L_Territory"
COL_MATCH_TR_SHEET   = "Column Match_Tr"
MAPPING_FILE_COL      = "File"     # header name for export-side column in Column Match_Tr sheet
MAPPING_CONFIG_COL    = "Config"   # header name for config-side column in Column Match_Tr sheet

TERRITORY_MERGE_COLUMN = "Territory"
TERRITORY_MERGE_COLUMN_ALIASES = ["Territory", "ratingTerritory"]
TERRITORY_SHEET_PRIORITY = [TERRITORY_CONFIG_TAB, "ratingTerritory"]

TERRITORY_CAT_SUPPLEMENT_COLUMNS = [
    "Hurricane",
    "Reinsurance",
    "Capital",
    "WildFire",
    "Fixed",
]

DECIMAL_PLACES = None  # set an int here if you want numeric rounding before comparing, else None
# ==================================================================


# ------------------------------------------------------------------
# Styling (for the output workbook)
# ------------------------------------------------------------------
HEADER_FILL = PatternFill(start_color="00005A", end_color="00005A", fill_type="solid")
HEADER_FONT = Font(color="FFFFFF", bold=True, size=11, name="Calibri")
HEADER_ALIGN = Alignment(horizontal="left", vertical="center")
RED_HEADER_FILL = PatternFill(start_color="C00000", end_color="C00000", fill_type="solid")
RED_HEADER_FONT = Font(color="FFFFFF", bold=True, size=11, name="Calibri")
THIN_SIDE = Side(style="thin", color="B7B7B7")
THIN_BORDER = Border(left=THIN_SIDE, right=THIN_SIDE, top=THIN_SIDE, bottom=THIN_SIDE)


def style_header_cell(cell, red=False):
    cell.fill = RED_HEADER_FILL if red else HEADER_FILL
    cell.font = RED_HEADER_FONT if red else HEADER_FONT
    cell.alignment = HEADER_ALIGN
    cell.border = THIN_BORDER


def style_data_cell(cell):
    cell.border = THIN_BORDER
    cell.font = Font(name="Calibri", size=10)


def autofit_columns(ws, min_width=10, max_width=45):
    widths = {}
    for row in ws.iter_rows():
        for c in row:
            if c.value is None:
                continue
            widths[c.column] = max(widths.get(c.column, 0), len(str(c.value)))
    for col_idx, max_len in widths.items():
        ws.column_dimensions[get_column_letter(col_idx)].width = max(min_width, min(max_len + 3, max_width))


# ------------------------------------------------------------------
# Helpers (same logic as the main tool)
# ------------------------------------------------------------------
def clean_col(name):
    if name is None:
        return ""
    return re.sub(r"[^a-z0-9]", "", str(name).strip().lower())


def resolve_name(target, names):
    """Case/whitespace/punctuation-insensitive lookup. Returns the actual
    raw name from `names` if found, else None."""
    if target is None:
        return None
    tc = clean_col(target)
    for n in names:
        if clean_col(n) == tc:
            return n
    return None


def resolve_first_name(candidates, names):
    """Tries each candidate name in order, returns first that resolves."""
    for candidate in candidates:
        resolved = resolve_name(candidate, names)
        if resolved:
            return resolved
    return None


def find_sheet_name(wb, target):
    return resolve_name(target, wb.sheetnames)


def find_header_index(headers, target):
    target_clean = clean_col(target)
    for i, h in enumerate(headers):
        if clean_col(h) == target_clean:
            return i
    return None


def read_df(file_path, sheet_name, header_row=1):
    """Standard reader: header at given row, drops blank/Unnamed columns,
    drops fully-blank rows, everything read as string."""
    df = pd.read_excel(file_path, sheet_name=sheet_name, header=header_row - 1, dtype=str)
    df = df.loc[:, ~df.columns.astype(str).str.startswith("Unnamed")]
    df.columns = [str(c).strip() for c in df.columns]
    df = df.dropna(how="all").reset_index(drop=True)
    return df


def resolve_territory_sheet(wb):
    """Sheet-name priority: 'R_L_Territory' first, then 'ratingTerritory',
    else that workbook's first sheet. Fuzzy-matched, same as everywhere
    else in this tool."""
    for candidate in TERRITORY_SHEET_PRIORITY:
        resolved = find_sheet_name(wb, candidate)
        if resolved:
            return resolved
    return wb.sheetnames[0]


def build_synonym_groups(pairs):
    """pairs: list of (a, b) tuples meaning 'same field'. Chained
    transitively via union-find. Returns {clean_col(name): group_id}."""
    parent = {}

    def find(x):
        parent.setdefault(x, x)
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(x, y):
        rx, ry = find(x), find(y)
        if rx != ry:
            parent[rx] = ry

    for a, b in pairs:
        ca, cb = clean_col(a), clean_col(b)
        if not ca or not cb:
            continue
        find(ca)
        find(cb)
        union(ca, cb)

    return {k: find(k) for k in parent}


def load_mapping_pairs_from_sheet(wb, sheet_name, file_col_header, config_col_header):
    """Reads the 'Column Match_Tr' 2-column mapping sheet, returns list of
    (config_val, file_val) tuples. Returns [] (with a warning) if the sheet
    or headers can't be found -- this is a soft failure, not a crash."""
    resolved_name = find_sheet_name(wb, sheet_name)
    if resolved_name is None:
        print(f"WARNING: Sheet '{sheet_name}' not found in Input file "
              f"(available sheets: {wb.sheetnames}). Column mapping will be empty.")
        return []
    ws = wb[resolved_name]
    headers = [c.value for c in next(ws.iter_rows(min_row=1, max_row=1))]
    file_idx = find_header_index(headers, file_col_header)
    config_idx = find_header_index(headers, config_col_header)
    if file_idx is None or config_idx is None:
        print(f"WARNING: Could not find '{file_col_header}'/'{config_col_header}' headers "
              f"in '{sheet_name}' (found headers: {headers}). Column mapping will be empty.")
        return []
    pairs = []
    for row in ws.iter_rows(min_row=2, values_only=True):
        f, c = row[file_idx], row[config_idx]
        if f and c:
            pairs.append((str(c).strip(), str(f).strip()))
    return pairs


DEFAULT_DECIMAL_PLACES = 4


def round_half_up(value, decimals):
    try:
        d = Decimal(str(value))
    except (InvalidOperation, ValueError, TypeError):
        return value
    quant = Decimal("1").scaleb(-decimals) if decimals > 0 else Decimal("1")
    return float(d.quantize(quant, rounding=ROUND_HALF_UP))


def normalize_value(v, decimal_places=None):
    if v is None or (isinstance(v, float) and pd.isna(v)):
        return ""
    s = str(v).strip()
    dp = decimal_places if decimal_places is not None else DEFAULT_DECIMAL_PLACES
    try:
        f = round_half_up(float(s), dp)
        if f == int(f):
            return str(int(f))
        return f"{f:.{dp}f}".rstrip("0").rstrip(".")
    except ValueError:
        return s.lower()


# ------------------------------------------------------------------
# STEP 4: Build the buffer sheet
# ------------------------------------------------------------------
def build_territory_buffer_df(territory_df, cat_df,
                               supplement_columns=TERRITORY_CAT_SUPPLEMENT_COLUMNS,
                               merge_column=TERRITORY_MERGE_COLUMN):
    """
    Buffer sheet = exact copy of territory_df's columns/values, PLUS any of
    `supplement_columns` that are missing from territory_df, pulled from
    cat_df and joined on the Territory key (left join, so every Territory
    row is kept regardless of whether a CAT match exists).
    """
    buffer_df = territory_df.copy()

    # Which supplement columns does the Territory file NOT already have?
    missing_cols = [c for c in supplement_columns if resolve_name(c, buffer_df.columns) is None]
    if not missing_cols:
        print("Territory file already has all supplement columns -- CAT file not needed.")
        return buffer_df

    if cat_df is None:
        print(f"WARNING: No CAT file provided/readable -- buffer sheet will be MISSING "
              f"these columns: {missing_cols}")
        return buffer_df

    key_candidates = TERRITORY_MERGE_COLUMN_ALIASES if clean_col(merge_column) == clean_col(TERRITORY_MERGE_COLUMN) else [merge_column]

    terr_key = resolve_first_name(key_candidates, buffer_df.columns)
    cat_key = resolve_first_name(key_candidates, cat_df.columns)
    if not terr_key or not cat_key:
        tried = "/".join(key_candidates)
        print(f"WARNING: Could not find a '{tried}' column in BOTH the Territory file and "
              f"the CAT file -- buffer sheet will be MISSING these columns: {missing_cols}")
        print(f"  Territory file columns found: {list(buffer_df.columns)}")
        print(f"  CAT file columns found:       {list(cat_df.columns)}")
        return buffer_df

    # Which of the missing columns actually exist in the CAT file?
    cat_col_map = {c: resolve_name(c, cat_df.columns) for c in missing_cols}
    found_cols = {canon: resolved for canon, resolved in cat_col_map.items() if resolved}
    not_found = [canon for canon, resolved in cat_col_map.items() if not resolved]
    if not_found:
        print(f"WARNING: CAT file does not contain these expected column(s): {not_found}. "
              f"They will be MISSING from the buffer sheet.")

    if not found_cols:
        return buffer_df

    lookup_df = cat_df[[cat_key] + list(found_cols.values())].copy()
    rename_map = {resolved: canon for canon, resolved in found_cols.items()}
    rename_map[cat_key] = terr_key  # align key column name to Territory file's key name
    lookup_df = lookup_df.rename(columns=rename_map)

    print(f"Merging these columns from CAT file into buffer: {list(found_cols.keys())}")
    buffer_df = pd.merge(buffer_df, lookup_df, on=terr_key, how="left")
    return buffer_df


# ------------------------------------------------------------------
# STEP 6: Column matching + row comparison
# ------------------------------------------------------------------
def match_columns(config_cols, export_cols, synonym_groups=None):
    export_clean_map = {clean_col(c): c for c in export_cols}
    matched, unmatched = [], []
    for c in config_cols:
        cc = clean_col(c)
        if cc in export_clean_map:
            matched.append((c, export_clean_map[cc]))
            continue
        if synonym_groups and cc in synonym_groups:
            group_id = synonym_groups[cc]
            found = next((ec_raw for ec_clean, ec_raw in export_clean_map.items()
                          if synonym_groups.get(ec_clean) == group_id), None)
            if found:
                matched.append((c, found))
                continue
        unmatched.append(c)
    return matched, unmatched


def compare_rows(config_df, export_df, matched_cols, decimal_places=None):
    config_cols = [m[0] for m in matched_cols]
    export_cols = [m[1] for m in matched_cols]

    export_tuples = [tuple(normalize_value(v, decimal_places) for v in row)
                      for row in export_df[export_cols].itertuples(index=False)]
    config_tuples = [tuple(normalize_value(v, decimal_places) for v in row)
                      for row in config_df[config_cols].itertuples(index=False)]

    export_counter = Counter(export_tuples)
    unmatched_config_idx = []
    for i, t in enumerate(config_tuples):
        if export_counter.get(t, 0) > 0:
            export_counter[t] -= 1
        else:
            unmatched_config_idx.append(i)

    unmatched_export_idx = []
    leftover = export_counter
    for i, t in enumerate(export_tuples):
        if leftover.get(t, 0) > 0:
            unmatched_export_idx.append(i)
            leftover[t] -= 1

    return config_df.iloc[unmatched_config_idx].copy(), export_df.iloc[unmatched_export_idx].copy()


def compare_config_to_buffer(config_df, buffer_df, synonym_groups, decimal_places=None):
    matched_cols, unmatched_config_cols = match_columns(
        list(config_df.columns), list(buffer_df.columns), synonym_groups
    )
    matched_export_set = {e for _, e in matched_cols}
    unmatched_export_cols = [c for c in buffer_df.columns if c not in matched_export_set]

    print("\n--- COLUMN MATCH RESULTS ---")
    for c_col, e_col in matched_cols:
        tag = " (via mapping)" if clean_col(c_col) != clean_col(e_col) else ""
        print(f"  MATCHED: Config '{c_col}'  <->  Buffer '{e_col}'{tag}")
    if unmatched_config_cols:
        print(f"  UNMATCHED (Config side): {unmatched_config_cols}")
    if unmatched_export_cols:
        print(f"  UNMATCHED (Buffer side): {unmatched_export_cols}")

    if unmatched_config_cols or unmatched_export_cols:
        print("\nRESULT: Manual validation required (column mismatch) -- full tables will be output.")
        return {
            "result": "Manual validation required",
            "matched_cols": matched_cols,
            "unmatched_config_cols": unmatched_config_cols,
            "unmatched_export_cols": unmatched_export_cols,
            "detail_config_df": config_df,
            "detail_export_df": buffer_df,
        }

    diff_config, diff_export = compare_rows(config_df, buffer_df, matched_cols, decimal_places)
    if len(diff_config) == 0 and len(diff_export) == 0:
        result = "Validated - All Rows Match"
    else:
        result = "Manual validation required"
    print(f"\nRESULT: {result}")
    print(f"  Config unmatched rows: {len(diff_config)}")
    print(f"  Buffer unmatched rows: {len(diff_export)}")

    return {
        "result": result,
        "matched_cols": matched_cols,
        "unmatched_config_cols": [],
        "unmatched_export_cols": [],
        "detail_config_df": diff_config,
        "detail_export_df": diff_export,
    }


# ------------------------------------------------------------------
# Output workbook writer
# ------------------------------------------------------------------
def write_output(buffer_df, comparison, out_path):
    wb = Workbook()
    default_sheet = wb.active

    # Sheet 1: the buffer sheet itself, so you can eyeball it.
    ws_buffer = wb.create_sheet("Territory_Buffer")
    ws_buffer.append(list(buffer_df.columns))
    for col in range(1, len(buffer_df.columns) + 1):
        style_header_cell(ws_buffer.cell(row=1, column=col))
    for row in buffer_df.itertuples(index=False):
        ws_buffer.append(list(row))
    for r in range(2, ws_buffer.max_row + 1):
        for c in range(1, len(buffer_df.columns) + 1):
            style_data_cell(ws_buffer.cell(row=r, column=c))
    ws_buffer.freeze_panes = "A2"
    autofit_columns(ws_buffer)

    # Sheet 2: comparison detail
    ws_cmp = wb.create_sheet("Config_vs_Buffer")
    cfg_df = comparison["detail_config_df"]
    exp_df = comparison["detail_export_df"]
    red_cfg = set(comparison["unmatched_config_cols"])
    red_exp = set(comparison["unmatched_export_cols"])

    left_width = max(len(cfg_df.columns), 1)
    start_col_right = left_width + 3

    ws_cmp.cell(row=1, column=1, value=f"Config 'R_L_Territory' ({comparison['result']})")
    for j, col in enumerate(cfg_df.columns, start=1):
        style_header_cell(ws_cmp.cell(row=2, column=j, value=col), red=(col in red_cfg))
    for i, row in enumerate(cfg_df.itertuples(index=False), start=3):
        for j, val in enumerate(row, start=1):
            style_data_cell(ws_cmp.cell(row=i, column=j, value=val))

    ws_cmp.cell(row=1, column=start_col_right, value="Buffer (Territory + CAT)")
    for j, col in enumerate(exp_df.columns, start=start_col_right):
        style_header_cell(ws_cmp.cell(row=2, column=j, value=col), red=(col in red_exp))
    for i, row in enumerate(exp_df.itertuples(index=False), start=3):
        for j, val in enumerate(row, start=start_col_right):
            style_data_cell(ws_cmp.cell(row=i, column=j, value=val))

    ws_cmp.freeze_panes = "A3"
    autofit_columns(ws_cmp)

    wb.remove(default_sheet)
    os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
    wb.save(out_path)
    print(f"\nOutput saved to: {out_path}")


# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------
def main():
    try:
        print(f"Reading Config tab '{TERRITORY_CONFIG_TAB}' from: {CONFIG_FILE_PATH}")
        config_wb = load_workbook(CONFIG_FILE_PATH, data_only=True)
        resolved_cfg_tab = resolve_name(TERRITORY_CONFIG_TAB, config_wb.sheetnames)
        if not resolved_cfg_tab:
            raise ValueError(f"Could not find a tab matching '{TERRITORY_CONFIG_TAB}' in Config file. "
                              f"Available tabs: {config_wb.sheetnames}")
        config_df = read_df(CONFIG_FILE_PATH, resolved_cfg_tab, 1)
        print(f"  Config columns: {list(config_df.columns)}  ({len(config_df)} rows)")

        print(f"\nReading Territory file: {TERRITORY_FILE_PATH}")
        terr_wb = load_workbook(TERRITORY_FILE_PATH, data_only=True)
        terr_sheet = resolve_territory_sheet(terr_wb)
        territory_df = read_df(TERRITORY_FILE_PATH, terr_sheet, 1)
        print(f"  Using sheet '{terr_sheet}'. Columns: {list(territory_df.columns)}  ({len(territory_df)} rows)")

        cat_df = None
        if CAT_FILE_PATH:
            print(f"\nReading CAT file: {CAT_FILE_PATH}")
            cat_wb = load_workbook(CAT_FILE_PATH, data_only=True)
            cat_sheet = resolve_territory_sheet(cat_wb)
            cat_df = read_df(CAT_FILE_PATH, cat_sheet, 1)
            print(f"  Using sheet '{cat_sheet}'. Columns: {list(cat_df.columns)}  ({len(cat_df)} rows)")
        else:
            print("\nNo CAT file path given -- skipping CAT merge.")

        print("\nBuilding buffer sheet...")
        buffer_df = build_territory_buffer_df(territory_df, cat_df)
        print(f"  Final buffer columns: {list(buffer_df.columns)}  ({len(buffer_df)} rows)")

        print(f"\nLoading column mapping from '{COL_MATCH_TR_SHEET}' in Input file: {INPUT_FILE_PATH}")
        input_wb = load_workbook(INPUT_FILE_PATH, data_only=True)
        tr_pairs = load_mapping_pairs_from_sheet(input_wb, COL_MATCH_TR_SHEET, MAPPING_FILE_COL, MAPPING_CONFIG_COL)
        tr_synonyms = build_synonym_groups(tr_pairs)
        print(f"  Loaded {len(tr_pairs)} mapping pair(s).")

        comparison = compare_config_to_buffer(config_df, buffer_df, tr_synonyms, DECIMAL_PLACES)

        write_output(buffer_df, comparison, OUTPUT_FILE_PATH)

    except Exception as e:
        print("\n" + "=" * 70)
        print("ERROR -- processing failed. Full traceback below:")
        print("=" * 70)
        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
