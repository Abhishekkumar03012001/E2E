Option Explicit

'====================================================================
' PUBLIC ENTRY POINTS
'====================================================================

' Run this if you want a file-picker dialog experience
Public Sub RunSyncWithDialog()
    Dim configPath As String, exportPath As String
    configPath = BrowseForFile("Select CONFIG Excel file")
    If configPath = "" Then Exit Sub
    exportPath = BrowseForFile("Select EXPORT Excel file")
    If exportPath = "" Then Exit Sub
    SyncConfigWithExport configPath, exportPath
End Sub

' Call this directly from another module:
'   Call ModSheetSync.SyncConfigWithExport("C:\...\Config.xlsx", "C:\...\Export.xlsx")
Public Sub SyncConfigWithExport(ByVal ConfigPath As String, ByVal ExportPath As String)
    On Error GoTo ErrHandler

    Dim wbConfig As Workbook, wbExport As Workbook
    Dim wsMaster As Worksheet
    Dim configNames As Collection, exportNames As Collection
    Dim matchedExport As Object
    Dim i As Long, masterRow As Long
    Dim cfgName As String, expMatch As String, expName As String
    Dim newConfigPath As String

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.Calculation = xlCalculationManual
    Application.AskToUpdateLinks = False

    Set wbConfig = Workbooks.Open(ConfigPath, UpdateLinks:=0, ReadOnly:=False, IgnoreReadOnlyRecommended:=True)
    Set wbExport = Workbooks.Open(ExportPath, UpdateLinks:=0, ReadOnly:=False, IgnoreReadOnlyRecommended:=True)

    Set configNames = GetOrderedSheetNames(wbConfig)
    Set exportNames = GetOrderedSheetNames(wbExport)

    Set matchedExport = CreateObject("Scripting.Dictionary")
    matchedExport.CompareMode = 1 ' vbTextCompare

    ' Master Sheet lives in THIS workbook (the one running the code), refreshed every run
    Set wsMaster = ResetMasterSheet(ThisWorkbook)
    masterRow = 2

    ' STEP 1: Walk CONFIG sheets in order (skip ignored) -> Case 1 (name matches Export)
    For i = 1 To configNames.Count
        cfgName = configNames(i)
        expMatch = FindMatch(cfgName, exportNames)
        If expMatch <> "" Then
            matchedExport(expMatch) = True
            ProcessCase1 wbConfig, wbExport, cfgName, expMatch, wsMaster, masterRow
            masterRow = masterRow + 1
        End If
    Next i

    ' STEP 2: Walk EXPORT sheets in order (skip ignored) -> Case 2 (only in Export)
    For i = 1 To exportNames.Count
        expName = exportNames(i)
        If Not matchedExport.Exists(expName) Then
            ProcessCase2 wbConfig, wbExport, expName, wsMaster, masterRow
            masterRow = masterRow + 1
        End If
    Next i

    ' Autofit Master Sheet columns
    wsMaster.Columns("A:E").AutoFit

    ' Save Config as "<OriginalName> Updated factors.<ext>" - silently overwrite if exists
    newConfigPath = BuildUpdatedFactorsPath(ConfigPath)
    wbConfig.SaveAs Filename:=newConfigPath, FileFormat:=wbConfig.FileFormat, ConflictResolution:=xlLocalSessionChanges

    wbConfig.Close SaveChanges:=False
    wbExport.Close SaveChanges:=False

    ' Save ThisWorkbook (to persist the refreshed Master Sheet), if it's a saved file
    If ThisWorkbook.Path <> "" Then
        ThisWorkbook.Save
    End If

    Application.AskToUpdateLinks = True
    Application.Calculation = xlCalculationAutomatic
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    MsgBox "Done", vbInformation
    Exit Sub

ErrHandler:
    Application.AskToUpdateLinks = True
    Application.Calculation = xlCalculationAutomatic
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    MsgBox "Error: " & Err.Description, vbCritical
End Sub


'====================================================================
' CASE 1: Sheet exists in both Config and Export
'====================================================================
Private Sub ProcessCase1(ByVal wbConfig As Workbook, ByVal wbExport As Workbook, _
    ByVal cfgName As String, ByVal expName As String, ByVal wsMaster As Worksheet, ByVal masterRow As Long)

    Dim wsCfg As Worksheet, wsExp As Worksheet
    Dim cfgHeaders As Object, expHeaders As Object
    Dim cfgLastCol As Long, expLastCol As Long
    Dim cfgLastRow As Long, expLastRow As Long
    Dim existingFormattedRows As Long, exportDataCount As Long
    Dim subCase As Integer
    Dim missingCols As String, extraCols As String
    Dim k As Variant
    Dim cfgCol As Long, expCol As Long
    Dim colsCopied As Long, dataRowsCopied As Long

    Set wsCfg = wbConfig.Sheets(cfgName)
    Set wsExp = wbExport.Sheets(expName)

    wsMaster.Cells(masterRow, 1).Value = expName
    wsMaster.Cells(masterRow, 2).Value = cfgName

    cfgLastCol = GetLastCol(wsCfg)
    expLastCol = GetLastCol(wsExp)

    ' --- ORIGINAL (kept for reference, now replaced by alias-aware version below) ---
    ' Set cfgHeaders = GetHeaderMap(wsCfg, cfgLastCol)
    ' Set expHeaders = GetHeaderMap(wsExp, expLastCol)

    ' UPDATED: pass sheet name so specific sheets can alias
    ' "Coverage Amount(Dollar or Percent)" -> "Coverage Amount(Dollar)"
    Set cfgHeaders = GetHeaderMap(wsCfg, cfgLastCol, cfgName)
    Set expHeaders = GetHeaderMap(wsExp, expLastCol, expName)

    ' Columns in Config not present in Export
    missingCols = ""
    For Each k In cfgHeaders.Keys
        If Not expHeaders.Exists(k) Then
            If missingCols <> "" Then missingCols = missingCols & ", "
            missingCols = missingCols & GetOriginalHeaderName(wsCfg, cfgHeaders(k))
        End If
    Next k

    ' Columns in Export not present in Config
    extraCols = ""
    For Each k In expHeaders.Keys
        If Not cfgHeaders.Exists(k) Then
            If extraCols <> "" Then extraCols = extraCols & ", "
            extraCols = extraCols & GetOriginalHeaderName(wsExp, expHeaders(k))
        End If
    Next k

    If missingCols = "" And extraCols = "" Then
        subCase = 1        ' exact column match
    ElseIf missingCols = "" And extraCols <> "" Then
        subCase = 2        ' Config's columns are all present in Export; Export has extra columns
    Else
        subCase = 3         ' Config has columns that Export doesn't have -> don't copy
    End If

    Select Case subCase

        Case 1, 2
            expLastRow = GetLastRow(wsExp)
            exportDataCount = expLastRow - 1
            If exportDataCount < 0 Then exportDataCount = 0

            cfgLastRow = GetLastRow(wsCfg)
            existingFormattedRows = cfgLastRow - 1
            If existingFormattedRows < 0 Then existingFormattedRows = 0

            ' Clear old data (values only - keeps formatting/number format/alignment)
            If cfgLastRow >= 2 Then
                wsCfg.Range(wsCfg.Cells(2, 1), wsCfg.Cells(cfgLastRow, cfgLastCol)).ClearContents
            End If

            ' If Export has MORE data rows than Config originally had, extend the
            ' original row formatting (number format, alignment, borders, etc.)
            ' downward from the last previously-formatted row.
            If exportDataCount > existingFormattedRows Then
                If existingFormattedRows > 0 Then
                    wsCfg.Rows(existingFormattedRows + 1).Copy
                    wsCfg.Range(wsCfg.Rows(existingFormattedRows + 2), wsCfg.Rows(1 + exportDataCount)).PasteSpecial xlPasteFormats
                    Application.CutCopyMode = False
                End If
            End If

            ' Paste values column-by-column, matched by header name (Export columns not in Config are simply skipped)
            colsCopied = 0
            For Each k In cfgHeaders.Keys
                If expHeaders.Exists(k) Then
                    cfgCol = cfgHeaders(k)
                    expCol = expHeaders(k)
                    If exportDataCount > 0 Then
                        wsCfg.Range(wsCfg.Cells(2, cfgCol), wsCfg.Cells(1 + exportDataCount, cfgCol)).Value = _
                            wsExp.Range(wsExp.Cells(2, expCol), wsExp.Cells(1 + exportDataCount, expCol)).Value
                    End If
                    colsCopied = colsCopied + 1
                End If
            Next k

            dataRowsCopied = exportDataCount

            If subCase = 1 Then
                wsMaster.Cells(masterRow, 3).Value = "Validated"
                wsMaster.Cells(masterRow, 3).Interior.ColorIndex = xlColorIndexNone
            Else
                wsMaster.Cells(masterRow, 3).Value = "Extra column in exports: " & extraCols
                wsMaster.Cells(masterRow, 3).Interior.Color = RGB(255, 199, 206) ' light red
            End If

            wsMaster.Cells(masterRow, 4).Value = dataRowsCopied
            wsMaster.Cells(masterRow, 5).Value = colsCopied

        Case 3
            wsMaster.Cells(masterRow, 3).Value = "Values not copied and Columns are missing: " & missingCols
            wsMaster.Cells(masterRow, 3).Interior.Color = RGB(255, 199, 206) ' light red
            wsMaster.Cells(masterRow, 4).Value = 0
            wsMaster.Cells(masterRow, 5).Value = 0

    End Select
End Sub


