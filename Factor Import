' UPDATED: now accepts the sheet name so header aliasing can be applied
' for specific sheets (see ApplyHeaderAlias below). Matching still happens
' on the (possibly aliased) header name, case-insensitively.
Private Function GetHeaderMap(ByVal ws As Worksheet, ByVal lastCol As Long, Optional ByVal sheetName As String = "") As Object
    Dim dict As Object
    Dim c As Long, hName As String, mappedName As String
    Set dict = CreateObject("Scripting.Dictionary")
    dict.CompareMode = 1 ' vbTextCompare
    For c = 1 To lastCol
        hName = Trim(CStr(ws.Cells(1, c).Value))
        If hName <> "" Then
            mappedName = ApplyHeaderAlias(sheetName, hName)
            If Not dict.Exists(LCase(mappedName)) Then
                dict.Add LCase(mappedName), c
            End If
        End If
    Next c
    Set GetHeaderMap = dict
End Function

' NEW: header alias logic.
' For sheets R_O_WaterBackup_Contents and R_O_WaterBackup_Listed,
' treat "Coverage Amount(Dollar or Percent)" the same as "Coverage Amount(Dollar)"
' so the two columns are matched/mapped to each other during sync.
Private Function ApplyHeaderAlias(ByVal sheetName As String, ByVal headerName As String) As String
    Dim targetSheets As Variant, i As Long
    Dim isTargetSheet As Boolean

    targetSheets = Array("R_O_WaterBackup_Contents", "R_O_WaterBackup_Listed")
    isTargetSheet = False
    For i = LBound(targetSheets) To UBound(targetSheets)
        If StrComp(Trim(sheetName), targetSheets(i), vbTextCompare) = 0 Then
            isTargetSheet = True
            Exit For
        End If
    Next i

    If isTargetSheet Then
        If StrComp(Trim(headerName), "Coverage Amount(Dollar or Percent)", vbTextCompare) = 0 Then
            ApplyHeaderAlias = "Coverage Amount(Dollar)"
            Exit Function
        End If
    End If

    ApplyHeaderAlias = headerName
End Function

Private Function GetOriginalHeaderName(ByVal ws As Worksheet, ByVal colIndex As Long) As String
    GetOriginalHeaderName = CStr(ws.Cells(1, colIndex).Value)
End Function

Private Function GetLastRow(ByVal ws As Worksheet) As Long
    On Error Resume Next
    GetLastRow = ws.Cells.Find(What:="*", After:=ws.Cells(1, 1), _
        LookIn:=xlFormulas, LookAt:=xlPart, SearchOrder:=xlByRows, _
        SearchDirection:=xlPrevious, MatchCase:=False).Row
    If Err.Number <> 0 Or GetLastRow = 0 Then GetLastRow = 1
    On Error GoTo 0
End Function

Private Function GetLastCol(ByVal ws As Worksheet) As Long
    On Error Resume Next
    GetLastCol = ws.Cells.Find(What:="*", After:=ws.Cells(1, 1), _
        LookIn:=xlFormulas, LookAt:=xlPart, SearchOrder:=xlByColumns, _
        SearchDirection:=xlPrevious, MatchCase:=False).Column
    If Err.Number <> 0 Or GetLastCol = 0 Then GetLastCol = 1
    On Error GoTo 0
End Function

Private Function LastNonMasterSheetName(ByVal wb As Workbook) As String
    Dim ws As Worksheet, lastName As String
    For Each ws In wb.Worksheets
        If LCase(ws.Name) <> "master sheet" Then lastName = ws.Name
    Next ws
    LastNonMasterSheetName = lastName
End Function

' Builds "<folder>\<OriginalConfigName> Updated factors.<ext>"
Private Function BuildUpdatedFactorsPath(ByVal originalPath As String) As String
    Dim folderPath As String, fileName As String, baseName As String, ext As String
    Dim dotPos As Long, slashPos As Long

    slashPos = InStrRev(originalPath, "\")
    folderPath = Left(originalPath, slashPos)
    fileName = Mid(originalPath, slashPos + 1)

    dotPos = InStrRev(fileName, ".")
    If dotPos > 0 Then
        baseName = Left(fileName, dotPos - 1)
        ext = Mid(fileName, dotPos + 1)
    Else
        baseName = fileName
        ext = "xlsx"
    End If

    BuildUpdatedFactorsPath = folderPath & baseName & " Updated factors." & ext
End Function
