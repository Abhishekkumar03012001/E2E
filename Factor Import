Option Explicit

'====================================================================
' MAIN ENTRY POINT — call this from another Sub/UserForm
' Example: Call RunSheetQC("C:\Files\Config.xlsx", "C:\Files\Export.xlsx")
'====================================================================
Public Sub RunSheetQC(ByVal configFilePath As String, ByVal exportFilePath As String)

    Dim wbConfig As Workbook, wbExport As Workbook
    Dim wsQC As Worksheet
    Dim lastRow As Long, i As Long
    Dim exportSheetName As String, configSheetName As String, yesNo As String
    Dim appAlerts As Boolean, appScreen As Boolean, appEvents As Boolean
    Dim appCalc As XlCalculation

    With Application
        appAlerts = .DisplayAlerts
        appScreen = .ScreenUpdating
        appEvents = .EnableEvents
        appCalc = .Calculation
        .DisplayAlerts = False
        .ScreenUpdating = False
        .EnableEvents = False
        .Calculation = xlCalculationManual
    End With

    Set wsQC = ThisWorkbook.Sheets("Additional Tabs QC")

    Set wbConfig = Workbooks.Open(Filename:=configFilePath, ReadOnly:=True, _
                                   UpdateLinks:=0, IgnoreReadOnlyRecommended:=True)
    Set wbExport = Workbooks.Open(Filename:=exportFilePath, ReadOnly:=True, _
                                   UpdateLinks:=0, IgnoreReadOnlyRecommended:=True)

    lastRow = wsQC.Cells(wsQC.Rows.Count, "A").End(xlUp).Row
    If wsQC.Cells(wsQC.Rows.Count, "B").End(xlUp).Row > lastRow Then
        lastRow = wsQC.Cells(wsQC.Rows.Count, "B").End(xlUp).Row
    End If

    For i = 2 To lastRow

        exportSheetName = Trim(CStr(wsQC.Cells(i, "A").Value))
        configSheetName = Trim(CStr(wsQC.Cells(i, "B").Value))
        yesNo = Trim(CStr(wsQC.Cells(i, "C").Value))

        ' Reset previous run's output/highlighting for this row
        wsQC.Range(wsQC.Cells(i, "D"), wsQC.Cells(i, "G")).ClearContents
        wsQC.Cells(i, "D").Interior.ColorIndex = xlColorIndexNone
        wsQC.Cells(i, "A").Interior.ColorIndex = xlColorIndexNone
        wsQC.Cells(i, "B").Interior.ColorIndex = xlColorIndexNone

        ' --- Empty name check (overrides everything, always checked first) ---
        Dim aEmpty As Boolean, bEmpty As Boolean
        aEmpty = (exportSheetName = "")
        bEmpty = (configSheetName = "")

        If aEmpty Or bEmpty Then
            If aEmpty Then Call SetCellColor(wsQC.Cells(i, "A"), "Yellow")
            If bEmpty Then Call SetCellColor(wsQC.Cells(i, "B"), "Yellow")

            If aEmpty And bEmpty Then
                wsQC.Cells(i, "D").Value = "Export and Config sheet names are empty"
            ElseIf aEmpty Then
                wsQC.Cells(i, "D").Value = "Export sheet name is empty"
            Else
                wsQC.Cells(i, "D").Value = "Config sheet name is empty"
            End If

            wsQC.Cells(i, "E").Value = "NA"
            wsQC.Cells(i, "F").Value = "NA"
            wsQC.Cells(i, "G").Value = "NA"
            GoTo NextRow
        End If

        If UCase(yesNo) = "NO" Then
            wsQC.Cells(i, "D").Value = "Skipped"
            GoTo NextRow
        ElseIf UCase(yesNo) <> "YES" Then
            wsQC.Cells(i, "D").Value = "Skipped"
            GoTo NextRow
        End If

        ' --- Blocked sheet name check (case-insensitive) ---
        If StrComp(configSheetName, "R_L_Territory", vbTextCompare) = 0 Then
            wsQC.Cells(i, "D").Value = "Unable to copy"
            wsQC.Cells(i, "E").Value = "NA"
            wsQC.Cells(i, "F").Value = "NA"
            wsQC.Cells(i, "G").Value = "NA"
            GoTo NextRow
        End If

        On Error GoTo RowError
        Call ProcessRow(wsQC, i, wbConfig, wbExport, exportSheetName, configSheetName)
        GoTo NextRow

RowError:
        wsQC.Cells(i, "D").Value = "Error: " & Err.Description
        Resume NextRow

NextRow:
        On Error GoTo 0
    Next i

    ' Save Config workbook as a new file: "<OriginalName> updated.<ext>"
    Dim newPath As String
    newPath = BuildUpdatedPath(configFilePath)
    wbConfig.SaveAs Filename:=newPath, FileFormat:=wbConfig.FileFormat

    wbExport.Close SaveChanges:=False
    wbConfig.Close SaveChanges:=False

    With Application
        .DisplayAlerts = appAlerts
        .ScreenUpdating = appScreen
        .EnableEvents = appEvents
        .Calculation = appCalc
    End With

End Sub


'====================================================================
' PROCESS ONE ROW OF THE QC SHEET
'====================================================================
Private Sub ProcessRow(wsQC As Worksheet, r As Long, wbConfig As Workbook, wbExport As Workbook, _
                        exportName As String, configName As String)

    Dim foundExport As Boolean, foundConfig As Boolean
    Dim wsExportMatch As Worksheet, wsConfigMatch As Worksheet

    foundExport = False
    If exportName <> "" Then
        Set wsExportMatch = GetSheetByNameCI(wbExport, exportName)
        foundExport = Not wsExportMatch Is Nothing
    End If

    foundConfig = False
    If configName <> "" Then
        Set wsConfigMatch = GetSheetByNameCI(wbConfig, configName)
        foundConfig = Not wsConfigMatch Is Nothing
    End If

    ' ---------- CASE 4: neither found ----------
    If Not foundExport And Not foundConfig Then
        wsQC.Cells(r, "D").Value = "Invalid Sheet Names"
        wsQC.Cells(r, "E").Value = "NA"
        wsQC.Cells(r, "F").Value = "NA"
        wsQC.Cells(r, "G").Value = "NA"
        Exit Sub
    End If

    ' ---------- CASE 2: not found in Export ----------
    If Not foundExport And foundConfig Then
        wsQC.Cells(r, "D").Value = "Not found in Export"
        wsQC.Cells(r, "E").Value = "NA"
        wsQC.Cells(r, "F").Value = "NA"
        wsQC.Cells(r, "G").Value = "NA"
        Exit Sub
    End If

    ' ---------- CASE 3: not found in Config -> copy whole Export sheet in ----------
    If foundExport And Not foundConfig Then
        Dim wsExp As Worksheet
        Set wsExp = wsExportMatch

        Dim desiredName As String
        If configName = "" Then
            desiredName = "Empty Sheet Name"
        Else
            desiredName = configName
        End If
        Dim finalName As String
        finalName = GetUniqueSheetName(wbConfig, desiredName)

        Call InsertCopiedSheet(wbConfig, wsExp, finalName)

        Dim wsNew As Worksheet
        Set wsNew = wbConfig.Sheets(finalName)

        Dim ncol As Long, nrow As Long
        ncol = GetLastColumn(wsNew)
        nrow = GetLastRow(wsNew, ncol) - 1
        If nrow < 0 Then nrow = 0

        wsQC.Cells(r, "D").Value = "New sheet added as '" & finalName & "'"
        wsQC.Cells(r, "E").Value = ncol
        wsQC.Cells(r, "F").Value = ncol
        wsQC.Cells(r, "G").Value = nrow
        Exit Sub
    End If

    ' ---------- CASE 1: both found ----------
    Dim wsExport As Worksheet, wsConfig As Worksheet
    Set wsExport = wsExportMatch
    Set wsConfig = wsConfigMatch

    Dim exportColCount As Long, configColCount As Long
    exportColCount = GetLastColumn(wsExport)
    configColCount = GetLastColumn(wsConfig)

    wsQC.Cells(r, "E").Value = exportColCount
    wsQC.Cells(r, "F").Value = configColCount

    If exportColCount = 0 And configColCount = 0 Then
        wsQC.Cells(r, "D").Value = "Both sheets appear empty (no headers found)"
        wsQC.Cells(r, "G").Value = 0
        Exit Sub
    End If

    Dim exportLastRow As Long, configLastRow As Long
    exportLastRow = GetLastRow(wsExport, exportColCount)
    configLastRow = GetLastRow(wsConfig, configColCount)

    Dim exportHeaders() As String, configHeaders() As String
    exportHeaders = GetHeaders(wsExport, exportColCount)
    configHeaders = GetHeaders(wsConfig, configColCount)

    Dim c As Long

    If exportColCount = configColCount And exportColCount > 0 Then
        '---- Same column count: positional header comparison ----
        Dim mismatchIdx() As Long, mismatchCount As Long
        ReDim mismatchIdx(1 To configColCount)
        mismatchCount = 0
        For c = 1 To configColCount
            If StrComp(exportHeaders(c), configHeaders(c), vbTextCompare) <> 0 Then
                mismatchCount = mismatchCount + 1
                mismatchIdx(mismatchCount) = c
            End If
        Next c

        If mismatchCount = 0 Then
            ' Subcase 1
            For c = 1 To configColCount
                Call CopyColumnValues(wsConfig, c, wsExport, c, configLastRow, exportLastRow)
            Next c
            wsQC.Cells(r, "D").Value = "Values Copied"
            Call SetCellColor(wsQC.Cells(r, "D"), "Green")
            wsQC.Cells(r, "G").Value = IIf(exportLastRow >= 2, exportLastRow - 1, 0)

        ElseIf mismatchCount = 1 Then
            ' Subcase 2
            For c = 1 To configColCount
                Call CopyColumnValues(wsConfig, c, wsExport, c, configLastRow, exportLastRow)
            Next c
            Dim mi As Long
            mi = mismatchIdx(1)
            wsQC.Cells(r, "D").Value = "Values Copied-" & exportHeaders(mi) & " & " & configHeaders(mi) & " are mapped"
            Call SetCellColor(wsQC.Cells(r, "D"), "Green")
            wsQC.Cells(r, "G").Value = IIf(exportLastRow >= 2, exportLastRow - 1, 0)

        Else
            ' Subcase 3
            Dim mismatchNames As String
            mismatchNames = ""
            For c = 1 To mismatchCount
                If mismatchNames <> "" Then mismatchNames = mismatchNames & ", "
                mismatchNames = mismatchNames & configHeaders(mismatchIdx(c))
            Next c
            wsQC.Cells(r, "D").Value = "Values not copied- " & mismatchNames
            Call SetCellColor(wsQC.Cells(r, "D"), "Red")
            wsQC.Cells(r, "G").Value = 0
        End If

    ElseIf configColCount < exportColCount Then
        '---- Subcase 4 candidate: Config columns subset of Export columns ----
        Dim allConfigFound As Boolean
        allConfigFound = True
        For c = 1 To configColCount
            If IndexOfHeader(exportHeaders, configHeaders(c)) = -1 Then
                allConfigFound = False
                Exit For
            End If
        Next c

        If allConfigFound Then
            For c = 1 To configColCount
                Dim expIdx As Long
                expIdx = IndexOfHeader(exportHeaders, configHeaders(c))
                Call CopyColumnValues(wsConfig, c, wsExport, expIdx, configLastRow, exportLastRow)
            Next c

            Dim extraNames As String, nextCol As Long
            extraNames = ""
            nextCol = configColCount + 1
            For c = 1 To exportColCount
                If IndexOfHeader(configHeaders, exportHeaders(c)) = -1 Then
                    Call AddExtraColumnFromExport(wsConfig, nextCol, wsExport, c, exportLastRow)
                    If extraNames <> "" Then extraNames = extraNames & ", "
                    extraNames = extraNames & exportHeaders(c)
                    nextCol = nextCol + 1
                End If
            Next c

            wsQC.Cells(r, "D").Value = "Values Copied - extra " & extraNames & " in export has been copied"
            Call SetCellColor(wsQC.Cells(r, "D"), "Green")
            wsQC.Cells(r, "G").Value = IIf(exportLastRow >= 2, exportLastRow - 1, 0)
            wsQC.Cells(r, "F").Value = GetLastColumn(wsConfig)
        Else
            wsQC.Cells(r, "D").Value = "Values not copied- Column headers do not align between Config and Export"
            Call SetCellColor(wsQC.Cells(r, "D"), "Red")
            wsQC.Cells(r, "G").Value = 0
        End If

    Else
        '---- Subcase 5 candidate: Export columns subset of Config columns ----
        Dim allExportFound As Boolean
        allExportFound = True
        For c = 1 To exportColCount
            If IndexOfHeader(configHeaders, exportHeaders(c)) = -1 Then
                allExportFound = False
                Exit For
            End If
        Next c

        If allExportFound Then
            Dim extraConfigNames As String
            extraConfigNames = ""
            For c = 1 To configColCount
                If IndexOfHeader(exportHeaders, configHeaders(c)) = -1 Then
                    If extraConfigNames <> "" Then extraConfigNames = extraConfigNames & ", "
                    extraConfigNames = extraConfigNames & configHeaders(c)
                End If
            Next c
            wsQC.Cells(r, "D").Value = "Unable to copy because of " & extraConfigNames & " Columns in Config"
            Call SetCellColor(wsQC.Cells(r, "D"), "Red")
            wsQC.Cells(r, "G").Value = 0
        Else
            wsQC.Cells(r, "D").Value = "Values not copied- Column headers do not align between Config and Export"
            Call SetCellColor(wsQC.Cells(r, "D"), "Red")
            wsQC.Cells(r, "G").Value = 0
        End If
    End If

End Sub


'====================================================================
' COPY A SINGLE COLUMN'S VALUES (clears old Config values, keeps Config's
' original number format / alignment, writes new values from Export)
'====================================================================
Private Sub CopyColumnValues(wsConfig As Worksheet, configCol As Long, wsExport As Worksheet, exportCol As Long, _
                              oldConfigLastRow As Long, exportLastRow As Long)

    Dim sampleFmt As String, sampleAlign As Long
    If oldConfigLastRow >= 2 Then
        sampleFmt = wsConfig.Cells(2, configCol).NumberFormat
        sampleAlign = wsConfig.Cells(2, configCol).HorizontalAlignment
    Else
        sampleFmt = "General"
        sampleAlign = xlGeneral
    End If

    If oldConfigLastRow >= 2 Then
        wsConfig.Range(wsConfig.Cells(2, configCol), wsConfig.Cells(oldConfigLastRow, configCol)).ClearContents
    End If

    If exportLastRow >= 2 Then
        Dim srcRange As Range, destRange As Range
        Set srcRange = wsExport.Range(wsExport.Cells(2, exportCol), wsExport.Cells(exportLastRow, exportCol))
        Set destRange = wsConfig.Range(wsConfig.Cells(2, configCol), wsConfig.Cells(exportLastRow, configCol))
        destRange.Value = srcRange.Value
        destRange.NumberFormat = sampleFmt
        destRange.HorizontalAlignment = sampleAlign
    End If

End Sub


'====================================================================
' ADD A NEW COLUMN TO CONFIG COPIED (fully, incl. format) FROM EXPORT
'====================================================================
Private Sub AddExtraColumnFromExport(wsConfig As Worksheet, targetCol As Long, wsExport As Worksheet, _
                                      exportCol As Long, exportLastRow As Long)
    Dim lastR As Long
    lastR = exportLastRow
    If lastR < 1 Then lastR = 1
    Dim srcRange As Range, destRange As Range
    Set srcRange = wsExport.Range(wsExport.Cells(1, exportCol), wsExport.Cells(lastR, exportCol))
    Set destRange = wsConfig.Range(wsConfig.Cells(1, targetCol), wsConfig.Cells(lastR, targetCol))
    srcRange.Copy
    destRange.PasteSpecial xlPasteAll
    Application.CutCopyMode = False
End Sub


'====================================================================
' INSERT A COPIED SHEET AT THE CORRECT POSITION (or at the end)
'====================================================================
Private Sub InsertCopiedSheet(wbConfig As Workbook, wsSource As Worksheet, finalName As String)

    Dim ws As Worksheet, targetBefore As Worksheet
    Dim isPatterned As Boolean
    Dim d1 As String, d2 As String, d3 As String

    isPatterned = ParseSheetPattern(finalName, d1, d2, d3)
    Set targetBefore = Nothing

    If isPatterned Then
        For Each ws In wbConfig.Worksheets
            Dim e1 As String, e2 As String, e3 As String
            If ParseSheetPattern(ws.Name, e1, e2, e3) Then
                If CompareSheetOrder(finalName, ws.Name) < 0 Then
                    Set targetBefore = ws
                    Exit For
                End If
            End If
        Next ws
    End If

    If Not targetBefore Is Nothing Then
        wsSource.Copy Before:=targetBefore
    Else
        wsSource.Copy After:=wbConfig.Sheets(wbConfig.Sheets.Count)
    End If

    wbConfig.ActiveSheet.Name = finalName

End Sub


'====================================================================
' PARSE "X_X_abc" SHEET NAME PATTERN
'====================================================================
Private Function ParseSheetPattern(nm As String, ByRef firstX As String, ByRef secondX As String, ByRef abcPart As String) As Boolean
    Dim parts() As String
    parts = Split(nm, "_", 3)

    If UBound(parts) < 2 Then Exit Function
    If Len(parts(0)) <> 1 Or Len(parts(1)) <> 1 Then Exit Function

    Dim f As String, s As String
    f = UCase(parts(0))
    s = UCase(parts(1))

    If f <> "R" And f <> "T" Then Exit Function
    If Asc(s) < Asc("A") Or Asc(s) > Asc("Z") Then Exit Function
    If Len(parts(2)) = 0 Then Exit Function

    firstX = f
    secondX = s
    abcPart = parts(2)
    ParseSheetPattern = True
End Function


'====================================================================
' COMPARE TWO PATTERNED SHEET NAMES FOR SORT ORDER
' (-1 = name1 before name2, 1 = after, 0 = equal)
'====================================================================
Private Function CompareSheetOrder(name1 As String, name2 As String) As Integer
    Dim f1 As String, s1 As String, a1 As String
    Dim f2 As String, s2 As String, a2 As String
    Call ParseSheetPattern(name1, f1, s1, a1)
    Call ParseSheetPattern(name2, f2, s2, a2)

    If s1 <> s2 Then
        CompareSheetOrder = IIf(s1 < s2, -1, 1)
    ElseIf f1 <> f2 Then
        CompareSheetOrder = IIf(f1 = "R", -1, 1)
    Else
        Dim cmp As Long
        cmp = StrComp(a1, a2, vbTextCompare)
        If cmp < 0 Then
            CompareSheetOrder = -1
        ElseIf cmp > 0 Then
            CompareSheetOrder = 1
        Else
            CompareSheetOrder = 0
        End If
    End If
End Function


'====================================================================
' GENERIC HELPERS
'====================================================================

' Case-insensitive sheet lookup (returns Nothing if not found)
Private Function GetSheetByNameCI(wb As Workbook, nm As String) As Worksheet
    Dim ws As Worksheet
    Dim target As String
    target = Trim(nm)
    For Each ws In wb.Worksheets
        If StrComp(Trim(ws.Name), target, vbTextCompare) = 0 Then
            Set GetSheetByNameCI = ws
            Exit Function
        End If
    Next ws
    Set GetSheetByNameCI = Nothing
End Function

Private Function SheetExists(wb As Workbook, nm As String) As Boolean
    SheetExists = Not GetSheetByNameCI(wb, nm) Is Nothing
End Function

Private Function GetLastColumn(ws As Worksheet) As Long
    If Application.WorksheetFunction.CountA(ws.Rows(1)) = 0 Then
        GetLastColumn = 0
    Else
        GetLastColumn = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    End If
End Function

Private Function GetLastRow(ws As Worksheet, colCount As Long) As Long
    Dim maxR As Long, c As Long, rr As Long
    If colCount = 0 Then
        GetLastRow = 0
        Exit Function
    End If
    maxR = 0
    For c = 1 To colCount
        rr = ws.Cells(ws.Rows.Count, c).End(xlUp).Row
        If rr > maxR Then maxR = rr
    Next c
    GetLastRow = maxR
End Function

Private Function GetHeaders(ws As Worksheet, colCount As Long) As String()
    Dim arr() As String, i As Long
    If colCount < 1 Then
        ReDim arr(1 To 1)
        arr(1) = ""
        GetHeaders = arr
        Exit Function
    End If
    ReDim arr(1 To colCount)
    For i = 1 To colCount
        arr(i) = Trim(CStr(ws.Cells(1, i).Value))
    Next i
    GetHeaders = arr
End Function

Private Function IndexOfHeader(headers() As String, target As String) As Long
    Dim i As Long
    For i = LBound(headers) To UBound(headers)
        If StrComp(Trim(headers(i)), Trim(target), vbTextCompare) = 0 Then
            IndexOfHeader = i
            Exit Function
        End If
    Next i
    IndexOfHeader = -1
End Function

Private Sub SetCellColor(rng As Range, colorType As String)
    Select Case colorType
        Case "Green"
            rng.Interior.Color = RGB(198, 239, 206)
        Case "Red"
            rng.Interior.Color = RGB(255, 199, 206)
        Case "Yellow"
            rng.Interior.Color = RGB(255, 255, 153)
        Case "None"
            rng.Interior.ColorIndex = xlColorIndexNone
    End Select
End Sub

Private Function GetUniqueSheetName(wb As Workbook, baseName As String) As String
    Dim nm As String, i As Long
    nm = SanitizeSheetName(baseName)
    If Not SheetExists(wb, nm) Then
        GetUniqueSheetName = nm
        Exit Function
    End If
    i = 2
    Do While SheetExists(wb, MakeSuffixedName(nm, i))
        i = i + 1
    Loop
    GetUniqueSheetName = MakeSuffixedName(nm, i)
End Function

Private Function MakeSuffixedName(nm As String, n As Long) As String
    Dim suffix As String
    suffix = " (" & n & ")"
    If Len(nm) + Len(suffix) > 31 Then
        MakeSuffixedName = Left(nm, 31 - Len(suffix)) & suffix
    Else
        MakeSuffixedName = nm & suffix
    End If
End Function

Private Function SanitizeSheetName(nm As String) As String
    Dim badChars As Variant, ch As Variant
    badChars = Array("\", "/", "?", "*", "[", "]", ":")
    Dim s As String
    s = nm
    For Each ch In badChars
        s = Replace(s, ch, "")
    Next ch
    s = Trim(s)
    If s = "" Then s = "Sheet"
    If Len(s) > 31 Then s = Left(s, 31)
    SanitizeSheetName = s
End Function

Private Function BuildUpdatedPath(originalPath As String) As String
    Dim dotPos As Long, ext As String, baseName As String
    dotPos = InStrRev(originalPath, ".")
    ext = Mid(originalPath, dotPos)
    baseName = Left(originalPath, dotPos - 1)
    BuildUpdatedPath = baseName & " updated" & ext
End Function
