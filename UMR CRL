'--------------------------------------------------------------------
' 12 & 13) U99 / V99 - Column B must all be 1 (from row 2), and
'          Column A values must match between CRL Config and the
'          same-named sheet in the Proposed Config workbook.
'          Comment now lists ONLY the values that are NOT common to
'          both files (i.e. present in one but not the other),
'          in both directions.
'--------------------------------------------------------------------
Sub Check_U99()
    CheckU_V_Style "U99"
End Sub

Sub Check_V99()
    CheckU_V_Style "V99"
End Sub

Sub CheckU_V_Style(sName As String)
    Dim wsCRL As Worksheet, wsProp As Worksheet
    Dim lastRowB As Long, lastRowCRL_A As Long, lastRowProp As Long
    Dim i As Long, j As Long
    Dim allOne As Boolean, failRow As Long
    Dim allCommon As Boolean
    Dim missingFromCRL As String, missingFromProp As String
    Dim dictCRL As Object, dictProp As Object
    Dim v As String

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set wsCRL = wbCRL.Sheets(sName)
    lastRowB = GetLastRow(wsCRL, "B")
    allOne = True

    For i = 2 To lastRowB
        If Trim(CStr(wsCRL.Cells(i, 2).Value)) <> "1" Then
            allOne = False
            failRow = i
            Exit For
        End If
    Next i

    allCommon = True
    missingFromCRL = ""
    missingFromProp = ""

    ' Build dictionary of CRL Column A values
    Set dictCRL = CreateObject("Scripting.Dictionary")
    lastRowCRL_A = GetLastRow(wsCRL, "A")
    For i = 2 To lastRowCRL_A
        v = Trim(CStr(wsCRL.Cells(i, 1).Value))
        If v <> "" Then dictCRL(v) = True
    Next i

    If SheetExists(wbProposed, sName) Then
        Set wsProp = wbProposed.Sheets(sName)
        lastRowProp = GetLastRow(wsProp, "A")

        ' Build dictionary of Proposed Column A values
        Set dictProp = CreateObject("Scripting.Dictionary")
        For j = 2 To lastRowProp
            v = Trim(CStr(wsProp.Cells(j, 1).Value))
            If v <> "" Then dictProp(v) = True
        Next j

        ' Values in Proposed but NOT in CRL
        For j = 2 To lastRowProp
            v = Trim(CStr(wsProp.Cells(j, 1).Value))
            If v <> "" Then
                If Not dictCRL.Exists(v) Then
                    allCommon = False
                    missingFromCRL = missingFromCRL & v & "; "
                End If
            End If
        Next j

        ' Values in CRL but NOT in Proposed
        For i = 2 To lastRowCRL_A
            v = Trim(CStr(wsCRL.Cells(i, 1).Value))
            If v <> "" Then
                If Not dictProp.Exists(v) Then
                    allCommon = False
                    missingFromProp = missingFromProp & v & "; "
                End If
            End If
        Next i
    Else
        allCommon = False
        missingFromCRL = "Sheet """ & sName & """ not found in Proposed Config to compare against."
    End If

    If allOne And allCommon Then
        AddResult sName, "Validated", "All Column B values = 1 and Column A matches between CRL Config and Proposed Config."
    Else
        Dim c As String
        c = ""
        If Not allOne Then c = c & "Row " & failRow & ": Column B <> 1. "
        If missingFromCRL <> "" Then c = c & "In Proposed Config but not in CRL Config: " & missingFromCRL
        If missingFromProp <> "" Then c = c & "In CRL Config but not in Proposed Config: " & missingFromProp
        AddResult sName, "Manual validation required", c
    End If
End Sub

'--------------------------------------------------------------------
' COPY SHEETS THAT EXIST BUT FAILED VALIDATION, right after "Read Me"
' (runs BEFORE BuildSummarySheet). Sheets are copied with their
' original names - no "_Review" suffix is added.
'--------------------------------------------------------------------
Sub CopyFailingSheets()
    Dim i As Long
    Dim sName As String
    Dim insertAfterIndex As Long

    insertAfterIndex = ThisWorkbook.Sheets("Read Me").Index

    For i = 1 To resCount
        If resResult(i) = "Manual validation required" Then
            sName = resName(i)
            If SheetExists(wbCRL, sName) Then
                wbCRL.Sheets(sName).Copy After:=ThisWorkbook.Sheets(insertAfterIndex)
                insertAfterIndex = insertAfterIndex + 1
            End If
        End If
    Next i
End Sub

'--------------------------------------------------------------------
' BUILD SUMMARY SHEET (inserted right after "Read Me", runs LAST
' so it becomes the immediate neighbor of "Read Me")
'--------------------------------------------------------------------
Sub BuildSummarySheet()
    Dim wsSummary As Worksheet
    Dim i As Long

    If resCount = 0 Then
        MsgBox "No validation results were generated." & vbCrLf & _
               "Please run 'ValidateCRLConfig' (Alt+F8) rather than this sub directly.", vbExclamation
        Exit Sub
    End If

    Application.DisplayAlerts = False
    On Error Resume Next
    ThisWorkbook.Sheets("Summary").Delete
    On Error GoTo 0
    Application.DisplayAlerts = True

    Set wsSummary = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets("Read Me"))
    wsSummary.Name = "Summary"

    wsSummary.Range("A1").Value = "Tab Name"
    wsSummary.Range("B1").Value = "Result"
    wsSummary.Range("C1").Value = "Comments"
    wsSummary.Range("D1").Value = "Analyst Comment"
    wsSummary.Range("A1:D1").Font.Bold = True

    For i = 1 To resCount
        wsSummary.Cells(i + 1, 1).Value = resName(i)
        wsSummary.Cells(i + 1, 2).Value = resResult(i)
        wsSummary.Cells(i + 1, 3).Value = resComment(i)
        wsSummary.Cells(i + 1, 4).Value = ""

        Select Case resResult(i)
            Case "Manual validation required"
                wsSummary.Cells(i + 1, 2).Interior.Color = RGB(255, 0, 0)
                wsSummary.Cells(i + 1, 2).Font.Color = RGB(255, 255, 255)
            Case "Sheet does not exists"
                wsSummary.Cells(i + 1, 2).Interior.Color = RGB(255, 255, 0)
        End Select
    Next i

    With wsSummary
        .Columns("A").ColumnWidth = 14
        .Columns("B").ColumnWidth = 24
        .Columns("C").ColumnWidth = 70
        .Columns("D").ColumnWidth = 30
        .Columns("C").WrapText = True
        .Rows("2:" & (resCount + 1)).AutoFit
        .Range("A1:D" & (resCount + 1)).Borders.LineStyle = xlContinuous
    End With
End Sub
