Option Explicit

'====================================================================
' CRL CONFIG VALIDATION MACRO
' - Reads Proposed Config path (D23), CRL Config path (D24) and
'   State abbreviation (D15) from "Read Me" sheet in ThisWorkbook
' - Deletes all sheets except "Read Me" before each run
' - Validates a defined list of tabs in CRL Config workbook
' - Copies any sheet that exists but fails validation right after "Read Me"
' - Builds a "Summary" sheet right after "Read Me" (pushing review sheets right)
'
' HOW TO RUN: Press Alt+F8, select "ValidateCRLConfig", click Run.
' Do NOT run any other sub directly - only ValidateCRLConfig populates
' the results before building the Summary sheet.
'====================================================================

Dim resCount As Long
Dim resName() As String
Dim resResult() As String
Dim resComment() As String

Dim wbProposed As Workbook
Dim wbCRL As Workbook

'--------------------------------------------------------------------
' MAIN ENTRY POINT
'--------------------------------------------------------------------
Sub ValidateCRLConfig()

    Dim wsReadMe As Worksheet
    Dim proposedPath As String, crlPath As String, stateAbbr As String
    Dim i As Long

    On Error GoTo ErrHandler

    resCount = 0
    ReDim resName(1 To 1)
    ReDim resResult(1 To 1)
    ReDim resComment(1 To 1)

    Set wsReadMe = ThisWorkbook.Sheets("Read Me")
    proposedPath = Trim(wsReadMe.Range("D23").Value)
    crlPath = Trim(wsReadMe.Range("D24").Value)
    stateAbbr = Trim(wsReadMe.Range("D15").Value)

    If proposedPath = "" Or crlPath = "" Then
        MsgBox "Please provide both Proposed Config (D23) and CRL Config (D24) file paths in the 'Read Me' sheet.", vbExclamation
        Exit Sub
    End If

    If Dir(proposedPath) = "" Then
        MsgBox "Proposed Config file not found at:" & vbCrLf & proposedPath, vbCritical
        Exit Sub
    End If

    If Dir(crlPath) = "" Then
        MsgBox "CRL Config file not found at:" & vbCrLf & crlPath, vbCritical
        Exit Sub
    End If

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    '---------------- Clean up sheets from any previous run ----------------
    CleanupSheets

    Set wbProposed = Workbooks.Open(proposedPath, ReadOnly:=True)
    Set wbCRL = Workbooks.Open(crlPath, ReadOnly:=True)

    '---------------- Run all checks in order ----------------
    Check_SimpleExist "C51"
    Check_SimpleExist "C52"
    Check_C62
    Check_C63
    Check_C71
    Check_H11
    Check_H21
    Check_O02
    Check_P29

    Dim simpleSheets As Variant
    simpleSheets = Array("U41", "U42", "U51", "U52", "U53", "U54", "U55", "U56", _
                          "U61", "U62", "U64", "U65", "U71", "U72")
    For i = LBound(simpleSheets) To UBound(simpleSheets)
        Check_SimpleExist CStr(simpleSheets(i))
    Next i

    Check_T90
    Check_T99
    Check_U99
    Check_V99

    '---------------- Build outputs ----------------
    CopyFailingSheets
    BuildSummarySheet

    wbProposed.Close SaveChanges:=False
    wbCRL.Close SaveChanges:=False
    Set wbProposed = Nothing
    Set wbCRL = Nothing

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    MsgBox "Validation complete (" & resCount & " tabs checked). Please review the 'Summary' sheet.", vbInformation
    Exit Sub

ErrHandler:
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    On Error Resume Next
    If Not wbProposed Is Nothing Then wbProposed.Close SaveChanges:=False
    If Not wbCRL Is Nothing Then wbCRL.Close SaveChanges:=False
    MsgBox "Error: " & Err.Description, vbCritical
End Sub

'--------------------------------------------------------------------
' Delete every sheet in ThisWorkbook except "Read Me"
'--------------------------------------------------------------------
Sub CleanupSheets()
    Dim ws As Worksheet
    Dim i As Long

    For i = ThisWorkbook.Sheets.Count To 1 Step -1
        Set ws = ThisWorkbook.Sheets(i)
        If ws.Name <> "Read Me" Then
            ws.Delete
        End If
    Next i
End Sub

'--------------------------------------------------------------------
' HELPERS
'--------------------------------------------------------------------
Function SheetExists(wb As Workbook, sName As String) As Boolean
    Dim ws As Worksheet
    On Error Resume Next
    Set ws = wb.Sheets(sName)
    On Error GoTo 0
    SheetExists = Not ws Is Nothing
End Function

Function GetLastRow(ws As Worksheet, Optional colLetter As String = "A") As Long
    GetLastRow = ws.Cells(ws.Rows.Count, colLetter).End(xlUp).Row
    If GetLastRow < 1 Then GetLastRow = 1
End Function

Sub AddResult(tabName As String, result As String, comment As String)
    resCount = resCount + 1
    ReDim Preserve resName(1 To resCount)
    ReDim Preserve resResult(1 To resCount)
    ReDim Preserve resComment(1 To resCount)

    resName(resCount) = tabName
    resResult(resCount) = result
    resComment(resCount) = comment
End Sub

'--------------------------------------------------------------------
' Robust numeric parser - handles values stored as text/strings with
' formatting characters (commas, currency symbols, spaces, % etc.)
' Returns True if a numeric value could be extracted, and places the
' parsed value into outVal (ByRef).
'--------------------------------------------------------------------
Function TryParseNumber(v As Variant, ByRef outVal As Double) As Boolean
    Dim s As String
    Dim ch As String
    Dim i As Long
    Dim cleaned As String

    TryParseNumber = False

    If IsNumeric(v) Then
        outVal = CDbl(v)
        TryParseNumber = True
        Exit Function
    End If

    s = Trim(CStr(v))
    If s = "" Then Exit Function

    ' Strip everything except digits, decimal point and minus sign
    ' (removes commas, currency symbols, spaces, percent signs, etc.)
    cleaned = ""
    For i = 1 To Len(s)
        ch = Mid(s, i, 1)
        If (ch >= "0" And ch <= "9") Or ch = "." Or ch = "-" Then
            cleaned = cleaned & ch
        End If
    Next i

    If cleaned = "" Or cleaned = "-" Or cleaned = "." Then Exit Function

    If IsNumeric(cleaned) Then
        outVal = CDbl(cleaned)
        TryParseNumber = True
    End If
End Function

'--------------------------------------------------------------------
' 1,2,9) Simple existence-only checks
'--------------------------------------------------------------------
Sub Check_SimpleExist(sName As String)
    If SheetExists(wbCRL, sName) Then
        AddResult sName, "Validated", "Sheet exists."
    Else
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
    End If
End Sub

'--------------------------------------------------------------------
' 3) C62 - "Rejected" should NOT exist in Column A or B
'--------------------------------------------------------------------
Sub Check_C62()
    Dim sName As String: sName = "C62"
    Dim ws As Worksheet
    Dim lastRowA As Long, lastRowB As Long, lastRowVal As Long, i As Long
    Dim found As Boolean

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set ws = wbCRL.Sheets(sName)
    lastRowA = GetLastRow(ws, "A")
    lastRowB = GetLastRow(ws, "B")
    lastRowVal = IIf(lastRowA > lastRowB, lastRowA, lastRowB)
    found = False

    For i = 1 To lastRowVal
        If Trim(LCase(CStr(ws.Cells(i, 1).Value))) = "rejected" Or _
           Trim(LCase(CStr(ws.Cells(i, 2).Value))) = "rejected" Then
            found = True
            Exit For
        End If
    Next i

    If Not found Then
        AddResult sName, "Validated", "'Rejected' value not found in Column A or B."
    Else
        AddResult sName, "Manual validation required", "'Rejected' value found in Column A/B at row " & i & "."
    End If
End Sub

'--------------------------------------------------------------------
' 4) C63 - where Column A = "0", Column B must also = "0"
'--------------------------------------------------------------------
Sub Check_C63()
    Dim sName As String: sName = "C63"
    Dim ws As Worksheet
    Dim lastRowVal As Long, i As Long
    Dim allMatch As Boolean, failRow As Long

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set ws = wbCRL.Sheets(sName)
    lastRowVal = GetLastRow(ws, "A")
    allMatch = True

    For i = 1 To lastRowVal
        If Trim(CStr(ws.Cells(i, 1).Value)) = "0" Then
            If Trim(CStr(ws.Cells(i, 2).Value)) <> "0" Then
                allMatch = False
                failRow = i
                Exit For
            End If
        End If
    Next i

    If allMatch Then
        AddResult sName, "Validated", "All '0' values in Column A have corresponding '0' in Column B."
    Else
        AddResult sName, "Manual validation required", "Row " & failRow & ": Column A = 0 but Column B <> 0."
    End If
End Sub

'--------------------------------------------------------------------
' 5) C71 - B2 must equal "0"
'--------------------------------------------------------------------
Sub Check_C71()
    Dim sName As String: sName = "C71"
    Dim ws As Worksheet

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set ws = wbCRL.Sheets(sName)

    If Trim(CStr(ws.Range("B2").Value)) = "0" Then
        AddResult sName, "Validated", "Cell B2 = 0."
    Else
        AddResult sName, "Manual validation required", "Cell B2 = '" & ws.Range("B2").Value & "' instead of 0."
    End If
End Sub

'--------------------------------------------------------------------
' 6) H11 - for rows where Column B = "999" or "6", group by
'    combination of A,B,C and confirm Column D is consistent
'--------------------------------------------------------------------
Sub Check_H11()
    Dim sName As String: sName = "H11"
    Dim ws As Worksheet
    Dim lastRowVal As Long, i As Long
    Dim dict As Object
    Dim key As String, bVal As String, dVal As String
    Dim allMatch As Boolean
    Dim mismatchInfo As String

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set ws = wbCRL.Sheets(sName)
    lastRowVal = GetLastRow(ws, "A")
    Set dict = CreateObject("Scripting.Dictionary")
    allMatch = True

    For i = 1 To lastRowVal
        bVal = Trim(CStr(ws.Cells(i, 2).Value))
        If bVal = "999" Or bVal = "6" Then
            key = Trim(CStr(ws.Cells(i, 1).Value)) & "|" & bVal & "|" & Trim(CStr(ws.Cells(i, 3).Value))
            dVal = Trim(CStr(ws.Cells(i, 4).Value))
            If dict.Exists(key) Then
                If dict(key) <> dVal Then
                    allMatch = False
                    mismatchInfo = "Combination (A,B,C)=" & key & " has differing D values (" & _
                                   dict(key) & " vs " & dVal & ") - see row " & i & "."
                    Exit For
                End If
            Else
                dict.Add key, dVal
            End If
        End If
    Next i

    If allMatch Then
        AddResult sName, "Validated", "Column D values are consistent for matching A,B,C combinations where B=999 or 6."
    Else
        AddResult sName, "Manual validation required", mismatchInfo
    End If
End Sub

'--------------------------------------------------------------------
' 7) H21 - grouped Column A values must share the same Column B value
'--------------------------------------------------------------------
Sub Check_H21()
    Dim sName As String: sName = "H21"
    Dim ws As Worksheet
    Dim g1 As Variant, g2 As Variant, g3 As Variant
    Dim msg As String
    Dim ok As Boolean

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set ws = wbCRL.Sheets(sName)

    g1 = Array("300/500", "250/500")
    g2 = Array("500/1000", "1000/1000", "500/500", "1500/1500")
    g3 = Array("1000", "500")

    ok = True
    msg = ""

    If Not CheckGroupSameB(ws, g1, msg) Then ok = False
    If Not CheckGroupSameB(ws, g2, msg) Then ok = False
    If Not CheckGroupSameB(ws, g3, msg) Then ok = False

    If ok Then
        AddResult sName, "Validated", "All grouped values in Column A have matching Column B values."
    Else
        AddResult sName, "Manual validation required", msg
    End If
End Sub

Function CheckGroupSameB(ws As Worksheet, grp As Variant, ByRef msg As String) As Boolean
    Dim lastRowVal As Long, i As Long, j As Long
    Dim vals As Object
    Dim firstVal As String
    Dim firstSet As Boolean
    Dim k As Variant

    Set vals = CreateObject("Scripting.Dictionary")
    lastRowVal = GetLastRow(ws, "A")

    For j = LBound(grp) To UBound(grp)
        For i = 1 To lastRowVal
            If Trim(CStr(ws.Cells(i, 1).Value)) = grp(j) Then
                vals(CStr(grp(j))) = Trim(CStr(ws.Cells(i, 2).Value))
                Exit For
            End If
        Next i
    Next j

    firstSet = False
    CheckGroupSameB = True

    For Each k In vals.Keys
        If Not firstSet Then
            firstVal = vals(k)
            firstSet = True
        Else
            If vals(k) <> firstVal Then
                CheckGroupSameB = False
                msg = msg & "Group (" & Join(grp, ", ") & ") has mismatched Column B values. "
                Exit Function
            End If
        End If
    Next k
End Function

'--------------------------------------------------------------------
' 8) O02 - where Column C >= 25, Column D must equal 1.00
'--------------------------------------------------------------------
Sub Check_O02()
    Dim sName As String: sName = "O02"
    Dim ws As Worksheet
    Dim lastRowVal As Long, i As Long
    Dim allMatch As Boolean, failRow As Long

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set ws = wbCRL.Sheets(sName)
    lastRowVal = GetLastRow(ws, "C")
    allMatch = True

    For i = 1 To lastRowVal
        If IsNumeric(ws.Cells(i, 3).Value) Then
            If CDbl(ws.Cells(i, 3).Value) >= 25 Then
                If Round(CDbl(ws.Cells(i, 4).Value), 2) <> 1 Then
                    allMatch = False
                    failRow = i
                    Exit For
                End If
            End If
        End If
    Next i

    If allMatch Then
        AddResult sName, "Validated", "Column D = 1.00 for all Column C values >= 25."
    Else
        AddResult sName, "Manual validation required", "Row " & failRow & ": Column C >= 25 but Column D <> 1.00."
    End If
End Sub

'--------------------------------------------------------------------
' 9) P29 - A="No"->B=1, A="Yes"->B=0.85
'--------------------------------------------------------------------
Sub Check_P29()
    Dim sName As String: sName = "P29"
    Dim ws As Worksheet
    Dim lastRowVal As Long, i As Long
    Dim allMatch As Boolean, failRow As Long
    Dim aVal As String

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set ws = wbCRL.Sheets(sName)
    lastRowVal = GetLastRow(ws, "A")
    allMatch = True

    For i = 1 To lastRowVal
        aVal = Trim(LCase(CStr(ws.Cells(i, 1).Value)))
        If aVal = "no" Then
            If Not IsNumeric(ws.Cells(i, 2).Value) Then
                allMatch = False: failRow = i: Exit For
            ElseIf Round(CDbl(ws.Cells(i, 2).Value), 2) <> 1 Then
                allMatch = False: failRow = i: Exit For
            End If
        ElseIf aVal = "yes" Then
            If Not IsNumeric(ws.Cells(i, 2).Value) Then
                allMatch = False: failRow = i: Exit For
            ElseIf Round(CDbl(ws.Cells(i, 2).Value), 2) <> 0.85 Then
                allMatch = False: failRow = i: Exit For
            End If
        End If
    Next i

    If allMatch Then
        AddResult sName, "Validated", "Column B values match expected (No -> 1, Yes -> 0.85)."
    Else
        AddResult sName, "Manual validation required", "Row " & failRow & ": Column B does not match expected value for Column A."
    End If
End Sub

'--------------------------------------------------------------------
' 10) T90 - Column B = 1000 x Column A, from row 2
'     Values may be stored as text/strings - parsed via TryParseNumber
'     before the numeric comparison is performed.
'--------------------------------------------------------------------
Sub Check_T90()
    Dim sName As String: sName = "T90"
    Dim ws As Worksheet
    Dim lastRowVal As Long, i As Long
    Dim allMatch As Boolean, failRow As Long
    Dim aNum As Double, bNum As Double

    If Not SheetExists(wbCRL, sName) Then
        AddResult sName, "Sheet does not exists", "Sheet """ & sName & """ not found in CRL Config."
        Exit Sub
    End If

    Set ws = wbCRL.Sheets(sName)
    lastRowVal = GetLastRow(ws, "A")
    allMatch = True

    For i = 2 To lastRowVal
        If TryParseNumber(ws.Cells(i, 1).Value, aNum) And TryParseNumber(ws.Cells(i, 2).Value, bNum) Then
            If Round(bNum, 4) <> Round(aNum * 1000, 4) Then
                allMatch = False
                failRow = i
                Exit For
            End If
        End If
    Next i

    If allMatch Then
        AddResult sName, "Validated", "Column B = 1000 x Column A for all rows (from row 2)."
    Else
        AddResult sName, "Manual validation required", "Row " & failRow & ": Column B <> 1000 x Column A."
    End If
End Sub

