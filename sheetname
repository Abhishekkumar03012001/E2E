Sub UnmergeAndKeepRightValue()
    Dim ws As Worksheet
    Dim ranges As Variant
    Dim i As Integer
    Dim leftCell As Range, rightCell As Range
    Dim val As Variant

    Set ws = ThisWorkbook.Sheets("Result")

    ' Pairs of (left cell, right cell) to process
    ranges = Array("G10:H10", "G11:H11", "I10:J10", "I11:J11")

    Application.ScreenUpdating = False

    For i = LBound(ranges) To UBound(ranges)
        With ws.Range(ranges(i))
            Set leftCell = .Cells(1, 1)   ' G10, G11, I10, I11
            Set rightCell = .Cells(1, 2)  ' H10, H11, J10, J11

            ' Capture the current value (merged cell stores it in top-left)
            val = .Cells(1, 1).Value

            ' Unmerge
            .UnMerge
        End With

        ' Clear left cell, put value in right cell
        leftCell.ClearContents
        rightCell.Value = val
    Next i

    Application.ScreenUpdating = True

    MsgBox "Done! Cells unmerged and values moved.", vbInformation
End Sub
