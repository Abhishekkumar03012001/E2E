Sub GenerateOutput()
Dim wbSrc As Workbook, ws As Worksheet, o As Worksheet, cols, i As Long, r As Long, c As Long, lastRow As Long, lastCol As Long, found As Boolean, nRows As Long, fPath As Variant
cols = Array("Fire", "WaterWinter", "WaterNonWinter", "Hurricane", "WindSummer", "WindWinter", "Hail", "Lightning", "LiabilityPollution", "TheftVandalism", "Other", "Reinsurance", "Capital", "Wildfire", "Fixed")
fPath = Application.GetOpenFilename("Excel Files (*.xls*), *.xls*")
If fPath = False Then Exit Sub
Set wbSrc = Workbooks.Open(fPath)
On Error Resume Next
Application.DisplayAlerts = False
ThisWorkbook.Sheets("OUTPUT").Delete
Application.DisplayAlerts = True
On Error GoTo 0
Set o = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
o.Name = "OUTPUT"
o.Cells(1, 1) = "SheetName"
For i = 0 To UBound(cols)
o.Cells(1, i + 2) = cols(i)
Next i
o.Cells(1, UBound(cols) + 3) = "No of rows"
r = 2
For Each ws In wbSrc.Sheets
o.Cells(r, 1) = ws.Name
lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
For i = 0 To UBound(cols)
found = False
For c = 1 To lastCol
If LCase(Trim(ws.Cells(1, c).Value)) = LCase(cols(i)) Then
found = True
Exit For
End If
Next c
o.Cells(r, i + 2) = found
If Not found Then o.Cells(r, i + 2).Interior.Color = RGB(255, 0, 0)
Next i
lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
nRows = lastRow - 1
If nRows < 0 Then nRows = 0
o.Cells(r, UBound(cols) + 3) = nRows
If nRows = 1 Then o.Cells(r, UBound(cols) + 3).Interior.Color = RGB(255, 0, 0)
r = r + 1
Next ws
wbSrc.Close False
o.Columns.AutoFit
End Sub
