Sub MarkEQFileNotFound()
    Dim ws As Worksheet
    Dim lastRow As Long
    Dim rng As Range
    
    Set ws = ThisWorkbook.Sheets("EQ Tabs")
    
    ' Find the last used row in the sheet (based on column A, adjust if needed)
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    
    ' If you want to base it on Column D itself instead, use this line:
    ' lastRow = ws.Cells(ws.Rows.Count, "D").End(xlUp).Row
    
    If lastRow < 1 Then lastRow = 1
    
    Set rng = ws.Range("D1:D" & lastRow)
    
    With rng
        .Value = "EQ file not found"
        .Interior.Color = RGB(255, 199, 206) ' Light red
        .Font.Color = RGB(156, 0, 6)         ' Optional: dark red text for readability
    End With
    
    MsgBox "Column D updated with 'EQ file not found' and light red background.", vbInformation
End Sub
