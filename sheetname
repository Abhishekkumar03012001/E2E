Sub ClearSheetsExceptHeader()
    Dim ws As Worksheet
    Dim sheetNames As Variant
    Dim i As Integer
    Dim lastRow As Long
    Dim lastCol As Long

    sheetNames = Array("QC Details - CAT", "QC Summary - CAT", "QC Details - Territory", "QC Summary - Territory")

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    For i = LBound(sheetNames) To UBound(sheetNames)
        On Error Resume Next
        Set ws = ThisWorkbook.Sheets(sheetNames(i))
        On Error GoTo 0

        If Not ws Is Nothing Then
            With ws
                lastRow = .Cells.Find(What:="*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).Row
                lastCol = .Cells.Find(What:="*", SearchOrder:=xlByColumns, SearchDirection:=xlPrevious).Column

                If lastRow > 1 Then
                    .Range(.Cells(2, 1), .Cells(lastRow, lastCol)).ClearContents
                End If
            End With
        End If

        Set ws = Nothing
    Next i

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
End Sub
