Sub MergeResultCells()

    Dim ws As Worksheet

    Set ws = ThisWorkbook.Worksheets("Result")

    On Error GoTo CleanUp

    'Disable all pop-ups / screen changes
    Application.DisplayAlerts = False
    Application.ScreenUpdating = False
    Application.EnableEvents = False

    'Merge cells
    MergeTwoCells ws, "G10:H10", "H10"
    MergeTwoCells ws, "G11:H11", "H11"
    MergeTwoCells ws, "I10:J10", "J10"
    MergeTwoCells ws, "I11:J11", "J11"

CleanUp:

    'Restore Excel settings
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Application.EnableEvents = True

End Sub


Private Sub MergeTwoCells(ws As Worksheet, _
                          MergeRange As String, _
                          SourceCell As String)

    Dim rng As Range
    Dim src As Range
    Dim cellValue As Variant
    Dim linkAddress As String
    Dim linkSubAddress As String
    Dim hasLink As Boolean

    Set rng = ws.Range(MergeRange)
    Set src = ws.Range(SourceCell)

    '---------------------------------------
    ' Store value/formula from H/J
    '---------------------------------------
    cellValue = src.Formula

    '---------------------------------------
    ' Store hyperlink from H/J
    '---------------------------------------
    If src.Hyperlinks.Count > 0 Then

        hasLink = True

        With src.Hyperlinks(1)
            linkAddress = .Address
            linkSubAddress = .SubAddress
        End With

    End If

    '---------------------------------------
    ' Remove existing merge if any
    '---------------------------------------
    If rng.MergeCells Then
        rng.UnMerge
    End If

    '---------------------------------------
    ' Copy formatting from H/J
    '---------------------------------------
    src.Copy
    rng.Cells(1, 1).PasteSpecial Paste:=xlPasteFormats
    Application.CutCopyMode = False

    '---------------------------------------
    ' ACTUAL MERGE
    '---------------------------------------
    rng.Merge

    '---------------------------------------
    ' Put H/J value/formula in merged cell
    '---------------------------------------
    rng.Cells(1, 1).Formula = cellValue

    '---------------------------------------
    ' Restore hyperlink
    '---------------------------------------
    If hasLink Then

        ws.Hyperlinks.Add _
            Anchor:=rng.Cells(1, 1), _
            Address:=linkAddress, _
            SubAddress:=linkSubAddress

    End If

    '---------------------------------------
    ' Outside border
    '---------------------------------------
    With rng
        .BorderAround _
            LineStyle:=xlContinuous, _
            Weight:=xlThin
    End With

End Sub
