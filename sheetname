'--------------------------------------------------------------------
' H11
' For rows where Column B = "999" or "6", group by
' combination of A,B,C and confirm Column D is consistent
'--------------------------------------------------------------------
Sub Check_H11()

    Dim sName As String: sName = "H11"

    Dim ws As Worksheet

    Dim lastRowVal As Long
    Dim i As Long

    Dim dict As Object

    Dim key As String
    Dim bVal As String
    Dim dVal As String

    Dim allMatch As Boolean

    Dim mismatchInfo As String


    If Not SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

        Exit Sub

    End If


    Set ws = wbCRL.Sheets(sName)

    lastRowVal = GetLastRow(ws, "A")

    Set dict = CreateObject("Scripting.Dictionary")

    allMatch = True


    For i = 1 To lastRowVal

        bVal = Trim(CStr(ws.Cells(i, 2).Value))

        If bVal = "999" Or bVal = "6" Then

            key = _
                Trim(CStr(ws.Cells(i, 1).Value)) & "|" & _
                bVal & "|" & _
                Trim(CStr(ws.Cells(i, 3).Value))

            dVal = Trim(CStr(ws.Cells(i, 4).Value))


            If dict.Exists(key) Then

                If dict(key) <> dVal Then

                    allMatch = False

                    mismatchInfo = _
                        "Combination (A,B,C)=" & key & _
                        " has differing D values (" & _
                        dict(key) & " vs " & dVal & _
                        ") - see row " & i & "."

                    Exit For

                End If

            Else

                dict.Add key, dVal

            End If

        End If

    Next i


    If allMatch Then

        AddResult _
            sName, _
            "Validated", _
            "Column D values are consistent for matching A,B,C combinations where B=999 or 6."

    Else

        AddResult _
            sName, _
            "Manual validation required", _
            mismatchInfo

    End If

End Sub


'--------------------------------------------------------------------
' H21
' Grouped Column A values must share same Column B value
'--------------------------------------------------------------------
Sub Check_H21()

    Dim sName As String: sName = "H21"

    Dim ws As Worksheet

    Dim g1 As Variant
    Dim g2 As Variant
    Dim g3 As Variant

    Dim msg As String
    Dim ok As Boolean


    If Not SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

        Exit Sub

    End If


    Set ws = wbCRL.Sheets(sName)


    g1 = Array("300/500", "250/500")

    g2 = Array( _
        "500/1000", _
        "1000/1000", _
        "500/500", _
        "1500/1500")

    g3 = Array("1000", "500")


    ok = True
    msg = ""


    If Not CheckGroupSameB(ws, g1, msg) Then ok = False

    If Not CheckGroupSameB(ws, g2, msg) Then ok = False

    If Not CheckGroupSameB(ws, g3, msg) Then ok = False


    If ok Then

        AddResult _
            sName, _
            "Validated", _
            "All grouped values in Column A have matching Column B values."

    Else

        AddResult _
            sName, _
            "Manual validation required", _
            msg

    End If

End Sub


Function CheckGroupSameB( _
    ws As Worksheet, _
    grp As Variant, _
    ByRef msg As String) As Boolean

    Dim lastRowVal As Long
    Dim i As Long
    Dim j As Long

    Dim vals As Object

    Dim firstVal As String
    Dim firstSet As Boolean

    Dim k As Variant


    Set vals = CreateObject("Scripting.Dictionary")

    lastRowVal = GetLastRow(ws, "A")


    For j = LBound(grp) To UBound(grp)

        For i = 1 To lastRowVal

            If Trim(CStr(ws.Cells(i, 1).Value)) = grp(j) Then

                vals(CStr(grp(j))) = _
                    Trim(CStr(ws.Cells(i, 2).Value))

                Exit For

            End If

        Next i

    Next j


    firstSet = False

    CheckGroupSameB = True


    For Each k In vals.Keys

        If Not firstSet Then

            firstVal = vals(k)

            firstSet = True

        Else

            If vals(k) <> firstVal Then

                CheckGroupSameB = False

                msg = _
                    msg & _
                    "Group (" & Join(grp, ", ") & _
                    ") has mismatched Column B values. "

                Exit Function

            End If

        End If

    Next k

End Function


'--------------------------------------------------------------------
' O02
' Where Column C >= 25, Column D must equal 1.00
'--------------------------------------------------------------------
Sub Check_O02()

    Dim sName As String: sName = "O02"

    Dim ws As Worksheet

    Dim lastRowVal As Long
    Dim i As Long

    Dim allMatch As Boolean
    Dim failRow As Long


    If Not SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

        Exit Sub

    End If


    Set ws = wbCRL.Sheets(sName)

    lastRowVal = GetLastRow(ws, "C")

    allMatch = True


    For i = 1 To lastRowVal

        If IsNumeric(ws.Cells(i, 3).Value) Then

            If CDbl(ws.Cells(i, 3).Value) >= 25 Then

                If Round( _
                    CDbl(ws.Cells(i, 4).Value), _
                    2) <> 1 Then

                    allMatch = False

                    failRow = i

                    Exit For

                End If

            End If

        End If

    Next i


    If allMatch Then

        AddResult _
            sName, _
            "Validated", _
            "Column D = 1.00 for all Column C values >= 25."

    Else

        AddResult _
            sName, _
            "Manual validation required", _
            "Row " & failRow & _
            ": Column C >= 25 but Column D <> 1.00."

    End If

End Sub


'--------------------------------------------------------------------
' P29
' A="No" -> B=1
' A="Yes" -> B=0.85
'--------------------------------------------------------------------
Sub Check_P29()

    Dim sName As String: sName = "P29"

    Dim ws As Worksheet

    Dim lastRowVal As Long
    Dim i As Long

    Dim allMatch As Boolean
    Dim failRow As Long

    Dim aVal As String


    If Not SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

        Exit Sub

    End If


    Set ws = wbCRL.Sheets(sName)

    lastRowVal = GetLastRow(ws, "A")

    allMatch = True


    For i = 1 To lastRowVal

        aVal = Trim( _
            LCase(CStr(ws.Cells(i, 1).Value)))


        If aVal = "no" Then

            If Not IsNumeric(ws.Cells(i, 2).Value) Then

                allMatch = False
                failRow = i

                Exit For

            ElseIf Round( _
                CDbl(ws.Cells(i, 2).Value), _
                2) <> 1 Then

                allMatch = False
                failRow = i

                Exit For

            End If


        ElseIf aVal = "yes" Then

            If Not IsNumeric(ws.Cells(i, 2).Value) Then

                allMatch = False
                failRow = i

                Exit For

            ElseIf Round( _
                CDbl(ws.Cells(i, 2).Value), _
                2) <> 0.85 Then

                allMatch = False
                failRow = i

                Exit For

            End If

        End If

    Next i


    If allMatch Then

        AddResult _
            sName, _
            "Validated", _
            "Column B values match expected (No -> 1, Yes -> 0.85)."

    Else

        AddResult _
            sName, _
            "Manual validation required", _
            "Row " & failRow & _
            ": Column B does not match expected value for Column A."

    End If

End Sub


'--------------------------------------------------------------------
' T90
' Column B = 1000 x Column A, from row 2
'--------------------------------------------------------------------
Sub Check_T90()

    Dim sName As String: sName = "T90"

    Dim ws As Worksheet

    Dim lastRowVal As Long
    Dim i As Long

    Dim allMatch As Boolean
    Dim failRow As Long

    Dim aNum As Double
    Dim bNum As Double


    If Not SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

        Exit Sub

    End If


    Set ws = wbCRL.Sheets(sName)

    lastRowVal = GetLastRow(ws, "A")

    allMatch = True


    For i = 2 To lastRowVal - 1

        If _
            TryParseNumber(ws.Cells(i, 1).Value, aNum) _
            And _
            TryParseNumber(ws.Cells(i, 2).Value, bNum) Then

            If Round(bNum, 4) <> _
               Round(aNum * 1000, 4) Then

                allMatch = False

                failRow = i

                Exit For

            End If

        End If

    Next i


    If allMatch Then

        AddResult _
            sName, _
            "Validated", _
            "Column B = 1000 x Column A for all rows (from row 2)."

    Else

        AddResult _
            sName, _
            "Manual validation required", _
            "Row " & failRow & _
            ": Column B <> 1000 x Column A."

    End If

End Sub


