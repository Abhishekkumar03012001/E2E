Option Explicit

'====================================================================
' CRL CONFIG VALIDATION MACRO
'
' QCrun receives:
'   1. proposedPath = Proposed Config file path
'   2. crlPath      = CRL Config file path
'
' State abbreviation has been removed.
'
' The macro:
' - Deletes all sheets except "Read Me" before each run
' - Validates a defined list of tabs in CRL Config workbook
' - If the Proposed Config file is NOT found, U99 and V99 are
'   flagged as "Manual validation required"
' - Copies any sheet that exists but fails validation right after
'   "Read Me"
' - Builds a "Summary" sheet right after "Read Me"
'
' Call from UserForm:
'
'   QCrun txtProp.Value, txtCRL.Value
'
' If Property path is empty:
'
'   QCrun "", txtCRL.Value
'====================================================================


Dim resCount As Long
Dim resName() As String
Dim resResult() As String
Dim resComment() As String

Dim wbProposed As Workbook
Dim wbCRL As Workbook

Dim proposedAvailable As Boolean


'--------------------------------------------------------------------
' MAIN ENTRY POINT
'--------------------------------------------------------------------
Public Sub QCrun(ByVal proposedPath As String, ByVal crlPath As String)

    Dim i As Long

    On Error GoTo ErrHandler

    '------------------------------------------------------------
    ' Initialize results
    '------------------------------------------------------------
    resCount = 0

    ReDim resName(1 To 1)
    ReDim resResult(1 To 1)
    ReDim resComment(1 To 1)

    proposedAvailable = False

    '------------------------------------------------------------
    ' Clean input paths
    '------------------------------------------------------------
    proposedPath = Trim(proposedPath)
    crlPath = Trim(crlPath)


    '------------------------------------------------------------
    ' CRL path is mandatory
    '------------------------------------------------------------
    If crlPath = "" Then

        MsgBox "Please provide the CRL Config file path.", _
               vbExclamation, "Missing CRL Config"

        Exit Sub

    End If


    '------------------------------------------------------------
    ' Check CRL file
    '------------------------------------------------------------
    If Dir(crlPath) = "" Then

        MsgBox "CRL Config file not found at:" & vbCrLf & _
               crlPath, _
               vbCritical, "CRL Config Not Found"

        Exit Sub

    End If


    '------------------------------------------------------------
    ' Check Proposed Config
    '
    ' Proposed Config is OPTIONAL.
    '------------------------------------------------------------
    If proposedPath = "" Then

        proposedAvailable = False

    ElseIf Dir(proposedPath) = "" Then

        proposedAvailable = False

        MsgBox "Proposed Config file not found at:" & vbCrLf & _
               proposedPath & vbCrLf & vbCrLf & _
               "Continuing validation. U99 and V99 will be flagged " & _
               "as 'Proposed File missing'.", _
               vbExclamation, "Proposed Config Not Found"

    Else

        proposedAvailable = True

    End If


    '------------------------------------------------------------
    ' Application settings
    '------------------------------------------------------------
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False


    '------------------------------------------------------------
    ' Clean up sheets from previous run
    '------------------------------------------------------------
    CleanupSheets


    '------------------------------------------------------------
    ' Open CRL Config
    '------------------------------------------------------------
    Set wbCRL = Workbooks.Open(crlPath, ReadOnly:=True)


    '------------------------------------------------------------
    ' Open Proposed Config only if available
    '------------------------------------------------------------
    If proposedAvailable Then

        Set wbProposed = Workbooks.Open( _
            proposedPath, _
            ReadOnly:=True)

    Else

        Set wbProposed = Nothing

    End If


    '============================================================
    ' RUN ALL CHECKS
    '============================================================

    Check_SimpleExist "C51"
    Check_SimpleExist "C52"

    Check_C62
    Check_C63
    Check_C71

    Check_H11
    Check_H21
    Check_O02
    Check_P29

    Dim simpleSheets As Variant

    simpleSheets = Array( _
        "U41", _
        "U42", _
        "U51", _
        "U52", _
        "U53", _
        "U54", _
        "U55", _
        "U56", _
        "U61", _
        "U62", _
        "U64", _
        "U65", _
        "U71", _
        "U72")

    For i = LBound(simpleSheets) To UBound(simpleSheets)

        Check_SimpleExist CStr(simpleSheets(i))

    Next i


    Check_T90
    Check_T99


    '------------------------------------------------------------
    ' U99 / V99
    '------------------------------------------------------------
    If proposedAvailable Then

        Check_U99
        Check_V99

    Else

        AddResult _
            "U99", _
            "Manual validation required", _
            "Proposed File missing"

        AddResult _
            "V99", _
            "Manual validation required", _
            "Proposed File missing"

    End If


    '------------------------------------------------------------
    ' Build outputs
    '------------------------------------------------------------
    CopyFailingSheets
    BuildSummarySheet


    '------------------------------------------------------------
    ' Close workbooks
    '------------------------------------------------------------
    wbCRL.Close SaveChanges:=False
    Set wbCRL = Nothing


    If proposedAvailable Then

        wbProposed.Close SaveChanges:=False
        Set wbProposed = Nothing

    End If


    '------------------------------------------------------------
    ' Restore application settings
    '------------------------------------------------------------
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True


    '------------------------------------------------------------
    ' Completion message
    '------------------------------------------------------------
    MsgBox _
        "Validation complete (" & resCount & _
        " tabs checked)." & vbCrLf & vbCrLf & _
        "Please review the 'Summary' sheet." & _
        IIf( _
            Not proposedAvailable, _
            vbCrLf & vbCrLf & _
            "Note: U99 and V99 are flagged because the " & _
            "Proposed Config file was not found.", _
            ""), _
        vbInformation, _
        "QC Complete"

    Exit Sub


'====================================================================
' ERROR HANDLER
'====================================================================
ErrHandler:

    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    On Error Resume Next

    If Not wbProposed Is Nothing Then

        wbProposed.Close SaveChanges:=False

    End If

    If Not wbCRL Is Nothing Then

        wbCRL.Close SaveChanges:=False

    End If

    MsgBox _
        "Error: " & Err.Description, _
        vbCritical, _
        "QC Error"

End Sub


'--------------------------------------------------------------------
' Delete every sheet in ThisWorkbook except "Read Me"
'--------------------------------------------------------------------
Sub CleanupSheets()

    Dim ws As Worksheet
    Dim i As Long

    For i = ThisWorkbook.Sheets.Count To 1 Step -1

        Set ws = ThisWorkbook.Sheets(i)

        If ws.Name <> "Read Me" Then

            ws.Delete

        End If

    Next i

End Sub


'--------------------------------------------------------------------
' HELPERS
'--------------------------------------------------------------------
Function SheetExists(wb As Workbook, sName As String) As Boolean

    Dim ws As Worksheet

    If wb Is Nothing Then

        SheetExists = False
        Exit Function

    End If

    On Error Resume Next

    Set ws = wb.Sheets(sName)

    On Error GoTo 0

    SheetExists = Not ws Is Nothing

End Function


Function GetLastRow( _
    ws As Worksheet, _
    Optional colLetter As String = "A") As Long

    GetLastRow = _
        ws.Cells(ws.Rows.Count, colLetter).End(xlUp).Row

    If GetLastRow < 1 Then

        GetLastRow = 1

    End If

End Function


Sub AddResult( _
    tabName As String, _
    result As String, _
    comment As String)

    resCount = resCount + 1

    ReDim Preserve resName(1 To resCount)
    ReDim Preserve resResult(1 To resCount)
    ReDim Preserve resComment(1 To resCount)

    resName(resCount) = tabName
    resResult(resCount) = result
    resComment(resCount) = comment

End Sub


'--------------------------------------------------------------------
' Robust numeric parser
'--------------------------------------------------------------------
Function TryParseNumber( _
    v As Variant, _
    ByRef outVal As Double) As Boolean

    Dim s As String
    Dim ch As String
    Dim i As Long
    Dim cleaned As String

    TryParseNumber = False

    If IsNumeric(v) Then

        outVal = CDbl(v)
        TryParseNumber = True

        Exit Function

    End If

    s = Trim(CStr(v))

    If s = "" Then Exit Function

    cleaned = ""

    For i = 1 To Len(s)

        ch = Mid(s, i, 1)

        If _
            (ch >= "0" And ch <= "9") Or _
            ch = "." Or _
            ch = "-" Then

            cleaned = cleaned & ch

        End If

    Next i

    If _
        cleaned = "" Or _
        cleaned = "-" Or _
        cleaned = "." Then

        Exit Function

    End If

    If IsNumeric(cleaned) Then

        outVal = CDbl(cleaned)
        TryParseNumber = True

    End If

End Function


'--------------------------------------------------------------------
' Simple existence checks
'--------------------------------------------------------------------
Sub Check_SimpleExist(sName As String)

    If SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Validated", _
            "Sheet exists."

    Else

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

    End If

End Sub


'--------------------------------------------------------------------
' C62
' "Rejected" should NOT exist in Column A or B
'--------------------------------------------------------------------
Sub Check_C62()

    Dim sName As String: sName = "C62"

    Dim ws As Worksheet

    Dim lastRowA As Long
    Dim lastRowB As Long
    Dim lastRowVal As Long
    Dim i As Long

    Dim found As Boolean


    If Not SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

        Exit Sub

    End If


    Set ws = wbCRL.Sheets(sName)

    lastRowA = GetLastRow(ws, "A")
    lastRowB = GetLastRow(ws, "B")

    lastRowVal = _
        IIf(lastRowA > lastRowB, lastRowA, lastRowB)

    found = False


    For i = 1 To lastRowVal

        If _
            Trim(LCase(CStr(ws.Cells(i, 1).Value))) = "rejected" _
            Or _
            Trim(LCase(CStr(ws.Cells(i, 2).Value))) = "rejected" Then

            found = True

            Exit For

        End If

    Next i


    If Not found Then

        AddResult _
            sName, _
            "Validated", _
            "'Rejected' value not found in Column A or B."

    Else

        AddResult _
            sName, _
            "Manual validation required", _
            "'Rejected' value found in Column A/B at row " & i & "."

    End If

End Sub


'--------------------------------------------------------------------
' C63
' Where Column A = "0", Column B must also = "0"
'--------------------------------------------------------------------
Sub Check_C63()

    Dim sName As String: sName = "C63"

    Dim ws As Worksheet

    Dim lastRowVal As Long
    Dim i As Long

    Dim allMatch As Boolean
    Dim failRow As Long


    If Not SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

        Exit Sub

    End If


    Set ws = wbCRL.Sheets(sName)

    lastRowVal = GetLastRow(ws, "A")

    allMatch = True


    For i = 1 To lastRowVal

        If Trim(CStr(ws.Cells(i, 1).Value)) = "0" Then

            If Trim(CStr(ws.Cells(i, 2).Value)) <> "0" Then

                allMatch = False
                failRow = i

                Exit For

            End If

        End If

    Next i


    If allMatch Then

        AddResult _
            sName, _
            "Validated", _
            "All '0' values in Column A have corresponding '0' in Column B."

    Else

        AddResult _
            sName, _
            "Manual validation required", _
            "Row " & failRow & _
            ": Column A = 0 but Column B <> 0."

    End If

End Sub


