Option Explicit

'=========================================================================
' TERRITORY QC MACRO
' Call GenerateTerritoryQC from a normal module OR from a UserForm button:
'
'   Call GenerateTerritoryQC(txtConfig.Text, txtExport.Text, txtTerr.Text)
'
' - configPath and exportPath are MANDATORY
' - terrPath is OPTIONAL (pass "" or leave it out if not selected)
' Output sheets ("QC Details - Territory" and "QC Summary - Territory")
' are created in THIS workbook (the one that owns this code).
' All opened source files (Config / Export / Terr) are closed, without
' saving, before the sub ends.
'=========================================================================

Private Const YELLOW As Long = 65535   ' RGB(255,255,0)

' Module-level dictionaries shared between BuildDetailSheet and BuildSummarySheet
Private gDictConfigKeys As Object
Private gDictExportKeys As Object

' The 6 columns we care about, in required order. Position 1 = Territory.
' Territory can also be named "ratingTerritory".
Private Function ColNames(idx As Integer) As Variant
    Select Case idx
        Case 1: ColNames = Array("Territory", "ratingTerritory")
        Case 2: ColNames = Array("Hurricane")
        Case 3: ColNames = Array("Reinsurance")
        Case 4: ColNames = Array("Capital")
        Case 5: ColNames = Array("WildFire")
        Case 6: ColNames = Array("Fixed")
    End Select
End Function

'-------------------------------------------------------------------------
' MAIN ENTRY POINT
'-------------------------------------------------------------------------
Public Sub GenerateTerritoryQC(ByVal configPath As String, _
                                ByVal exportPath As String, _
                                Optional ByVal terrPath As String = "")

    Dim wbConfig As Workbook, wbExport As Workbook, wbTerr As Workbook
    Dim wsConfig As Worksheet, wsExport As Worksheet, wsTerr As Worksheet
    Dim origCalc As XlCalculation

    If Len(Trim(configPath)) = 0 Or Len(Trim(exportPath)) = 0 Then
        Exit Sub   ' mandatory files missing - silently abort (no pop-ups)
    End If
    If Dir(configPath) = "" Or Dir(exportPath) = "" Then
        Exit Sub   ' file(s) not found - silently abort
    End If

    On Error GoTo CleanFail

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    origCalc = Application.Calculation
    Application.Calculation = xlCalculationManual

    Set wbConfig = Workbooks.Open(configPath, UpdateLinks:=0, ReadOnly:=True, AddToMru:=False)
    Set wbExport = Workbooks.Open(exportPath, UpdateLinks:=0, ReadOnly:=True, AddToMru:=False)
    Set wsConfig = FindTerritorySheet(wbConfig)
    Set wsExport = FindTerritorySheet(wbExport)

    Dim terrRowCount As Variant
    terrRowCount = "NA"
    If Len(Trim(terrPath)) > 0 Then
        If Dir(terrPath) <> "" Then
            Set wbTerr = Workbooks.Open(terrPath, UpdateLinks:=0, ReadOnly:=True, AddToMru:=False)
            Set wsTerr = FindTerritorySheet(wbTerr)
            terrRowCount = CountDataRows(wsTerr)
        End If
    End If

    BuildDetailSheet wsConfig, wsExport
    BuildSummarySheet wsConfig, wsExport, terrRowCount

CleanExit:
    On Error Resume Next
    ' --- close every source file that was opened, without saving ---
    If Not wbConfig Is Nothing Then wbConfig.Close SaveChanges:=False
    If Not wbExport Is Nothing Then wbExport.Close SaveChanges:=False
    If Not wbTerr Is Nothing Then wbTerr.Close SaveChanges:=False

    Set wbConfig = Nothing
    Set wbExport = Nothing
    Set wbTerr = Nothing
    Set wsConfig = Nothing
    Set wsExport = Nothing
    Set wsTerr = Nothing

    Application.Calculation = origCalc
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
    Exit Sub

CleanFail:
    Resume CleanExit
End Sub

'-------------------------------------------------------------------------
' Find the correct sheet inside a workbook, case-insensitive,
' with priority: R_L_Territory > Territory Factors > ratingTerritory > Sheet1
'-------------------------------------------------------------------------
Private Function FindTerritorySheet(wb As Workbook) As Worksheet
    Dim names As Variant, i As Long, ws As Worksheet
    names = Array("R_L_Territory", "Territory Factors", "ratingTerritory")

    For i = LBound(names) To UBound(names)
        For Each ws In wb.Worksheets
            If LCase(Trim(ws.Name)) = LCase(Trim(CStr(names(i)))) Then
                Set FindTerritorySheet = ws
                Exit Function
            End If
        Next ws
    Next i

    ' fallback: sheet literally called "Sheet1" (case-insensitive)
    For Each ws In wb.Worksheets
        If LCase(Trim(ws.Name)) = "sheet1" Then
            Set FindTerritorySheet = ws
            Exit Function
        End If
    Next ws

    ' ultimate fallback: first sheet in workbook
    Set FindTerritorySheet = wb.Worksheets(1)
End Function

'-------------------------------------------------------------------------
' Find header row (assumed row 1) column index for a header name list.
' Case-insensitive, whitespace-trimmed. Returns 0 if not found.
'-------------------------------------------------------------------------
Private Function FindColumn(ws As Worksheet, headerRow As Long, names As Variant) As Long
    Dim lastCol As Long, c As Long, n As Long
    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
    If lastCol < 1 Then lastCol = 1

    For c = 1 To lastCol
        Dim hdr As String
        hdr = LCase(Trim(CStr(ws.Cells(headerRow, c).Value)))
        For n = LBound(names) To UBound(names)
            If hdr = LCase(Trim(CStr(names(n)))) Then
                FindColumn = c
                Exit Function
            End If
        Next n
    Next c
    FindColumn = 0
End Function

Private Function LastDataRow(ws As Worksheet, headerRow As Long, keyCol As Long) As Long
    If keyCol = 0 Then
        LastDataRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    Else
        LastDataRow = ws.Cells(ws.Rows.Count, keyCol).End(xlUp).Row
    End If
    If LastDataRow < headerRow Then LastDataRow = headerRow
End Function

Private Function CountDataRows(ws As Worksheet) As Long
    Dim keyCol As Long, lastRow As Long
    keyCol = FindColumn(ws, 1, ColNames(1))
    If keyCol = 0 Then keyCol = 1
    lastRow = LastDataRow(ws, 1, keyCol)
    CountDataRows = lastRow - 1
    If CountDataRows < 0 Then CountDataRows = 0
End Function

'-------------------------------------------------------------------------
' Copy value + number format + alignment from src to dest
'-------------------------------------------------------------------------
Private Sub CopyCellFormatted(srcCell As Range, destCell As Range)
    destCell.Value = srcCell.Value
    destCell.NumberFormat = srcCell.NumberFormat
    destCell.HorizontalAlignment = srcCell.HorizontalAlignment
    destCell.VerticalAlignment = srcCell.VerticalAlignment
End Sub

Private Function CellKey(ws As Worksheet, r As Long, c As Long) As String
    If c = 0 Then
        CellKey = ""
    Else
        CellKey = LCase(Trim(CStr(ws.Cells(r, c).Value)))
    End If
End Function

Private Function ValuesEqual(v1 As Variant, v2 As Variant) As Boolean
    If IsNumeric(v1) And IsNumeric(v2) Then
        ValuesEqual = (Abs(CDbl(v1) - CDbl(v2)) < 0.0000001)
    Else
        ValuesEqual = (LCase(Trim(CStr(v1))) = LCase(Trim(CStr(v2))))
    End If
End Function

'-------------------------------------------------------------------------
' STEP 1: "QC Details - Territory" sheet
'-------------------------------------------------------------------------
Private Sub BuildDetailSheet(wsConfig As Worksheet, wsExport As Worksheet)

    Dim wbOut As Workbook
    Set wbOut = ThisWorkbook

    Dim wsOut As Worksheet
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Worksheets("QC Details - Territory").Delete
    Application.DisplayAlerts = True
    On Error GoTo 0

    Set wsOut = wbOut.Worksheets.Add(After:=wbOut.Worksheets(wbOut.Worksheets.Count))
    wsOut.Name = "QC Details - Territory"

    ' ---- locate config/export columns ----
    Dim cCfg(1 To 6) As Long, cExp(1 To 6) As Long, i As Integer
    For i = 1 To 6
        cCfg(i) = FindColumn(wsConfig, 1, ColNames(i))
        cExp(i) = FindColumn(wsExport, 1, ColNames(i))
    Next i

    Dim lastCfg As Long, lastExp As Long
    lastCfg = LastDataRow(wsConfig, 1, cCfg(1))
    lastExp = LastDataRow(wsExport, 1, cExp(1))

    ' ---- layout ----
    Const COL_CFG_START As Integer = 1   ' A..F
    Const COL_MATCH As Integer = 8       ' H
    Const COL_EXP_START As Integer = 10  ' J..O

    ' ---- headers ----
    For i = 1 To 6
        If cCfg(i) > 0 Then
            CopyCellFormatted wsConfig.Cells(1, cCfg(i)), wsOut.Cells(1, COL_CFG_START + i - 1)
        End If
        If cExp(i) > 0 Then
            CopyCellFormatted wsExport.Cells(1, cExp(i)), wsOut.Cells(1, COL_EXP_START + i - 1)
        End If
    Next i
    wsOut.Cells(1, COL_MATCH).Value = "Match"

    ' ---- build export lookup dictionary: territory key -> collection of row numbers ----
    Dim dictExp As Object
    Set dictExp = CreateObject("Scripting.Dictionary")
    Dim usedExp() As Boolean
    ReDim usedExp(1 To lastExp)

    Dim r As Long, key As String
    If cExp(1) > 0 Then
        For r = 2 To lastExp
            key = CellKey(wsExport, r, cExp(1))
            If key <> "" Then
                If Not dictExp.Exists(key) Then
                    Dim col As Collection
                    Set col = New Collection
                    dictExp.Add key, col
                End If
                dictExp(key).Add r
            End If
        Next r
    End If

    Set gDictConfigKeys = CreateObject("Scripting.Dictionary")
    Set gDictExportKeys = dictExp

    Dim destRow As Long
    destRow = 2

    ' ---- main pass over config rows ----
    If cCfg(1) > 0 Then
        For r = 2 To lastCfg
            key = CellKey(wsConfig, r, cCfg(1))
            If key <> "" Then
                If Not gDictConfigKeys.Exists(key) Then gDictConfigKeys.Add key, True

                ' copy config values
                For i = 1 To 6
                    If cCfg(i) > 0 Then
                        CopyCellFormatted wsConfig.Cells(r, cCfg(i)), wsOut.Cells(destRow, COL_CFG_START + i - 1)
                    End If
                Next i

                ' find a free matching export row
                Dim matchedRow As Long
                matchedRow = 0
                If dictExp.Exists(key) Then
                    Dim itm As Variant
                    For Each itm In dictExp(key)
                        If Not usedExp(CLng(itm)) Then
                            matchedRow = CLng(itm)
                            usedExp(matchedRow) = True
                            Exit For
                        End If
                    Next itm
                End If

                Dim isMatch As Boolean
                isMatch = (matchedRow > 0)

                If matchedRow > 0 Then
                    For i = 1 To 6
                        If cExp(i) > 0 Then
                            CopyCellFormatted wsExport.Cells(matchedRow, cExp(i)), wsOut.Cells(destRow, COL_EXP_START + i - 1)
                            If cCfg(i) > 0 Then
                                If Not ValuesEqual(wsConfig.Cells(r, cCfg(i)).Value, wsExport.Cells(matchedRow, cExp(i)).Value) Then
                                    isMatch = False
                                    wsOut.Cells(destRow, COL_CFG_START + i - 1).Interior.Color = YELLOW
                                    wsOut.Cells(destRow, COL_EXP_START + i - 1).Interior.Color = YELLOW
                                End If
                            End If
                        End If
                    Next i
                Else
                    ' no export match at all - highlight config side
                    For i = 1 To 6
                        If cCfg(i) > 0 Then
                            wsOut.Cells(destRow, COL_CFG_START + i - 1).Interior.Color = YELLOW
                        End If
                    Next i
                End If

                wsOut.Cells(destRow, COL_MATCH).Value = isMatch

                destRow = destRow + 1
            End If
        Next r
    End If

    ' ---- append leftover unmatched export rows at the end ----
    If cExp(1) > 0 Then
        For r = 2 To lastExp
            If Not usedExp(r) Then
                key = CellKey(wsExport, r, cExp(1))
                If key <> "" Then
                    For i = 1 To 6
                        If cExp(i) > 0 Then
                            CopyCellFormatted wsExport.Cells(r, cExp(i)), wsOut.Cells(destRow, COL_EXP_START + i - 1)
                            wsOut.Cells(destRow, COL_EXP_START + i - 1).Interior.Color = YELLOW
                        End If
                    Next i
                    wsOut.Cells(destRow, COL_MATCH).Value = False
                    destRow = destRow + 1
                End If
            End If
        Next r
    End If

    wsOut.Columns.AutoFit
End Sub

'-------------------------------------------------------------------------
' STEP 2: "QC Summary - Territory" sheet
'-------------------------------------------------------------------------
Private Sub BuildSummarySheet(wsConfig As Worksheet, wsExport As Worksheet, terrRowCount As Variant)

    Dim wbOut As Workbook
    Set wbOut = ThisWorkbook

    Dim wsOut As Worksheet
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Worksheets("QC Summary - Territory").Delete
    Application.DisplayAlerts = True
    On Error GoTo 0

    Set wsOut = wbOut.Worksheets.Add(After:=wbOut.Worksheets(wbOut.Worksheets.Count))
    wsOut.Name = "QC Summary - Territory"

    wsOut.Range("A1").Value = "Rows in Territory File"
    wsOut.Range("B1").Value = "Rows in Territory Factors"
    wsOut.Range("C1").Value = "Rows in Config"
    wsOut.Range("D1").Value = "Territory mismatch"
    wsOut.Range("E1").Value = "Missing in"
    wsOut.Range("A1:E1").Font.Bold = True

    wsOut.Range("A2").Value = terrRowCount
    wsOut.Range("B2").Value = CountDataRows(wsExport)
    wsOut.Range("C2").Value = CountDataRows(wsConfig)

    Dim outRow As Long
    outRow = 2

    Dim key As Variant
    If Not gDictConfigKeys Is Nothing Then
        For Each key In gDictConfigKeys.Keys
            If Not gDictExportKeys.Exists(key) Then
                wsOut.Cells(outRow, 4).Value = key
                wsOut.Cells(outRow, 5).Value = "Territory Factors file"
                wsOut.Cells(outRow, 4).Interior.Color = YELLOW
                wsOut.Cells(outRow, 5).Interior.Color = YELLOW
                outRow = outRow + 1
            End If
        Next key
    End If

    If Not gDictExportKeys Is Nothing Then
        For Each key In gDictExportKeys.Keys
            If gDictConfigKeys Is Nothing Then
                wsOut.Cells(outRow, 4).Value = key
                wsOut.Cells(outRow, 5).Value = "Config file"
                wsOut.Cells(outRow, 4).Interior.Color = YELLOW
                wsOut.Cells(outRow, 5).Interior.Color = YELLOW
                outRow = outRow + 1
            ElseIf Not gDictConfigKeys.Exists(key) Then
                wsOut.Cells(outRow, 4).Value = key
                wsOut.Cells(outRow, 5).Value = "Config file"
                wsOut.Cells(outRow, 4).Interior.Color = YELLOW
                wsOut.Cells(outRow, 5).Interior.Color = YELLOW
                outRow = outRow + 1
            End If
        Next key
    End If

    wsOut.Columns.AutoFit
End Sub
