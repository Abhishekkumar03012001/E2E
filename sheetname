'--------------------------------------------------------------------
' U99 / V99
'
' Column B must all be 1 from row 2.
'
' Column A values must match between CRL Config and
' the same-named sheet in Proposed Config.
'--------------------------------------------------------------------
Sub Check_U99()

    CheckU_V_Style "U99"

End Sub


Sub Check_V99()

    CheckU_V_Style "V99"

End Sub


Sub CheckU_V_Style(sName As String)

    Dim wsCRL As Worksheet
    Dim wsProp As Worksheet

    Dim lastRowB As Long
    Dim lastRowCRL_A As Long
    Dim lastRowProp As Long

    Dim i As Long
    Dim j As Long

    Dim allOne As Boolean
    Dim failRow As Long

    Dim allCommon As Boolean

    Dim missingFromCRL As String
    Dim missingFromProp As String

    Dim dictCRL As Object
    Dim dictProp As Object

    Dim v As String


    If Not SheetExists(wbCRL, sName) Then

        AddResult _
            sName, _
            "Sheet does not exists", _
            "Sheet """ & sName & """ not found in CRL Config."

        Exit Sub

    End If


    Set wsCRL = wbCRL.Sheets(sName)

    lastRowB = GetLastRow(wsCRL, "B")

    allOne = True


    For i = 2 To lastRowB

        If Trim(CStr(wsCRL.Cells(i, 2).Value)) <> "1" Then

            allOne = False

            failRow = i

            Exit For

        End If

    Next i


    allCommon = True

    missingFromCRL = ""
    missingFromProp = ""


    Set dictCRL = _
        CreateObject("Scripting.Dictionary")


    lastRowCRL_A = GetLastRow(wsCRL, "A")


    For i = 2 To lastRowCRL_A

        v = Trim(CStr(wsCRL.Cells(i, 1).Value))

        If v <> "" Then

            dictCRL(v) = True

        End If

    Next i


    '------------------------------------------------------------
    ' Compare against Proposed Config
    '------------------------------------------------------------
    If SheetExists(wbProposed, sName) Then

        Set wsProp = wbProposed.Sheets(sName)

        lastRowProp = GetLastRow(wsProp, "A")


        Set dictProp = _
            CreateObject("Scripting.Dictionary")


        For j = 2 To lastRowProp

            v = Trim(CStr(wsProp.Cells(j, 1).Value))

            If v <> "" Then

                dictProp(v) = True

            End If

        Next j


        '--------------------------------------------------------
        ' Check Proposed values missing from CRL
        '--------------------------------------------------------
        For j = 2 To lastRowProp

            v = Trim(CStr(wsProp.Cells(j, 1).Value))

            If v <> "" Then

                If Not dictCRL.Exists(v) Then

                    allCommon = False

                    missingFromCRL = _
                        missingFromCRL & v & "; "

                End If

            End If

        Next j


        '--------------------------------------------------------
        ' Check CRL values missing from Proposed
        '--------------------------------------------------------
        For i = 2 To lastRowCRL_A

            v = Trim(CStr(wsCRL.Cells(i, 1).Value))

            If v <> "" Then

                If Not dictProp.Exists(v) Then

                    allCommon = False

                    missingFromProp = _
                        missingFromProp & v & "; "

                End If

            End If

        Next i


    Else

        allCommon = False

        missingFromCRL = _
            "Sheet """ & sName & _
            """ not found in Proposed Config to compare against."

    End If


    '------------------------------------------------------------
    ' Final result
    '------------------------------------------------------------
    If allOne And allCommon Then

        AddResult _
            sName, _
            "Validated", _
            "All Column B values = 1 and Column A matches between CRL Config and Proposed Config."

    Else

        Dim c As String

        c = ""


        If Not allOne Then

            c = _
                c & _
                "Row " & failRow & _
                ": Column B <> 1. "

        End If


        If missingFromCRL <> "" Then

            c = _
                c & _
                "In Proposed Config but not in CRL Config: " & _
                missingFromCRL

        End If


        If missingFromProp <> "" Then

            c = _
                c & _
                "In CRL Config but not in Proposed Config: " & _
                missingFromProp

        End If


        AddResult _
            sName, _
            "Manual validation required", _
            c

    End If

End Sub


'--------------------------------------------------------------------
' COPY SHEETS THAT EXIST BUT FAILED VALIDATION
' right after "Read Me"
'--------------------------------------------------------------------
Sub CopyFailingSheets()

    Dim i As Long

    Dim sName As String

    Dim insertAfterIndex As Long


    insertAfterIndex = _
        ThisWorkbook.Sheets("Read Me").Index


    For i = 1 To resCount

        If resResult(i) = _
           "Manual validation required" Then

            sName = resName(i)


            If SheetExists(wbCRL, sName) Then

                wbCRL.Sheets(sName).Copy _
                    After:=ThisWorkbook.Sheets( _
                    insertAfterIndex)

                insertAfterIndex = _
                    insertAfterIndex + 1

            End If

        End If

    Next i

End Sub


'--------------------------------------------------------------------
' BUILD SUMMARY SHEET
'--------------------------------------------------------------------
Sub BuildSummarySheet()

    Dim wsSummary As Worksheet

    Dim i As Long


    If resCount = 0 Then

        MsgBox _
            "No validation results were generated." & _
            vbCrLf & _
            "Please run QCrun from the UserForm.", _
            vbExclamation

        Exit Sub

    End If


    Application.DisplayAlerts = False


    On Error Resume Next

    ThisWorkbook.Sheets("Summary").Delete

    On Error GoTo 0


    Application.DisplayAlerts = True


    Set wsSummary = _
        ThisWorkbook.Sheets.Add( _
        After:=ThisWorkbook.Sheets("Read Me"))


    wsSummary.Name = "Summary"

    wsSummary.Cells.Font.Size = 11


    '------------------------------------------------------------
    ' Headers
    '------------------------------------------------------------
    wsSummary.Range("A1").Value = "Tab Name"
    wsSummary.Range("B1").Value = "Result"
    wsSummary.Range("C1").Value = "Comments"
    wsSummary.Range("D1").Value = "Analyst Comment"


    With wsSummary.Range("A1:D1")

        .Font.Bold = True

        .Font.Size = 11

        .Font.Color = RGB(255, 255, 255)

        .Interior.Color = RGB(0, 0, 90)

    End With


    '------------------------------------------------------------
    ' Results
    '------------------------------------------------------------
    For i = 1 To resCount

        wsSummary.Cells(i + 1, 1).Value = _
            resName(i)

        wsSummary.Cells(i + 1, 2).Value = _
            resResult(i)

        wsSummary.Cells(i + 1, 3).Value = _
            resComment(i)

        wsSummary.Cells(i + 1, 4).Value = ""


        wsSummary.Range( _
            wsSummary.Cells(i + 1, 1), _
            wsSummary.Cells(i + 1, 4)).Font.Size = 11


        Select Case resResult(i)

            Case "Manual validation required"

                wsSummary.Cells(i + 1, 2).Interior.Color = _
                    RGB(255, 199, 206)

                wsSummary.Cells(i + 1, 2).Font.Color = _
                    RGB(0, 0, 0)


            Case "Sheet does not exists"

                wsSummary.Cells(i + 1, 2).Interior.Color = _
                    RGB(255, 255, 153)

                wsSummary.Cells(i + 1, 2).Font.Color = _
                    RGB(0, 0, 0)

        End Select

    Next i


    '------------------------------------------------------------
    ' Formatting
    '------------------------------------------------------------
    With wsSummary

        .Columns("A").ColumnWidth = 14

        .Columns("B").ColumnWidth = 24

        .Columns("C").ColumnWidth = 70

        .Columns("D").ColumnWidth = 30

        .Columns("C").WrapText = True

        .Rows("2:" & (resCount + 1)).AutoFit

        .Range( _
            "A1:D" & (resCount + 1)).Borders.LineStyle = _
            xlContinuous

        .Range( _
            "A1:D" & (resCount + 1)).AutoFilter

    End With

End Sub
