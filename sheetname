'Create or update the hidden "Paths" sheet
Dim wsPaths As Worksheet

On Error Resume Next
Set wsPaths = wbDst.Worksheets("Paths")
On Error GoTo CleanFail

'If Paths sheet does not exist, create it
If wsPaths Is Nothing Then
    Set wsPaths = wbDst.Worksheets.Add(After:=wbDst.Worksheets(wbDst.Worksheets.Count))
    wsPaths.Name = "Paths"
End If

'Save the new file path in B2
wsPaths.Range("B2").Value = newFilePath

'Always keep the Paths sheet hidden
wsPaths.Visible = xlSheetVeryHidden

'Save the new workbook
wbDst.SaveAs Filename:=newFilePath, FileFormat:=saveFormat
