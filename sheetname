Sub UpdateHyperlinksOnly()

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets("Result")   ' change to "Results" if that's the actual tab name

    Dim targetCells As Variant
    Dim sheetLinks As Variant
    targetCells = Array("H10", "J10")
    sheetLinks = Array("TabQC_Row", "TabQC_Col")

    Dim i As Integer
    Dim c As Range
    Dim anchorCell As Range
    Dim displayText As String

    For i = LBound(targetCells) To UBound(targetCells)

        Set c = ws.Range(targetCells(i))

        ' If the cell is part of a merged range, get the top-left cell of that merge
        If c.MergeCells Then
            Set anchorCell = c.MergeArea.Cells(1, 1)
        Else
            Set anchorCell = c
        End If

        displayText = anchorCell.Value

        ' Avoid the error if the cell is blank - fallback to a default label
        If Trim(displayText) = "" Then
            displayText = sheetLinks(i)
        End If

        ' Remove any existing hyperlink on that anchor cell first
        anchorCell.Hyperlinks.Delete

        ' Add the hyperlink
        ws.Hyperlinks.Add _
            Anchor:=anchorCell, _
            Address:="", _
            SubAddress:="'" & sheetLinks(i) & "'!A1", _
            TextToDisplay:=displayText

    Next i

    MsgBox "Hyperlinks updated successfully (merge-safe).", vbInformation

End Sub
