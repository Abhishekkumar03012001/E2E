Sub UnmergeAndKeepRightValueWithHyperlink()
    Dim ws As Worksheet
    Dim ranges As Variant
    Dim i As Integer
    Dim leftCell As Range, rightCell As Range
    Dim val As Variant
    Dim hAddress As String, hSubAddress As String
    Dim hTextToDisplay As String, hScreenTip As String
    Dim hasHyperlink As Boolean

    Set ws = ThisWorkbook.Sheets("Result")

    ranges = Array("G10:H10", "G11:H11", "I10:J10", "I11:J11")

    Application.ScreenUpdating = False

    For i = LBound(ranges) To UBound(ranges)
        With ws.Range(ranges(i))
            Set leftCell = .Cells(1, 1)
            Set rightCell = .Cells(1, 2)

            val = leftCell.Value

            hasHyperlink = False
            hAddress = ""
            hSubAddress = ""
            hTextToDisplay = ""
            hScreenTip = ""

            If leftCell.Hyperlinks.Count > 0 Then
                hasHyperlink = True
                With leftCell.Hyperlinks(1)
                    hAddress = .Address
                    hSubAddress = .SubAddress
                    hTextToDisplay = .TextToDisplay
                    On Error Resume Next
                    hScreenTip = .ScreenTip
                    On Error GoTo 0
                End With
            End If

            ' Fallback: if TextToDisplay is blank, use the cell's value instead
            If hasHyperlink And Trim(hTextToDisplay) = "" Then
                If Len(Trim(CStr(val))) > 0 Then
                    hTextToDisplay = CStr(val)
                Else
                    hTextToDisplay = IIf(hAddress <> "", hAddress, hSubAddress)
                End If
            End If

            .UnMerge
        End With

        leftCell.Clear

        If hasHyperlink Then
            On Error Resume Next
            If hScreenTip <> "" Then
                ws.Hyperlinks.Add Anchor:=rightCell, Address:=hAddress, _
                    SubAddress:=hSubAddress, ScreenTip:=hScreenTip, _
                    TextToDisplay:=hTextToDisplay
            Else
                ws.Hyperlinks.Add Anchor:=rightCell, Address:=hAddress, _
                    SubAddress:=hSubAddress, TextToDisplay:=hTextToDisplay
            End If
            If Err.Number <> 0 Then
                ' Fallback: hyperlink creation failed, just write the value as plain text
                rightCell.Value = val
                Err.Clear
            End If
            On Error GoTo 0
        Else
            rightCell.Value = val
        End If

    Next i

    Application.ScreenUpdating = True

    MsgBox "Done! Cells unmerged, values moved, and hyperlinks preserved.", vbInformation
End Sub
