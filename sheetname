Sub CreateQCHyperlinks()

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets("Results")

    'H10 → TabQC_Row
    With ws.Range("H10")
        .Hyperlinks.Delete
        ws.Hyperlinks.Add _
            Anchor:=.Cells(1, 1), _
            Address:="", _
            SubAddress:="'TabQC_Row'!A1", _
            TextToDisplay:="Prop to FR"
    End With

    'J10 → TabQC_Col
    With ws.Range("J10")
        .Hyperlinks.Delete
        ws.Hyperlinks.Add _
            Anchor:=.Cells(1, 1), _
            Address:="", _
            SubAddress:="'TabQC_Col'!A1", _
            TextToDisplay:="Prop to FR"
    End With

End Sub
