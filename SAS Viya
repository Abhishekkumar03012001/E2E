/* ==================================================================
   Average of all numeric columns in all sheets of an Excel file.
   Creates a NEW Excel output file. SAS Viya / PROC PYTHON.
   ================================================================== */

proc python;
submit;

import os
import sys
import traceback

# ---------------- 1. SET YOUR PATHS HERE (server paths) -------------
input_path  = "/path/to/your/input_file.xlsx"        # <-- change this
output_path = "/path/to/your/output_averages.xlsx"   # <-- change this
# --------------------------------------------------------------------

try:
    import pandas as pd

    print("Python version :", sys.version.split()[0])
    print("pandas version :", pd.__version__)
    print("Input file     :", input_path)
    print("Output file    :", output_path)

    # --- checks -------------------------------------------------------
    if not os.path.exists(input_path):
        raise FileNotFoundError(
            "Input file not found on the server: " + input_path +
            "  (use a path on the Viya server, not on your PC)")

    try:
        import openpyxl
    except ImportError:
        raise ImportError("openpyxl is not installed in this Python environment. "
                          "Ask your admin to install it.")

    # Writer engine: openpyxl, or xlsxwriter if available
    writer_engine = "openpyxl"

    # Make sure the output folder exists
    out_dir = os.path.dirname(output_path)
    if out_dir and not os.path.exists(out_dir):
        os.makedirs(out_dir, exist_ok=True)

    # --- read all sheets ----------------------------------------------
    all_sheets = pd.read_excel(input_path, sheet_name=None, engine="openpyxl")
    print("Sheets found   :", list(all_sheets.keys()))

    # --- calculate averages -------------------------------------------
    summary_rows = []
    per_sheet = {}

    for sheet_name, df in all_sheets.items():
        numeric_df = df.select_dtypes(include="number")

        if numeric_df.empty:
            print("Sheet '" + str(sheet_name) + "': no numeric columns, skipped.")
            continue

        averages = numeric_df.mean(skipna=True)

        per_sheet[str(sheet_name)] = pd.DataFrame({
            "Column": [str(c) for c in averages.index],
            "Average": [float(v) for v in averages.values]
        })

        for col, avg in averages.items():
            summary_rows.append({
                "Sheet": str(sheet_name),
                "Column": str(col),
                "Average": float(avg)
            })

    if not summary_rows:
        raise ValueError("No numeric columns found in any sheet.")

    summary_df = pd.DataFrame(summary_rows)

    # --- write NEW Excel file ----------------------------------------
    with pd.ExcelWriter(output_path, engine=writer_engine) as writer:
        summary_df.to_excel(writer, sheet_name="Summary", index=False)
        for sheet_name, avg_df in per_sheet.items():
            safe_name = ("Avg_" + sheet_name)[:31]
            avg_df.to_excel(writer, sheet_name=safe_name, index=False)

    print("SUCCESS: Excel file created ->", output_path)
    print(summary_df.to_string(index=False))

    # --- optional: also create a SAS table (failure here is harmless) -
    try:
        SAS.df2sd(summary_df, "work.column_averages")
        print("SAS table WORK.COLUMN_AVERAGES created.")
    except Exception as e:
        print("Note: could not create SAS table (Excel file is fine):", e)

except Exception:
    print("=========== PYTHON ERROR ===========")
    print(traceback.format_exc())

endsubmit;
run;


/* Only print the SAS table if it was actually created */
%macro show_result;
  %if %sysfunc(exist(work.column_averages)) %then %do;
    proc print data=work.column_averages noobs;
    run;
  %end;
%mend show_result;
%show_result;
