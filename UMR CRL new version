Option Explicit

'=====================================================================
' CONSTANTS
'=====================================================================
Private Const WR_AB_MIN_COL As Long = 28   ' Column AB - start of the "paste values" block in Weighted Rates
Private Const WR_AB_MAX_COL As Long = 39   ' Column AM - end of the "paste values" block in Weighted Rates
Private Const WR_ROC_MIN_COL As Long = 4   ' Column D  - start of the ROC-fill block AND the block that always has titles
Private Const WR_ROC_MAX_COL As Long = 15  ' Column O  - end of the ROC-fill / title block
Private Const WR_AB_OFFSET As Long = 24    ' AB block sits exactly 24 columns to the right of the D block (2 blocks over)

'=====================================================================
' ENTRY POINT FOR YOUR USERFORM
' Call this directly from your form's button click, e.g.:
'
'   Private Sub cmdRun_Click()
'       TerritoryMutiple txtRoc.Value, txtFR.Value, txtProp.Value, statebox.Value
'   End Sub
'
' Parameters:
'   rocPathIn   -> ROC file path            (txtRoc.Value)
'   frPathIn    -> FR UMR file path          (txtFR.Value)
'   propPathIn  -> Proportion file path      (txtProp.Value)
'   stateAbbrev -> two-letter state code     (statebox.Value)
'=====================================================================
Public Sub TerritoryMutiple(ByVal rocPathIn As String, ByVal frPathIn As String, _
                             ByVal propPathIn As String, ByVal stateAbbrev As String)

    ' ---- basic validation up front, so the form gets a clear message ----
    If Len(Trim(rocPathIn)) = 0 Or Len(Trim(frPathIn)) = 0 Or Len(Trim(propPathIn)) = 0 Then
        MsgBox "Please provide the ROC, FR, and Proportion file paths.", vbExclamation
        Exit Sub
    End If
    If Len(Trim(stateAbbrev)) = 0 Then
        MsgBox "Please provide a state abbreviation.", vbExclamation
        Exit Sub
    End If
    If Dir(rocPathIn) = "" Then
        MsgBox "ROC file not found:" & vbCrLf & rocPathIn, vbExclamation
        Exit Sub
    End If
    If Dir(frPathIn) = "" Then
        MsgBox "FR file not found:" & vbCrLf & frPathIn, vbExclamation
        Exit Sub
    End If
    If Dir(propPathIn) = "" Then
        MsgBox "Proportion file not found:" & vbCrLf & propPathIn, vbExclamation
        Exit Sub
    End If

    Call GenerateStateRateFile(rocPathIn, frPathIn, propPathIn, Trim(stateAbbrev))

End Sub

