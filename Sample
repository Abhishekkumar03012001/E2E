Sub BuildSummarySheet()

    Dim wbReport As Workbook
    Dim wsSummary As Worksheet
    Dim i As Long
    Dim reportPath As String

    If resCount = 0 Then

        MsgBox _
            "No validation results were generated." & vbCrLf & _
            "Please run Qrun from the UserForm.", _
            vbExclamation

        Exit Sub

    End If

    '----------------------------------------------------------
    ' Create a NEW workbook for the QC report
    '----------------------------------------------------------

    Set wbReport = Workbooks.Add(xlWBATWorksheet)

    Set wsSummary = wbReport.Worksheets(1)

    wsSummary.Name = "Summary"

    wsSummary.Cells.Font.Size = 11

    '----------------------------------------------------------
    ' Headers
    '----------------------------------------------------------

    wsSummary.Range("A1").Value = "Tab Name"
    wsSummary.Range("B1").Value = "Result"
    wsSummary.Range("C1").Value = "Comments"
    wsSummary.Range("D1").Value = "Analyst Comment"

    With wsSummary.Range("A1:D1")

        .Font.Bold = True
        .Font.Size = 11
        .Font.Color = RGB(255, 255, 255)
        .Interior.Color = RGB(0, 0, 90)

    End With

    '----------------------------------------------------------
    ' Results
    '----------------------------------------------------------

    For i = 1 To resCount

        wsSummary.Cells(i + 1, 1).Value = _
            resName(i)

        wsSummary.Cells(i + 1, 2).Value = _
            resResult(i)

        wsSummary.Cells(i + 1, 3).Value = _
            resComment(i)

        wsSummary.Cells(i + 1, 4).Value = ""

        wsSummary.Range( _
            wsSummary.Cells(i + 1, 1), _
            wsSummary.Cells(i + 1, 4) _
        ).Font.Size = 11

        '------------------------------------------------------
        ' Format Result column based on validation result
        '------------------------------------------------------

        Select Case resResult(i)

            Case "Manual validation required"

                wsSummary.Cells(i + 1, 2).Interior.Color = _
                    RGB(255, 199, 206)

                wsSummary.Cells(i + 1, 2).Font.Color = _
                    RGB(0, 0, 0)

            Case "Sheet does not exists"

                wsSummary.Cells(i + 1, 2).Interior.Color = _
                    RGB(255, 255, 153)

                wsSummary.Cells(i + 1, 2).Font.Color = _
                    RGB(0, 0, 0)

        End Select

    Next i

    '----------------------------------------------------------
    ' Formatting
    '----------------------------------------------------------

    With wsSummary

        .Columns("A").ColumnWidth = 14
        .Columns("B").ColumnWidth = 24
        .Columns("C").ColumnWidth = 70
        .Columns("D").ColumnWidth = 30

        .Columns("C").WrapText = True

        .Rows("2:" & (resCount + 1)).AutoFit

        .Range( _
            "A1:D" & (resCount + 1) _
        ).Borders.LineStyle = xlContinuous

        .Range( _
            "A1:D" & (resCount + 1) _
        ).AutoFilter

    End With

    '----------------------------------------------------------
    ' Save the NEW workbook
    '----------------------------------------------------------

    reportPath = ThisWorkbook.Path & _
                 Application.PathSeparator & _
                 "UMB CRL Config QC report.xlsx"

    Application.DisplayAlerts = False

    'Delete old report if it already exists
    If Dir(reportPath) <> "" Then
        Kill reportPath
    End If

    wbReport.SaveAs _
        Filename:=reportPath, _
        FileFormat:=xlOpenXMLWorkbook

    Application.DisplayAlerts = True

    '----------------------------------------------------------
    ' Activate the newly created report
    '----------------------------------------------------------

    wbReport.Activate
    wsSummary.Activate

End Sub
