Option Explicit

Sub GenerateOutputSheet()

    Dim fd As FileDialog
    Dim i As Long, r As Long
    Dim wbArr(1 To 6) As Workbook
    Dim wbName(1 To 6) As String
    Dim wasOpenArr(1 To 6) As Boolean
    Dim filePath As String, fileNameOnly As String
    Dim ws As Worksheet
    Dim outWs As Worksheet
    Dim masterDict As Object
    Dim fileDict(1 To 6) As Object
    Dim keysArr() As Variant
    Dim lastRow As Long
    Dim keyVal As String, cellVal As String, cVal As String
    Dim existCount As Long
    Dim wbTemp As Workbook

    Set masterDict = CreateObject("Scripting.Dictionary")
    masterDict.CompareMode = vbTextCompare

    ' Step 1: Let user select exactly 6 Excel files
    Set fd = Application.FileDialog(msoFileDialogFilePicker)
    fd.Title = "Select exactly 6 Excel files"
    fd.Filters.Clear
    fd.Filters.Add "Excel Files", "*.xlsx; *.xls; *.xlsm"
    fd.AllowMultiSelect = True

    If fd.Show <> -1 Then
        MsgBox "No files selected. Macro cancelled.", vbExclamation
        Exit Sub
    End If

    If fd.SelectedItems.Count <> 6 Then
        MsgBox "Please select exactly 6 files. You selected " & fd.SelectedItems.Count & ".", vbExclamation
        Exit Sub
    End If

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    ' Step 2: Open each file (if not already open) and read data
    For i = 1 To 6
        filePath = fd.SelectedItems(i)
        fileNameOnly = Mid(filePath, InStrRev(filePath, "\") + 1)
        wbName(i) = Left(fileNameOnly, InStrRev(fileNameOnly, ".") - 1) ' name without extension

        Set wbTemp = Nothing
        On Error Resume Next
        Set wbTemp = Workbooks(fileNameOnly)
        On Error GoTo 0

        If wbTemp Is Nothing Then
            Set wbArr(i) = Workbooks.Open(filePath, ReadOnly:=True)
            wasOpenArr(i) = False
        Else
            Set wbArr(i) = wbTemp
            wasOpenArr(i) = True
        End If

        Set fileDict(i) = CreateObject("Scripting.Dictionary")
        fileDict(i).CompareMode = vbTextCompare

        Set ws = Nothing
        On Error Resume Next
        Set ws = wbArr(i).Worksheets("Comparison_Output")
        On Error GoTo 0

        If ws Is Nothing Then
            MsgBox "'Comparison_Output' sheet not found in file: " & wbName(i), vbExclamation
        Else
            lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
            For r = 2 To lastRow
                cellVal = Trim(CStr(ws.Cells(r, "A").Value))
                If cellVal <> "" Then
                    keyVal = LCase(cellVal)

                    If Not fileDict(i).Exists(keyVal) Then
                        fileDict(i).Add keyVal, True
                    End If

                    cVal = Trim(CStr(ws.Cells(r, "C").Value))
                    If StrComp(cVal, "Sheet Not Found in Dislocation", vbTextCompare) = 0 Then
                        If Not masterDict.Exists(keyVal) Then
                            masterDict.Add keyVal, cellVal
                        End If
                    End If
                End If
            Next r
        End If

        If Not wasOpenArr(i) Then
            wbArr(i).Close SaveChanges:=False
        End If
    Next i

    ' Step 3: Create / reset Output sheet in ThisWorkbook
    On Error Resume Next
    ThisWorkbook.Worksheets("Output").Delete
    On Error GoTo 0

    Set outWs = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
    outWs.Name = "Output"

    outWs.Cells(1, 1).Value = "Value"
    For i = 1 To 6
        outWs.Cells(1, i + 1).Value = wbName(i)
    Next i
    outWs.Rows(1).Font.Bold = True

    ' Step 4: Write unique values and check existence in each file
    keysArr = masterDict.Keys

    For r = 0 To UBound(keysArr)
        keyVal = keysArr(r)
        outWs.Cells(r + 2, 1).Value = masterDict(keyVal)

        existCount = 0
        For i = 1 To 6
            If fileDict(i).Exists(keyVal) Then
                outWs.Cells(r + 2, i + 1).Value = "Exist in it"
                outWs.Cells(r + 2, i + 1).Font.Color = RGB(0, 128, 0)
                outWs.Cells(r + 2, i + 1).Font.Bold = True
                existCount = existCount + 1
            Else
                outWs.Cells(r + 2, i + 1).Value = "Dont exist"
                outWs.Cells(r + 2, i + 1).Font.Color = RGB(255, 0, 0)
                outWs.Cells(r + 2, i + 1).Font.Bold = True
            End If
        Next i

        If existCount = 6 Then
            outWs.Cells(r + 2, 1).Interior.Color = RGB(255, 255, 0)
        End If
    Next r

    outWs.Columns("A:G").AutoFit

    Application.ScreenUpdating = True
    Application.DisplayAlerts = True

    MsgBox "Done! Output sheet created with " & (UBound(keysArr) + 1) & " unique value(s).", vbInformation

End Sub
