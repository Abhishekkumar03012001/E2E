Option Explicit

Sub CheckFireHailColumns()

    Dim configWB As Workbook
    Dim radWB As Workbook
    Dim configPath As String
    Dim radPath As String
    Dim radOutputSheet As Worksheet
    Dim configSheet As Worksheet
    Dim resultSheet As Worksheet
    Dim lastRow As Long
    Dim i As Long
    Dim outRow As Long
    Dim sheetName As String
    Dim fireFound As Boolean
    Dim hailFound As Boolean
    Dim lastHeaderCol As Long
    Dim j As Long
    Dim sheetExists As Boolean
    Dim headerVal As String
    Dim ws As Worksheet

    ' ---- Ask user to select the CONFIG file ----
    configPath = Application.GetOpenFilename("Excel Files (*.xls*), *.xls*", , "Select CONFIG File")
    If configPath = "False" Then
        MsgBox "Config file not selected. Exiting.", vbExclamation
        Exit Sub
    End If

    ' ---- Ask user to select the RAD file ----
    radPath = Application.GetOpenFilename("Excel Files (*.xls*), *.xls*", , "Select RAD File")
    If radPath = "False" Then
        MsgBox "RAD file not selected. Exiting.", vbExclamation
        Exit Sub
    End If

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    ' ---- Open both workbooks ----
    Set configWB = Workbooks.Open(configPath)
    Set radWB = Workbooks.Open(radPath)

    ' ---- Get the Output sheet from RAD file (source of sheet names) ----
    On Error Resume Next
    Set radOutputSheet = radWB.Sheets("Output")
    On Error GoTo 0

    If radOutputSheet Is Nothing Then
        MsgBox "Sheet 'Output' not found in RAD file.", vbCritical
        GoTo CleanExit
    End If

    ' ---- Find last row in Column A of RAD's Output sheet ----
    lastRow = radOutputSheet.Cells(radOutputSheet.Rows.Count, "A").End(xlUp).Row

    ' ---- Create a NEW result sheet in THIS workbook (delete old one if it exists) ----
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Sheets("Fire_Hail_Analysis").Delete
    Application.DisplayAlerts = True
    On Error GoTo 0

    Set resultSheet = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
    resultSheet.Name = "Fire_Hail_Analysis"

    ' ---- Headers ----
    resultSheet.Cells(1, 1).Value = "Sheet Name"
    resultSheet.Cells(1, 2).Value = "Sheet Exists in Config"
    resultSheet.Cells(1, 3).Value = "Fire Column Found"
    resultSheet.Cells(1, 4).Value = "Hail Column Found"
    resultSheet.Cells(1, 5).Value = "Remarks"

    outRow = 2

    ' ---- Loop through each sheet name in Column A of RAD's Output sheet ----
    For i = 2 To lastRow

        sheetName = Trim(radOutputSheet.Cells(i, 1).Value)

        If sheetName <> "" Then

            fireFound = False
            hailFound = False
            sheetExists = False
            Set configSheet = Nothing

            ' Check if a sheet with this name exists in config workbook
            On Error Resume Next
            Set configSheet = configWB.Sheets(sheetName)
            On Error GoTo 0

            If Not configSheet Is Nothing Then
                sheetExists = True

                ' Find last column with data in header row (row 1) of config sheet
                lastHeaderCol = configSheet.Cells(1, configSheet.Columns.Count).End(xlToLeft).Column

                ' Loop through header row to check for "Fire" and "Hail"
                For j = 1 To lastHeaderCol
                    headerVal = Trim(configSheet.Cells(1, j).Value)

                    If StrComp(headerVal, "Fire", vbTextCompare) = 0 Then
                        fireFound = True
                    End If

                    If StrComp(headerVal, "Hail", vbTextCompare) = 0 Then
                        hailFound = True
                    End If
                Next j

            End If

            ' ---- Write results into the NEW sheet in THIS workbook ----
            resultSheet.Cells(outRow, 1).Value = sheetName
            resultSheet.Cells(outRow, 2).Value = IIf(sheetExists, "Yes", "No")
            resultSheet.Cells(outRow, 3).Value = IIf(fireFound, "Yes", "No")
            resultSheet.Cells(outRow, 4).Value = IIf(hailFound, "Yes", "No")

            If Not sheetExists Then
                resultSheet.Cells(outRow, 5).Value = "Sheet not found in Config file"
            ElseIf fireFound And hailFound Then
                resultSheet.Cells(outRow, 5).Value = "OK - Both columns present"
            ElseIf Not fireFound And Not hailFound Then
                resultSheet.Cells(outRow, 5).Value = "Missing both Fire and Hail columns"
            ElseIf Not fireFound Then
                resultSheet.Cells(outRow, 5).Value = "Missing Fire column"
            ElseIf Not hailFound Then
                resultSheet.Cells(outRow, 5).Value = "Missing Hail column"
            End If

            outRow = outRow + 1

        End If

    Next i

    ' ---- Formatting ----
    resultSheet.Range("A1:E1").Font.Bold = True
    resultSheet.Columns("A:E").AutoFit

    ' ---- Close Config and RAD workbooks without saving (leave them untouched) ----
    configWB.Close SaveChanges:=False
    radWB.Close SaveChanges:=False

    MsgBox "Analysis completed! Results are in sheet 'Fire_Hail_Analysis' in this file.", vbInformation

CleanExit:
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

End Sub
