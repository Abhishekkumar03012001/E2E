Option Explicit

Sub CheckFireHailColumns()

    Dim configWB As Workbook
    Dim radWB As Workbook
    Dim configPath As String
    Dim radPath As String
    Dim radOutputSheet As Worksheet
    Dim configSheet As Worksheet
    Dim lastRow As Long
    Dim i As Long
    Dim sheetName As String
    Dim fireFound As Boolean
    Dim hailFound As Boolean
    Dim resultCol As Long
    Dim headerCell As Range
    Dim lastHeaderCol As Long
    Dim j As Long
    Dim sh As Worksheet
    Dim sheetExists As Boolean

    ' ---- Ask user to select the two files ----
    configPath = Application.GetOpenFilename("Excel Files (*.xls*), *.xls*", , "Select CONFIG File")
    If configPath = "False" Then
        MsgBox "Config file not selected. Exiting.", vbExclamation
        Exit Sub
    End If

    radPath = Application.GetOpenFilename("Excel Files (*.xls*), *.xls*", , "Select RAD File")
    If radPath = "False" Then
        MsgBox "RAD file not selected. Exiting.", vbExclamation
        Exit Sub
    End If

    ' ---- Open both workbooks ----
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    Set configWB = Workbooks.Open(configPath)
    Set radWB = Workbooks.Open(radPath)

    ' ---- Get the Output sheet from RAD file ----
    On Error Resume Next
    Set radOutputSheet = radWB.Sheets("Output")
    On Error GoTo 0

    If radOutputSheet Is Nothing Then
        MsgBox "Sheet 'Output' not found in RAD file.", vbCritical
        GoTo CleanExit
    End If

    ' ---- Find last row in Column A of Output sheet ----
    lastRow = radOutputSheet.Cells(radOutputSheet.Rows.Count, "A").End(xlUp).Row

    ' ---- Prepare result columns in Output sheet ----
    radOutputSheet.Cells(1, 2).Value = "Sheet Exists in Config"
    radOutputSheet.Cells(1, 3).Value = "Fire Column Found"
    radOutputSheet.Cells(1, 4).Value = "Hail Column Found"
    radOutputSheet.Cells(1, 5).Value = "Remarks"

    ' ---- Loop through each sheet name in Column A ----
    For i = 2 To lastRow

        sheetName = Trim(radOutputSheet.Cells(i, 1).Value)

        If sheetName <> "" Then

            fireFound = False
            hailFound = False
            sheetExists = False
            Set configSheet = Nothing

            ' Check if a sheet with this name exists in config workbook
            On Error Resume Next
            Set configSheet = configWB.Sheets(sheetName)
            On Error GoTo 0

            If Not configSheet Is Nothing Then
                sheetExists = True

                ' Find last column with data in header row (row 1) of config sheet
                lastHeaderCol = configSheet.Cells(1, configSheet.Columns.Count).End(xlToLeft).Column

                ' Loop through header row to check for "Fire" and "Hail"
                For j = 1 To lastHeaderCol
                    Dim headerVal As String
                    headerVal = Trim(configSheet.Cells(1, j).Value)

                    If StrComp(headerVal, "Fire", vbTextCompare) = 0 Then
                        fireFound = True
                    End If

                    If StrComp(headerVal, "Hail", vbTextCompare) = 0 Then
                        hailFound = True
                    End If
                Next j

            End If

            ' ---- Write results back to Output sheet ----
            radOutputSheet.Cells(i, 2).Value = IIf(sheetExists, "Yes", "No")
            radOutputSheet.Cells(i, 3).Value = IIf(fireFound, "Yes", "No")
            radOutputSheet.Cells(i, 4).Value = IIf(hailFound, "Yes", "No")

            If Not sheetExists Then
                radOutputSheet.Cells(i, 5).Value = "Sheet not found in Config file"
            ElseIf fireFound And hailFound Then
                radOutputSheet.Cells(i, 5).Value = "OK - Both columns present"
            ElseIf Not fireFound And Not hailFound Then
                radOutputSheet.Cells(i, 5).Value = "Missing both Fire and Hail columns"
            ElseIf Not fireFound Then
                radOutputSheet.Cells(i, 5).Value = "Missing Fire column"
            ElseIf Not hailFound Then
                radOutputSheet.Cells(i, 5).Value = "Missing Hail column"
            End If

        End If

    Next i

    ' ---- Formatting ----
    radOutputSheet.Range("A1:E1").Font.Bold = True
    radOutputSheet.Columns("A:E").AutoFit

    MsgBox "Check completed successfully!", vbInformation

CleanExit:
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    ' Close config workbook without saving (optional - remove if you want it to stay open)
    ' configWB.Close SaveChanges:=False

    ' Save and keep RAD workbook open with results
    ' radWB.Save

End Sub
