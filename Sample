'===== Part 5: C72 (Column B except first value = 1.00) =====
If Not wsC72 Is Nothing Then
    Dim lastRowC72 As Long
    
    lastRowC72 = wsC72.Cells(wsC72.Rows.Count, "B").End(xlUp).Row
    If lastRowC72 >= 3 Then
        wsC72.Range("B3:B" & lastRowC72).Value = 1#
        wsC72.Range("B3:B" & lastRowC72).NumberFormat = "0.00"
    End If
End If

'===== Part 6: C73 (B2 = 0) =====
If Not wsC73 Is Nothing Then
    wsC73.Range("B2").Value = 0
    wsC73.Range("B2").NumberFormat = "General"
End If
