Option Explicit

Public Sub ImportDiscountSheet(ByVal InputFilePath As String)

    Dim SourceWB As Workbook
    Dim TargetWB As Workbook
    Dim SourceWS As Worksheet
    Dim ExistingWS As Worksheet
    
    Dim OldScreenUpdating As Boolean
    Dim OldDisplayAlerts As Boolean
    Dim OldEnableEvents As Boolean
    
    On Error GoTo ErrorHandler
    
    'Store current Excel settings
    OldScreenUpdating = Application.ScreenUpdating
    OldDisplayAlerts = Application.DisplayAlerts
    OldEnableEvents = Application.EnableEvents
    
    'Turn off Excel updates and messages
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False
    
    'Workbook where this VBA code is running
    Set TargetWB = ThisWorkbook
    
    'Check whether input file exists
    If Dir(InputFilePath) = "" Then GoTo CleanExit
    
    'Open input workbook
    Set SourceWB = Workbooks.Open( _
                    Filename:=InputFilePath, _
                    ReadOnly:=True, _
                    UpdateLinks:=False)
    
    'Check if Discount sheet exists in input workbook
    On Error Resume Next
    Set SourceWS = SourceWB.Worksheets("Discount")
    On Error GoTo ErrorHandler
    
    If SourceWS Is Nothing Then GoTo CleanExit
    
    'Delete existing Discount sheet from target workbook
    On Error Resume Next
    Set ExistingWS = TargetWB.Worksheets("Discount")
    On Error GoTo ErrorHandler
    
    If Not ExistingWS Is Nothing Then
        ExistingWS.Delete
    End If
    
    'Copy Discount sheet to target workbook
    SourceWS.Copy After:=TargetWB.Sheets(TargetWB.Sheets.Count)
    
    'The copied sheet becomes the ActiveSheet
    Set ExistingWS = TargetWB.ActiveSheet
    
    'Make sure the sheet has the correct name
    ExistingWS.Name = "Discount"
    
    'Hide the sheet
    ExistingWS.Visible = xlSheetHidden

CleanExit:

    'Close input workbook without saving
    If Not SourceWB Is Nothing Then
        SourceWB.Close SaveChanges:=False
    End If
    
    'Restore Excel settings
    Application.ScreenUpdating = OldScreenUpdating
    Application.DisplayAlerts = OldDisplayAlerts
    Application.EnableEvents = OldEnableEvents
    
    Exit Sub

ErrorHandler:

    'Close input workbook if it was opened
    If Not SourceWB Is Nothing Then
        SourceWB.Close SaveChanges:=False
    End If
    
    'Restore Excel settings
    Application.ScreenUpdating = OldScreenUpdating
    Application.DisplayAlerts = OldDisplayAlerts
    Application.EnableEvents = OldEnableEvents

End Sub
